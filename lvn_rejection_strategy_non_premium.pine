float lvnCenter9 = array.size(tradableCenters) > 8 ? array.get(tradableCenters, 8) : na
float lvnCenter10 = array.size(tradableCenters) > 9 ? array.get(tradableCenters, 9) : na

float lvnLow1 = array.size(tradableLows) > 0 ? array.get(tradableLows, 0) : na
float lvnLow2 = array.size(tradableLows) > 1 ? array.get(tradableLows, 1) : na
float lvnLow3 = array.size(tradableLows) > 2 ? array.get(tradableLows, 2) : na
float lvnLow4 = array.size(tradableLows) > 3 ? array.get(tradableLows, 3) : na
float lvnLow5 = array.size(tradableLows) > 4 ? array.get(tradableLows, 4) : na
float lvnLow6 = array.size(tradableLows) > 5 ? array.get(tradableLows, 5) : na
float lvnLow7 = array.size(tradableLows) > 6 ? array.get(tradableLows, 6) : na
float lvnLow8 = array.size(tradableLows) > 7 ? array.get(tradableLows, 7) : na
float lvnLow9 = array.size(tradableLows) > 8 ? array.get(tradableLows, 8) : na
float lvnLow10 = array.size(tradableLows) > 9 ? array.get(tradableLows, 9) : na

float lvnHigh1 = array.size(tradableHighs) > 0 ? array.get(tradableHighs, 0) : na
float lvnHigh2 = array.size(tradableHighs) > 1 ? array.get(tradableHighs, 1) : na
float lvnHigh3 = array.size(tradableHighs) > 2 ? array.get(tradableHighs, 2) : na
float lvnHigh4 = array.size(tradableHighs) > 3 ? array.get(tradableHighs, 3) : na
float lvnHigh5 = array.size(tradableHighs) > 4 ? array.get(tradableHighs, 4) : na
float lvnHigh6 = array.size(tradableHighs) > 5 ? array.get(tradableHighs, 5) : na
float lvnHigh7 = array.size(tradableHighs) > 6 ? array.get(tradableHighs, 6) : na
float lvnHigh8 = array.size(tradableHighs) > 7 ? array.get(tradableHighs, 7) : na
float lvnHigh9 = array.size(tradableHighs) > 8 ? array.get(tradableHighs, 8) : na
float lvnHigh10 = array.size(tradableHighs) > 9 ? array.get(tradableHighs, 9) : na

bool showLvnsForDisplay = showLvns or nativeFrvpComparisonMode
bool showPocForDisplay = showPoc or nativeFrvpComparisonMode
bool showProfileBoundsForDisplay = showDebug or nativeFrvpComparisonMode
bool showTradeLevelsForDisplay = showTradeLevels and not nativeFrvpComparisonMode
bool showSessionMarkersForDisplay = showSessionMarkers or nativeFrvpComparisonMode
bool showEntryMarkersForDisplay = not nativeFrvpComparisonMode

lvnUpperPlot1 = plot(showLvnsForDisplay ? lvnHigh1 : na, "LVN Rank #1 Upper", color = color.new(color.teal, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot1 = plot(showLvnsForDisplay ? lvnLow1 : na, "LVN Rank #1 Lower", color = color.new(color.teal, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter1 : na, "LVN Rank #1 Center", color = color.new(color.teal, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot2 = plot(showLvnsForDisplay ? lvnHigh2 : na, "LVN Rank #2 Upper", color = color.new(color.green, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot2 = plot(showLvnsForDisplay ? lvnLow2 : na, "LVN Rank #2 Lower", color = color.new(color.green, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter2 : na, "LVN Rank #2 Center", color = color.new(color.green, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot3 = plot(showLvnsForDisplay ? lvnHigh3 : na, "LVN Rank #3 Upper", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot3 = plot(showLvnsForDisplay ? lvnLow3 : na, "LVN Rank #3 Lower", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter3 : na, "LVN Rank #3 Center", color = color.new(color.blue, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot4 = plot(showLvnsForDisplay ? lvnHigh4 : na, "LVN Rank #4 Upper", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot4 = plot(showLvnsForDisplay ? lvnLow4 : na, "LVN Rank #4 Lower", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter4 : na, "LVN Rank #4 Center", color = color.new(color.orange, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot5 = plot(showLvnsForDisplay ? lvnHigh5 : na, "LVN Rank #5 Upper", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot5 = plot(showLvnsForDisplay ? lvnLow5 : na, "LVN Rank #5 Lower", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter5 : na, "LVN Rank #5 Center", color = color.new(color.red, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot6 = plot(showLvnsForDisplay ? lvnHigh6 : na, "LVN Rank #6 Upper", color = color.new(color.fuchsia, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot6 = plot(showLvnsForDisplay ? lvnLow6 : na, "LVN Rank #6 Lower", color = color.new(color.fuchsia, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter6 : na, "LVN Rank #6 Center", color = color.new(color.fuchsia, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot7 = plot(showLvnsForDisplay ? lvnHigh7 : na, "LVN Rank #7 Upper", color = color.new(color.purple, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot7 = plot(showLvnsForDisplay ? lvnLow7 : na, "LVN Rank #7 Lower", color = color.new(color.purple, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter7 : na, "LVN Rank #7 Center", color = color.new(color.purple, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot8 = plot(showLvnsForDisplay ? lvnHigh8 : na, "LVN Rank #8 Upper", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot8 = plot(showLvnsForDisplay ? lvnLow8 : na, "LVN Rank #8 Lower", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter8 : na, "LVN Rank #8 Center", color = color.new(color.yellow, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot9 = plot(showLvnsForDisplay ? lvnHigh9 : na, "LVN Rank #9 Upper", color = color.new(color.navy, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot9 = plot(showLvnsForDisplay ? lvnLow9 : na, "LVN Rank #9 Lower", color = color.new(color.navy, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter9 : na, "LVN Rank #9 Center", color = color.new(color.navy, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot10 = plot(showLvnsForDisplay ? lvnHigh10 : na, "LVN Rank #10 Upper", color = color.new(color.silver, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot10 = plot(showLvnsForDisplay ? lvnLow10 : na, "LVN Rank #10 Lower", color = color.new(color.silver, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter10 : na, "LVN Rank #10 Center", color = color.new(color.silver, 55), linewidth = 1, style = plot.style_linebr)

fill(lvnUpperPlot1, lvnLowerPlot1, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.teal, 88) : na, title = "LVN Rank #1 Zone")
fill(lvnUpperPlot2, lvnLowerPlot2, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.green, 88) : na, title = "LVN Rank #2 Zone")
fill(lvnUpperPlot3, lvnLowerPlot3, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.blue, 88) : na, title = "LVN Rank #3 Zone")
fill(lvnUpperPlot4, lvnLowerPlot4, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.orange, 88) : na, title = "LVN Rank #4 Zone")
fill(lvnUpperPlot5, lvnLowerPlot5, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.red, 88) : na, title = "LVN Rank #5 Zone")
fill(lvnUpperPlot6, lvnLowerPlot6, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.fuchsia, 88) : na, title = "LVN Rank #6 Zone")
fill(lvnUpperPlot7, lvnLowerPlot7, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.purple, 88) : na, title = "LVN Rank #7 Zone")
fill(lvnUpperPlot8, lvnLowerPlot8, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.yellow, 88) : na, title = "LVN Rank #8 Zone")
fill(lvnUpperPlot9, lvnLowerPlot9, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.navy, 88) : na, title = "LVN Rank #9 Zone")
fill(lvnUpperPlot10, lvnLowerPlot10, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.silver, 88) : na, title = "LVN Rank #10 Zone")
plot(showPocForDisplay ? previousPocPrice : na, "Prior Session POC", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)

plot(showProfileBoundsForDisplay ? frozenSessionHigh : na, "Frozen Session High", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(showProfileBoundsForDisplay ? frozenSessionLow : na, "Frozen Session Low", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(showTradeLevelsForDisplay ? activeStopPrice : na, "Active Stop", color = color.new(color.red, 0), linewidth = 1, style = plot.style_linebr)
plot(showTradeLevelsForDisplay ? activeTargetPrice : na, "Active Target", color = color.new(color.lime, 0), linewidth = 1, style = plot.style_linebr)

bgcolor(showSessionMarkersForDisplay and inProfileSession ? color.new(color.aqua, 94) : na, title = "Session Background")
plotshape(showSessionMarkersForDisplay and isNewProfileSession, title = "Session Start", style = shape.circle, size = size.tiny, color = color.new(color.aqua, 0), location = location.bottom, text = "18")
plotshape(showSessionMarkersForDisplay and isSessionJustEnded, title = "Session End", style = shape.circle, size = size.tiny, color = color.new(color.orange, 0), location = location.top, text = "16")
plotshape(showEntryMarkersForDisplay and newLongPosition, title = "Long Entry Marker", style = shape.triangleup, location = location.belowbar, size = size.tiny, color = color.new(color.lime, 0), text = "L")
plotshape(showEntryMarkersForDisplay and newShortPosition, title = "Short Entry Marker", style = shape.triangledown, location = location.abovebar, size = size.tiny, color = color.new(color.red, 0), text = "S")

if barstate.islast
    f_clear_label_array(lvnLabels)
    f_update_row_diagnostics_table()

    if not na(comparisonSourceSessionBox)
        box.delete(comparisonSourceSessionBox)
        comparisonSourceSessionBox := na
    if not na(frvpStartLine)
        line.delete(frvpStartLine)
        frvpStartLine := na
    if not na(frvpEndLine)
        line.delete(frvpEndLine)
        frvpEndLine := na
    if not na(frvpStartLabel)
        label.delete(frvpStartLabel)
        frvpStartLabel := na
    if not na(frvpEndLabel)
        label.delete(frvpEndLabel)
        frvpEndLabel := na
    if not na(profileHighLabel)
        label.delete(profileHighLabel)
        profileHighLabel := na
    if not na(profileLowLabel)
        label.delete(profileLowLabel)
        profileLowLabel := na
    if not na(profilePocLabel)
        label.delete(profilePocLabel)
        profilePocLabel := na
    if not na(profileSourceLabel)
        label.delete(profileSourceLabel)
        profileSourceLabel := na

    if showLvnLabels and showLvnsForDisplay and array.size(tradableCenters) > 0
        int labelsToDraw = math.min(array.size(tradableCenters), MAX_SUPPORTED_RANKS)
        for i = 0 to labelsToDraw - 1
            int rank = i + 1
            float level = array.get(tradableCenters, i)
            float lowerBoundary = array.get(tradableLows, i)
            float upperBoundary = array.get(tradableHighs, i)
            float avgAbove = array.get(tradableAverageAboveVolumes, i)
            float avgBelow = array.get(tradableAverageBelowVolumes, i)
            float depthRatio = array.get(tradableDepthRatios, i)
            float contrastRatio = array.get(tradableContrastRatios, i)
            float surroundingAvg = array.get(tradableSurroundingAvgs, i)
            float avgVolume = array.get(tradableRegionAvgVolumes, i)
            string strengthClass = f_lvn_strength_class(depthRatio)
            string labelText = "LVN Rank #" + str.tostring(rank) + "  " + str.tostring(level, format.mintick)
            labelText += "\nZone: " + str.tostring(lowerBoundary, format.mintick) + " - " + str.tostring(upperBoundary, format.mintick)
            labelText += "\nDepth: " + str.tostring(depthRatio * 100.0, "#.##") + "%"
            labelText += "\nContrast: " + str.tostring(contrastRatio, "#.##") + "x"
            labelText += "\nClass: " + strengthClass
            labelText += "\nLVN Avg: " + str.tostring(avgVolume, "#.##")
            labelText += "\nSurround Avg: " + str.tostring(surroundingAvg, "#.##")
            labelText += "\nAbove/Below: " + str.tostring(avgAbove, "#.##") + " / " + str.tostring(avgBelow, "#.##")
            label labelId = label.new(bar_index, level, text = labelText, style = label.style_label_left, color = color.new(color.black, 20), textcolor = color.white, size = size.tiny)
            array.push(lvnLabels, labelId)

    if not na(statusLabel)
        label.delete(statusLabel)
        statusLabel := na

    if not na(debugLabel)
        label.delete(debugLabel)
        debugLabel := na

    string warningText = ""
    bool m1ValidationTimeframe = timeframe.period == "1"
    if not timeframeOk
        warningText := "Use this strategy on intraday charts. Higher timeframes cannot rebuild a session profile reliably."
    else if profileCalculationMode != "Chart Bar Approximation"
        warningText := "Unsupported profile calculation setting."
    else if str.length(dataWarning) > 0
        warningText := dataWarning
    else if nativeFrvpComparisonMode and not m1ValidationTimeframe
        warningText := "FRVP COMPARISON INVALID: Client baseline uses M1. Current chart timeframe = " + timeframe.period
    else if array.size(profileVolumes) > 0 and not frozenProfileBoundaryPass
        warningText := "Profile boundary validation failed on the last frozen session."
    else if array.size(profileVolumes) > 0 and not frozenRowCoveragePass
        warningText := "Row coverage validation failed on the last frozen session."
    else if array.size(profileVolumes) > 0 and not frozenSourceHighMatchPass
        warningText := "Frozen session high does not match source-session highs."
    else if array.size(profileVolumes) > 0 and not frozenSourceLowMatchPass
        warningText := "Frozen session low does not match source-session lows."
    else if array.size(profileVolumes) > 0 and not frozenHistogramVerticalRangePass
        warningText := "Histogram vertical range does not match frozen profile bounds."
    else if not na(frozenVolumeConservationErrorPct) and frozenVolumeConservationErrorPct > 0.05
        warningText := "Profile volume conservation drift exceeded 0.05% on the last frozen session."
    else if frozenSourceSessionAppearsIncomplete
        warningText := "Warning: source session appears incomplete (<90% of expected M1 bars)."

    string comparisonText = ""
    if nativeFrvpComparisonMode and not na(frozenSessionStartTime) and not na(frozenLastIncludedBarTime)
        comparisonText := "Native FRVP anchors:\nStart: " + f_format_timestamp(frozenSessionStartTime) + " | Bar " + str.tostring(frozenFirstIncludedBarIndex) + "\nEnd: " + f_format_timestamp(frozenLastIncludedBarTime) + " | Bar " + str.tostring(frozenLastIncludedBarIndex) + "\nRows: " + str.tostring(profileRows) + " | Chart: 1 minute\nNative FRVP must cover the highlighted source-session box exactly."

    string statusText = warningText
    if str.length(comparisonText) > 0
        statusText := str.length(statusText) > 0 ? statusText + "\n\n" + comparisonText : comparisonText

    if str.length(statusText) > 0
        statusLabel := label.new(bar_index, high, statusText, style = label.style_label_upper_left, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

    if showDebug
        float profileVolumeDelta = not na(frozenProfileVolumeSum) and not na(frozenSourceSessionVolume) ? frozenProfileVolumeSum - frozenSourceSessionVolume : na
        string conservationStatus = "na"
        if not na(frozenVolumeConservationErrorPct)
            conservationStatus := frozenVolumeConservationErrorPct <= 0.05 ? "PASS" : "CHECK"
        string rowCoverageStatus = array.size(profileVolumes) > 0 ? frozenRowCoveragePass ? "PASS" : "FAIL" : "na"
        string profileBoundaryStatus = array.size(profileVolumes) > 0 ? frozenProfileBoundaryPass ? "PASS" : "FAIL" : "na"
        string sourceHighMatchStatus = array.size(profileVolumes) > 0 ? frozenSourceHighMatchPass ? "PASS" : "FAIL" : "na"
        string sourceLowMatchStatus = array.size(profileVolumes) > 0 ? frozenSourceLowMatchPass ? "PASS" : "FAIL" : "na"
        string histogramVerticalRangeStatus = array.size(profileVolumes) > 0 ? frozenHistogramVerticalRangePass ? "PASS" : "FAIL" : "na"
        string m1AlignmentStatus = m1ValidationTimeframe ? "PASS" : "FAIL"
        string debugText = "Test: " + testLabel
        debugText += "\nConfig: " + f_configuration_fingerprint()
        debugText += "\nSymbol: " + syminfo.tickerid
        debugText += "\nTimeframe: " + timeframe.period
        if not m1ValidationTimeframe
            debugText += "\nValidation Warning: Client baseline uses M1."
        debugText += "\nSession: " + profileSession + " " + sessionTimezone
        debugText += "\nComparison Mode: " + (nativeFrvpComparisonMode ? "On" : "Off")
        debugText += "\nRows: " + str.tostring(profileRows)
        debugText += "\nEnabled Ranks: " + f_enabled_ranks_summary()
        debugText += "\nLongs / Shorts: " + (tradeLongs ? "On" : "Off") + " / " + (tradeShorts ? "On" : "Off")
        debugText += "\nHistogram: " + ((showVolumeProfileHistogram or nativeFrvpComparisonMode) ? "On " + str.tostring(profileVisualWidth) + " bars" : "Off")
        debugText += "\nHistogram Orientation: " + histogramOrientation
        debugText += "\nHistogram Placement: " + histogramPlacement
        debugText += "\nLVN Method: " + lvnMethod
        debugText += "\nThreshold: " + str.tostring(lvnThresholdPct, "#.##") + "%"
        debugText += "\nSurrounding Rows: " + str.tostring(surroundingRows)
        debugText += "\nBoundary Mode: " + clientThresholdBoundaryMode
        debugText += "\nHVN Boundary Search Rows: " + str.tostring(hvnBoundarySearchRows)
        debugText += "\nContrast Filter: " + (useContrastFilter ? "On >= " + str.tostring(minContrastRatio, "#.##") + "x" : "Off")
        debugText += "\nFreshness: " + lvnFreshnessMode
        debugText += "\nApproach Distance: " + str.tostring(minimumApproachDistance, "#.##")
        debugText += "\nEntry Cutoff: " + (blockNewEntriesBeforeSessionEnd ? "On " + str.tostring(entryCutoffMinutes) + "m" : "Off")
        debugText += "\nClose At Session End: " + (closePositionsAtSessionEnd ? "On" : "Off")
        debugText += "\nEntry Session Filter: " + (useEntrySessionFilter ? entrySessionFilter : "Off")
        debugText += "\nPOC Filter: " + ((usePocDistanceFilter or not tradeLvnsAbovePoc or not tradeLvnsBelowPoc) ? "Custom" : "Off")
        debugText += "\nPOC Distance Min: " + str.tostring(minimumPocDistance, "#.##")
        debugText += "\nPOC Above / Below: " + (tradeLvnsAbovePoc ? "On" : "Off") + " / " + (tradeLvnsBelowPoc ? "On" : "Off")
        debugText += "\nRisk Mode: " + riskMode
        debugText += riskMode == "Fixed Points" ? "\nFixed SL / TP: " + str.tostring(fixedSLPoints, "#.##") + " / " + str.tostring(fixedTPPoints, "#.##") : "\nR / Buffer: " + str.tostring(rrMultiple, "#.##") + " / " + str.tostring(lvnBoundaryBuffer, "#.##")
        debugText += "\nOrder Size: " + str.tostring(orderQty, "#.##")
        debugText += "\nSource Session Date: " + f_format_date(frozenSessionStartTime)
        debugText += "\nSource Session Start Timestamp: " + f_format_timestamp(frozenSessionStartTime)
        debugText += "\nSource Session End Timestamp: " + f_format_timestamp(frozenSessionEndTime)
        debugText += "\nFirst Included Bar Time: " + f_format_timestamp(frozenFirstIncludedBarTime)
        debugText += "\nLast Included Bar Time: " + f_format_timestamp(frozenLastIncludedBarTime)
        debugText += "\nFirst Included Bar Index: " + (not na(frozenFirstIncludedBarIndex) ? str.tostring(frozenFirstIncludedBarIndex) : "na")
        debugText += "\nLast Included Bar Index: " + (not na(frozenLastIncludedBarIndex) ? str.tostring(frozenLastIncludedBarIndex) : "na")
        debugText += "\nSource Bars Included: " + str.tostring(frozenSourceBarCount)
        debugText += "\nSource Session Complete: " + (frozenSourceSessionAppearsIncomplete ? "CHECK" : "PASS")
        debugText += "\nFrozen High: " + (not na(frozenSessionHigh) ? str.tostring(frozenSessionHigh, format.mintick) : "na")
        debugText += "\nFrozen Low: " + (not na(frozenSessionLow) ? str.tostring(frozenSessionLow, format.mintick) : "na")
        debugText += "\nProfile Range: " + (not na(frozenProfileRange) ? str.tostring(frozenProfileRange, "#.####") : "na")
        debugText += "\nRow Height: " + (not na(frozenRowHeight) ? str.tostring(frozenRowHeight, format.mintick) : "na")
        debugText += "\nExpected Top Row High: " + (not na(frozenExpectedTopRowHigh) ? str.tostring(frozenExpectedTopRowHigh, format.mintick) : "na")
        debugText += "\nExpected Bottom Row Low: " + (not na(frozenExpectedBottomRowLow) ? str.tostring(frozenExpectedBottomRowLow, format.mintick) : "na")
        debugText += "\nProfile Boundary Status: " + profileBoundaryStatus
        debugText += "\nRow Coverage Status: " + rowCoverageStatus
        debugText += "\nSource High Match: " + sourceHighMatchStatus
        debugText += "\nSource Low Match: " + sourceLowMatchStatus
        debugText += "\nHistogram Vertical Range Match: " + histogramVerticalRangeStatus
        debugText += "\nMax Row Volume: " + (not na(frozenMaxRowVolume) ? str.tostring(frozenMaxRowVolume, "#.##") : "na")
        debugText += "\nPOC Row: " + (not na(previousPocRow) ? str.tostring(previousPocRow + 1) : "na")
        debugText += "\nPOC Price: " + (not na(previousPocPrice) ? str.tostring(previousPocPrice, format.mintick) : "na")
        debugText += "\nCalculated Rows: " + str.tostring(array.size(profileVolumes))
        debugText += "\nRendered Rows: " + str.tostring(frozenRenderedRowCount)
        debugText += "\nRendered Nonzero Rows: " + str.tostring(frozenRenderedNonzeroRowCount)
        debugText += "\nHistogram Anchor Bar Index: " + (not na(frozenProfileAnchorBarIndex) ? str.tostring(frozenProfileAnchorBarIndex) : "na")
        debugText += "\nHistogram Left Edge: " + (not na(frozenHistogramLeftEdge) ? str.tostring(frozenHistogramLeftEdge) : "na")
        debugText += "\nHistogram Right Edge: " + (not na(frozenHistogramRightEdge) ? str.tostring(frozenHistogramRightEdge) : "na")
        debugText += "\nProfile Visual Width: " + str.tostring(profileVisualWidth)
        debugText += "\nProfile Vol Sum: " + (not na(frozenProfileVolumeSum) ? str.tostring(frozenProfileVolumeSum, "#.##") : "na")
        debugText += "\nSource Session Vol: " + (not na(frozenSourceSessionVolume) ? str.tostring(frozenSourceSessionVolume, "#.##") : "na")
        debugText += "\nVolume Delta: " + (not na(profileVolumeDelta) ? str.tostring(profileVolumeDelta, "#.##") : "na")
        debugText += "\nConservation Error: " + (not na(frozenVolumeConservationErrorPct) ? str.tostring(frozenVolumeConservationErrorPct, "#.####") + "%" : "na")
        debugText += "\nConservation Status: " + conservationStatus
        debugText += "\nFRVP Alignment M1: " + m1AlignmentStatus
        debugText += "\nMinutes To Session End: " + (not na(minutesToSessionEnd) ? str.tostring(minutesToSessionEnd) : "na")
        debugText += "\nDetected LVNs: " + str.tostring(array.size(tradableCenters))
        if lvnMethod == "Client Threshold Valley"
            string boundaryStatus = not na(frozenBestMergedRegionDepthRatio) ? (frozenBestMergedRegionBoundaryPass ? "PASS" : "FAIL") : "na"
            string contrastStatus = not na(frozenBestMergedRegionDepthRatio) ? (frozenBestMergedRegionContrastPass ? "PASS" : "FAIL") : "na"
            debugText += "\nLocal Threshold Candidates: " + str.tostring(frozenLocalThresholdCandidates)
            debugText += "\nMerged Low-Volume Regions: " + str.tostring(frozenMergedLowVolumeRegions)
            debugText += "\nPre-Detector Snapshot Size: " + str.tostring(frozenPreDetectorProfileVolumeSize)
            debugText += "\nPre-Detector Snapshot Sum: " + (not na(frozenPreDetectorProfileVolumeSum) ? str.tostring(frozenPreDetectorProfileVolumeSum, "#.##") : "na")
            debugText += "\nPre-Detector Snapshot Min / Max: " + (not na(frozenPreDetectorProfileVolumeMin) ? str.tostring(frozenPreDetectorProfileVolumeMin, "#.##") : "na") + " / " + (not na(frozenPreDetectorProfileVolumeMax) ? str.tostring(frozenPreDetectorProfileVolumeMax, "#.##") : "na")
            debugText += "\nPrepare Function Entry Volumes Size: " + str.tostring(frozenPrepareEntryVolumesSize)
            debugText += "\nPrepare Function Entry Row Sizes: " + str.tostring(frozenPrepareEntryRowLowsSize) + " / " + str.tostring(frozenPrepareEntryRowHighsSize)
            debugText += "\nPrepare Function Entry Sum / Min / Max: " + (not na(frozenPrepareEntryVolumesSum) ? str.tostring(frozenPrepareEntryVolumesSum, "#.##") : "na") + " / " + (not na(frozenPrepareEntryVolumesMin) ? str.tostring(frozenPrepareEntryVolumesMin, "#.##") : "na") + " / " + (not na(frozenPrepareEntryVolumesMax) ? str.tostring(frozenPrepareEntryVolumesMax, "#.##") : "na")
            debugText += "\nPrepare Function After Clear Volumes Size: " + str.tostring(frozenPrepareAfterClearVolumesSize)
            debugText += "\nPrepare Function After Clear Row Sizes: " + str.tostring(frozenPrepareAfterClearRowLowsSize) + " / " + str.tostring(frozenPrepareAfterClearRowHighsSize)
            debugText += "\nPrepare Function After Clear Sum / Min / Max: " + (not na(frozenPrepareAfterClearVolumesSum) ? str.tostring(frozenPrepareAfterClearVolumesSum, "#.##") : "na") + " / " + (not na(frozenPrepareAfterClearVolumesMin) ? str.tostring(frozenPrepareAfterClearVolumesMin, "#.##") : "na") + " / " + (not na(frozenPrepareAfterClearVolumesMax) ? str.tostring(frozenPrepareAfterClearVolumesMax, "#.##") : "na")
            debugText += "\nDetector Entry SourceVolumes Size: " + str.tostring(frozenDetectorEntrySourceVolumesSize)
            debugText += "\nDetector Entry RowLows / RowHighs Size: " + str.tostring(frozenDetectorEntrySourceRowLowsSize) + " / " + str.tostring(frozenDetectorEntrySourceRowHighsSize)
            debugText += "\nDetector Entry Numeric / Positive Volumes: " + str.tostring(frozenDetectorEntryNumericSourceVolumes) + " / " + str.tostring(frozenDetectorEntryPositiveSourceVolumes)
            debugText += "\nDetector Entry Min / Max / Sum: " + (not na(frozenDetectorEntryMinSourceVolume) ? str.tostring(frozenDetectorEntryMinSourceVolume, "#.##") : "na") + " / " + (not na(frozenDetectorEntryMaxSourceVolume) ? str.tostring(frozenDetectorEntryMaxSourceVolume, "#.##") : "na") + " / " + (not na(frozenDetectorEntrySumSourceVolume) ? str.tostring(frozenDetectorEntrySumSourceVolume, "#.##") : "na")
            debugText += "\nDetector Snapshot Match: " + (frozenDetectorSnapshotMatch ? "PASS" : "FAIL")
            debugText += "\nEvaluable Interior Rows: " + str.tostring(frozenEvaluableInteriorRows)
            debugText += "\nRows With Valid Surrounding Average: " + str.tostring(frozenRowsWithValidSurroundingAverage)
            debugText += "\nBest Raw Row Depth Ratio: " + (not na(frozenBestRawRowDepthRatio) ? str.tostring(frozenBestRawRowDepthRatio, "#.####") : "na")
            debugText += "\nMinimum Raw Depth Ratio Across All Valid Interior Rows: " + (not na(frozenMinimumRawDepthRatioAcrossAllValidInteriorRows) ? str.tostring(frozenMinimumRawDepthRatioAcrossAllValidInteriorRows, "#.####") : "na")
            debugText += "\nBest Merged Region Depth Ratio: " + (not na(frozenBestMergedRegionDepthRatio) ? str.tostring(frozenBestMergedRegionDepthRatio, "#.####") : "na")
            debugText += "\nBest Merged Region Surrounding Avg: " + (not na(frozenBestMergedRegionSurroundingAvg) ? str.tostring(frozenBestMergedRegionSurroundingAvg, "#.##") : "na")
            debugText += "\nLower HVN Found: " + (frozenBestLowerHvnFound ? "Yes" : "No")
            debugText += "\nUpper HVN Found: " + (frozenBestUpperHvnFound ? "Yes" : "No")
            debugText += "\nDistance To Lower HVN: " + (not na(frozenDistanceToLowerHvn) ? str.tostring(frozenDistanceToLowerHvn) : "na")
            debugText += "\nDistance To Upper HVN: " + (not na(frozenDistanceToUpperHvn) ? str.tostring(frozenDistanceToUpperHvn) : "na")
            debugText += "\nRegion Boundary: " + boundaryStatus
            debugText += "\nContrast: " + contrastStatus
            debugText += "\nFinal Qualifying LVNs: " + str.tostring(frozenFinalQualifyingLvns)
            if str.length(frozenDetectorProbeFixedText) > 0
                debugText += "\n" + frozenDetectorProbeFixedText
            if str.length(frozenDetectorProbePocText) > 0
                debugText += "\n" + frozenDetectorProbePocText
            if str.length(frozenBestMergedRegionReason) > 0
                debugText += "\nClient Threshold Diagnostic: " + frozenBestMergedRegionReason
        if array.size(tradableCenters) > 0
            debugText += "\nTop Depth: " + str.tostring(array.get(tradableDepthRatios, 0) * 100.0, "#.##") + "%"
            debugText += "\nTop Contrast: " + str.tostring(array.get(tradableContrastRatios, 0), "#.##") + "x"
            debugText += "\nTop Class: " + f_lvn_strength_class(array.get(tradableDepthRatios, 0))
            debugText += "\nTop Zone: " + str.tostring(array.get(tradableLows, 0), format.mintick) + " - " + str.tostring(array.get(tradableHighs, 0), format.mintick)
        if strategy.position_size != 0
            float activeRiskPoints = not na(activeStopPrice) ? math.abs(strategy.position_avg_price - activeStopPrice) : na
            float activeRewardPoints = not na(activeTargetPrice) ? math.abs(activeTargetPrice - strategy.position_avg_price) : na
            float actualRMultiple = not na(activeRiskPoints) and activeRiskPoints > syminfo.mintick and not na(activeRewardPoints) ? activeRewardPoints / activeRiskPoints : na
            debugText += "\nActive Entry: " + str.tostring(strategy.position_avg_price, format.mintick)
            debugText += "\nActive Stop: " + (not na(activeStopPrice) ? str.tostring(activeStopPrice, format.mintick) : "na")
            debugText += "\nActive Target: " + (not na(activeTargetPrice) ? str.tostring(activeTargetPrice, format.mintick) : "na")
            debugText += "\nRisk / Reward Pts: " + (not na(activeRiskPoints) ? str.tostring(activeRiskPoints, "#.##") : "na") + " / " + (not na(activeRewardPoints) ? str.tostring(activeRewardPoints, "#.##") : "na")
            debugText += "\nActual R: " + (not na(actualRMultiple) ? str.tostring(actualRMultiple, "#.##") : "na")
            if activeTradeLvnIndex >= 0 and activeTradeLvnIndex < array.size(tradableCenters)
                debugText += "\nActive LVN Zone: " + str.tostring(array.get(tradableLows, activeTradeLvnIndex), format.mintick) + " - " + str.tostring(array.get(tradableHighs, activeTradeLvnIndex), format.mintick)
                if riskMode == "Fixed Points"
                    bool fixedRiskMatch = not na(activeRiskPoints) and not na(activeRewardPoints) and math.abs(activeRiskPoints - fixedSLPoints) <= syminfo.mintick and math.abs(activeRewardPoints - fixedTPPoints) <= syminfo.mintick
                    debugText += "\nFixed Risk Match: " + (fixedRiskMatch ? "Yes" : "No")
        debugLabel := label.new(bar_index, low, text = debugText, style = label.style_label_lower_left, color = color.new(color.navy, 15), textcolor = color.white, size = size.small)

    if nativeFrvpComparisonMode and not na(frozenFirstIncludedBarIndex) and not na(frozenLastIncludedBarIndex) and not na(frozenSessionHigh) and not na(frozenSessionLow)
        comparisonSourceSessionBox := box.new(frozenFirstIncludedBarIndex, frozenSessionHigh, frozenLastIncludedBarIndex, frozenSessionLow, xloc = xloc.bar_index, bgcolor = color.new(color.aqua, 92), border_color = color.new(color.aqua, 45), border_width = 1)
        frvpStartLine := line.new(frozenFirstIncludedBarIndex, frozenSessionLow, frozenFirstIncludedBarIndex, frozenSessionHigh, xloc = xloc.bar_index, color = color.new(color.aqua, 0), width = 2, style = line.style_dashed)
        frvpEndLine := line.new(frozenLastIncludedBarIndex, frozenSessionLow, frozenLastIncludedBarIndex, frozenSessionHigh, xloc = xloc.bar_index, color = color.new(color.orange, 0), width = 2, style = line.style_dashed)
        frvpStartLabel := label.new(frozenFirstIncludedBarIndex, frozenSessionHigh, "FRVP START\n" + f_format_timestamp(frozenFirstIncludedBarTime), xloc = xloc.bar_index, style = label.style_label_down, color = color.new(color.aqua, 0), textcolor = color.black, size = size.small)
        frvpEndLabel := label.new(frozenLastIncludedBarIndex, frozenSessionHigh, "FRVP END\n" + f_format_timestamp(frozenLastIncludedBarTime), xloc = xloc.bar_index, style = label.style_label_down, color = color.new(color.orange, 0), textcolor = color.black, size = size.small)
        int profileLabelAnchorBarIndex = not na(frozenHistogramRightEdge) ? frozenHistogramRightEdge + 1 : bar_index
        profileHighLabel := label.new(profileLabelAnchorBarIndex, frozenSessionHigh, "PROFILE HIGH: " + str.tostring(frozenSessionHigh, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 10), textcolor = color.white, size = size.small)
        profileLowLabel := label.new(profileLabelAnchorBarIndex, frozenSessionLow, "PROFILE LOW: " + str.tostring(frozenSessionLow, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 10), textcolor = color.white, size = size.small)
        if not na(previousPocPrice)
            profilePocLabel := label.new(profileLabelAnchorBarIndex, previousPocPrice, "POC: " + str.tostring(previousPocPrice, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.yellow, 0), textcolor = color.black, size = size.small)
        float linkLabelPrice = frozenSessionHigh + frozenProfileRange * 0.03
        int linkLabelBarIndex = int(math.round((frozenFirstIncludedBarIndex + frozenLastIncludedBarIndex) * 0.5))
        profileSourceLabel := label.new(linkLabelBarIndex, linkLabelPrice, "Profile from highlighted prior session", xloc = xloc.bar_index, style = label.style_label_up, color = color.new(color.navy, 10), textcolor = color.white, size = size.small)
