f_long_entry_id(int rank) =>
    "LVN-L-" + str.tostring(rank)

f_short_entry_id(int rank) =>
    "LVN-S-" + str.tostring(rank)

f_exit_id(string entryId) =>
    entryId + "-X"

f_is_rank_enabled(int rank) =>
    switch rank
        1 => tradeLVN1
        2 => tradeLVN2
        3 => tradeLVN3
        4 => tradeLVN4
        5 => tradeLVN5
        6 => tradeLVN6
        7 => tradeLVN7
        8 => tradeLVN8
        9 => tradeLVN9
        10 => tradeLVN10
        => false

f_clear_label_array(array<label> labels) =>
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
    array.clear(labels)

f_clear_box_array(array<box> boxes) =>
    if array.size(boxes) > 0
        for i = 0 to array.size(boxes) - 1
            box.delete(array.get(boxes, i))
    array.clear(boxes)

f_reset_usage_flags(array<bool> flags, int size) =>
    array.clear(flags)
    if size > 0
        for i = 0 to size - 1
            array.push(flags, false)

f_reset_bool_flags(array<bool> flags, int size) =>
    array.clear(flags)
    if size > 0
        for i = 0 to size - 1
            array.push(flags, false)

f_clear_tradable_lvns() =>
    array.clear(tradableCenters)
    array.clear(tradableLows)
    array.clear(tradableHighs)
    array.clear(tradableRegionAvgVolumes)
    array.clear(tradableRegionTotalVolumes)
    array.clear(tradableSurroundingAvgs)
    array.clear(tradableAverageAboveVolumes)
    array.clear(tradableAverageBelowVolumes)
    array.clear(tradableDepthRatios)
    array.clear(tradableContrastRatios)
    array.clear(tradableStartRows)
    array.clear(tradableEndRows)
    array.clear(tradableRegionWidths)

f_clear_build_profile_buffers() =>
    array.clear(sessionBarHighs)
    array.clear(sessionBarLows)
    array.clear(sessionBarVolumes)

f_clear_frozen_profile_buffers() =>
    f_clear_tradable_lvns()
    array.clear(profileVolumes)
    array.clear(profileRowLows)
    array.clear(profileRowHighs)
    f_clear_box_array(profileBoxes)

f_cancel_rank_orders(int rank) =>
    strategy.cancel(f_long_entry_id(rank))
    strategy.cancel(f_short_entry_id(rank))

f_cancel_all_entry_orders() =>
    for rank = 1 to MAX_SUPPORTED_RANKS
        f_cancel_rank_orders(rank)

f_lvn_entry_price(int direction, float lvnLow, float lvnHigh) =>
    direction == 1 ? lvnHigh : lvnLow

f_lvn_strength_class(float depthRatio) =>
    string strength = "Custom"
    if not na(depthRatio)
        if depthRatio <= 0.30
            strength := "Very Strict"
        else if depthRatio <= 0.40
            strength := "Strong"
        else if depthRatio <= 0.50
            strength := "Moderate"
        else
            strength := "Shallow"
    strength

f_enabled_ranks_summary() =>
    string enabledRanks = ""
    for rank = 1 to MAX_SUPPORTED_RANKS
        if f_is_rank_enabled(rank)
            enabledRanks += str.length(enabledRanks) > 0 ? "," + str.tostring(rank) : str.tostring(rank)
    str.length(enabledRanks) > 0 ? enabledRanks : "None"

f_format_timestamp(int ts) =>
    string formatted = "na"
    if not na(ts)
        string yearText = str.tostring(year(ts, sessionTimezone))
        string monthText = str.tostring(month(ts, sessionTimezone), "00")
        string dayText = str.tostring(dayofmonth(ts, sessionTimezone), "00")
        string hourText = str.tostring(hour(ts, sessionTimezone), "00")
        string minuteText = str.tostring(minute(ts, sessionTimezone), "00")
        formatted := yearText + "-" + monthText + "-" + dayText + " " + hourText + ":" + minuteText
    formatted

f_format_date(int ts) =>
    string formatted = "na"
    if not na(ts)
        string yearText = str.tostring(year(ts, sessionTimezone))
        string monthText = str.tostring(month(ts, sessionTimezone), "00")
        string dayText = str.tostring(dayofmonth(ts, sessionTimezone), "00")
        formatted := yearText + "-" + monthText + "-" + dayText
    formatted

f_price_tolerance() =>
    math.max(syminfo.mintick * 0.5, 0.0000001)

f_values_close(float valueA, float valueB) =>
    not na(valueA) and not na(valueB) and math.abs(valueA - valueB) <= f_price_tolerance()

f_is_detector_input_error(string message) =>
    str.length(message) >= 20 and str.substring(message, 0, 20) == "DETECTOR INPUT ERROR"

f_row_coverage_pass(array<float> rowLows, array<float> rowHighs, float expectedLow, float expectedHigh) =>
    bool pass = array.size(rowLows) > 0 and array.size(rowLows) == array.size(rowHighs) and not na(expectedLow) and not na(expectedHigh)
    if pass
        int rowCount = array.size(rowLows)
        pass := f_values_close(array.get(rowLows, 0), expectedLow) and f_values_close(array.get(rowHighs, rowCount - 1), expectedHigh)
        for row = 0 to rowCount - 1
            float rowLow = array.get(rowLows, row)
            float rowHigh = array.get(rowHighs, row)
            pass := pass and rowHigh > rowLow
            if row > 0
                float priorHigh = array.get(rowHighs, row - 1)
                pass := pass and math.abs(rowLow - priorHigh) <= f_price_tolerance()
    pass

f_configuration_fingerprint() =>
    string rankSummary = f_enabled_ranks_summary()
    string directionSummary = tradeLongs and tradeShorts ? "BOTH" : tradeLongs ? "LONG" : tradeShorts ? "SHORT" : "OFF"
    string riskSummary = riskMode == "Fixed Points" ? "FIX" + str.tostring(fixedSLPoints, "#.##") + "x" + str.tostring(fixedTPPoints, "#.##") : "BR" + str.tostring(rrMultiple, "#.##")
    string histogramSummary = showVolumeProfileHistogram or nativeFrvpComparisonMode ? "HIST" : "NOHIST"
    string boundarySummary = clientThresholdBoundaryMode == "Immediate Surrounding Average" ? "BAVG" : "BHVN" + str.tostring(hvnBoundarySearchRows)
    timeframe.period + " | R" + str.tostring(profileRows) + " | T" + str.tostring(lvnThresholdPct, "#") + " | S" + str.tostring(surroundingRows) + " | " + boundarySummary + " | LVN" + rankSummary + " | " + directionSummary + " | " + lvnFreshnessMode + " | " + riskSummary + " | " + histogramSummary

f_row_is_lvn(int rowIndex) =>
    bool isLvnRow = false
    if array.size(tradableStartRows) > 0
        for i = 0 to array.size(tradableStartRows) - 1
            int startRow = array.get(tradableStartRows, i)
            int endRow = array.get(tradableEndRows, i)
            isLvnRow := isLvnRow or (rowIndex >= startRow and rowIndex <= endRow)
    isLvnRow

f_row_lvn_index(int rowIndex) =>
    int lvnIndex = -1
    if array.size(tradableStartRows) > 0
        for i = 0 to array.size(tradableStartRows) - 1
            int startRow = array.get(tradableStartRows, i)
            int endRow = array.get(tradableEndRows, i)
            if rowIndex >= startRow and rowIndex <= endRow
                lvnIndex := i
                break
    lvnIndex

f_draw_frozen_profile_histogram(int anchorBarIndex, int sourceFirstBarIndex, int sourceLastBarIndex) =>
    f_clear_box_array(profileBoxes)
    int renderedRowCount = 0
    int renderedNonzeroRowCount = 0
    int histogramLeftEdge = na
    int histogramRightEdge = na

    if (showVolumeProfileHistogram or nativeFrvpComparisonMode) and array.size(profileVolumes) > 0 and array.size(profileRowLows) == array.size(profileVolumes) and array.size(profileRowHighs) == array.size(profileVolumes) and not na(anchorBarIndex)
        float maxRowVolume = 0.0
        int pocRowIndex = -1

        for row = 0 to array.size(profileVolumes) - 1
            float rowVolume = array.get(profileVolumes, row)
            if rowVolume > maxRowVolume
                maxRowVolume := rowVolume
                pocRowIndex := row

        if maxRowVolume > 0 and pocRowIndex >= 0
            bool placeOverSourceSession = histogramPlacement == "Over Source Session" and not na(sourceFirstBarIndex) and not na(sourceLastBarIndex)
            if placeOverSourceSession
                if histogramOrientation == "TradingView Style"
                    histogramLeftEdge := sourceFirstBarIndex
                    histogramRightEdge := histogramLeftEdge + profileVisualWidth
                else
                    histogramRightEdge := sourceLastBarIndex
                    histogramLeftEdge := histogramRightEdge - profileVisualWidth
            else
                histogramRightEdge := anchorBarIndex - 1
                histogramLeftEdge := histogramRightEdge - profileVisualWidth

            for row = 0 to array.size(profileVolumes) - 1
                float rowVolume = array.get(profileVolumes, row)
                float normalizedWidth = rowVolume / maxRowVolume
                int widthBars = rowVolume > 0 ? math.max(1, int(math.round(normalizedWidth * profileVisualWidth))) : 1
                int rowLeftEdge = histogramOrientation == "TradingView Style" ? histogramLeftEdge : histogramRightEdge - widthBars
                int rowRightEdge = histogramOrientation == "TradingView Style" ? math.min(histogramRightEdge, histogramLeftEdge + widthBars) : histogramRightEdge
                float rowLow = array.get(profileRowLows, row)
                float rowHigh = array.get(profileRowHighs, row)
                bool isPocRow = row == pocRowIndex
                bool isLvnRow = f_row_is_lvn(row)
                color fillColor = rowVolume <= 0 ? color.new(color.white, 100) : isPocRow ? color.new(color.orange, 65) : isLvnRow ? color.new(color.red, 78) : color.new(color.blue, 82)
                color borderColor = rowVolume <= 0 ? color.new(color.gray, 80) : isPocRow ? color.new(color.orange, 0) : isLvnRow ? color.new(color.red, 20) : color.new(color.blue, 55)
                box rowBox = box.new(rowLeftEdge, rowHigh, rowRightEdge, rowLow, xloc = xloc.bar_index, bgcolor = fillColor, border_color = borderColor, border_width = isPocRow ? 2 : 1)
                array.push(profileBoxes, rowBox)
                renderedRowCount += 1
                if rowVolume > 0
                    renderedNonzeroRowCount += 1

    [renderedRowCount, renderedNonzeroRowCount, histogramLeftEdge, histogramRightEdge]

f_update_row_diagnostics_table() =>
    table.clear(rowDiagnosticsTable, 0, 0, 7, 204)

    bool showDiagnostics = showDebug and (showRowDiagnostics or nativeFrvpComparisonMode)
    if showDiagnostics
        table.cell(rowDiagnosticsTable, 0, 0, "Row", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 1, 0, "Low", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 2, 0, "High", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 3, 0, "Vol", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 4, 0, "%POC", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 5, 0, "LVN?", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 6, 0, "Depth", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 7, 0, "Contrast", text_color = color.white, bgcolor = color.new(color.navy, 0))

        if array.size(profileVolumes) > 0
            float pocVol = not na(previousPocVolume) ? previousPocVolume : frozenMaxRowVolume
            int rowCount = array.size(profileVolumes)
            for displayIndex = 0 to rowCount - 1
                int row = rowCount - 1 - displayIndex
                int tableRow = displayIndex + 1
                float rowLow = array.get(profileRowLows, row)
                float rowHigh = array.get(profileRowHighs, row)
                float rowVolume = array.get(profileVolumes, row)
                float rowPctOfPoc = not na(pocVol) and pocVol > 0 ? rowVolume / pocVol * 100.0 : na
                int lvnIndex = f_row_lvn_index(row)
                string lvnFlag = lvnIndex >= 0 ? "Y" : ""
                string depthText = lvnIndex >= 0 ? str.tostring(array.get(tradableDepthRatios, lvnIndex), "#.###") : ""
                string contrastText = lvnIndex >= 0 ? str.tostring(array.get(tradableContrastRatios, lvnIndex), "#.##") : ""
                color rowBg = lvnIndex >= 0 ? color.new(color.red, 88) : color.new(color.black, 92)

                table.cell(rowDiagnosticsTable, 0, tableRow, str.tostring(row + 1), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 1, tableRow, str.tostring(rowLow, format.mintick), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 2, tableRow, str.tostring(rowHigh, format.mintick), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 3, tableRow, str.tostring(rowVolume, "#.##"), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 4, tableRow, not na(rowPctOfPoc) ? str.tostring(rowPctOfPoc, "#.##") + "%" : "", text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 5, tableRow, lvnFlag, text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 6, tableRow, depthText, text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 7, tableRow, contrastText, text_color = color.white, bgcolor = rowBg)

f_zone_touched(int direction, float entryPrice) =>
    direction == 1 ? low <= entryPrice : high >= entryPrice

f_poc_context_ok(float levelCenter) =>
    bool distanceOk = not usePocDistanceFilter
    bool sideOk = true

    if not na(previousPocPrice)
        float distanceFromPoc = math.abs(levelCenter - previousPocPrice)
        distanceOk := not usePocDistanceFilter or distanceFromPoc >= minimumPocDistance

        if levelCenter > previousPocPrice
            sideOk := tradeLvnsAbovePoc
        else if levelCenter < previousPocPrice
            sideOk := tradeLvnsBelowPoc
        else
            sideOk := tradeLvnsAbovePoc or tradeLvnsBelowPoc

    distanceOk and sideOk

f_session_close_timestamp() =>
    int closeYear = year(time_close, sessionTimezone)
    int closeMonth = month(time_close, sessionTimezone)
    int closeDay = dayofmonth(time_close, sessionTimezone)
    int closeHour = hour(time_close, sessionTimezone)
    closeHour >= 18 ? timestamp(sessionTimezone, closeYear, closeMonth, closeDay + 1, 16, 0) : timestamp(sessionTimezone, closeYear, closeMonth, closeDay, 16, 0)

f_average_volume(array<float> src, int startIndex, int endIndex) =>
    float avgValue = na
    if startIndex >= 0 and endIndex < array.size(src) and startIndex <= endIndex
        float totalValue = 0.0
        int count = 0
        for i = startIndex to endIndex
            totalValue += array.get(src, i)
            count += 1
        avgValue := count > 0 ? totalValue / count : na
    avgValue

f_sum_volume(array<float> src, int startIndex, int endIndex) =>
    float totalValue = na
    if startIndex >= 0 and endIndex < array.size(src) and startIndex <= endIndex
        totalValue := 0.0
        for i = startIndex to endIndex
            totalValue += array.get(src, i)
    totalValue

f_collect_volume_stats(array<float> src) =>
    int valueCount = array.size(src)
    int numericCount = 0
    int positiveCount = 0
    float minValue = na
    float maxValue = na
    float sumValue = 0.0

    if valueCount > 0
        for i = 0 to valueCount - 1
            float value = array.get(src, i)
            if not na(value)
                numericCount += 1
                positiveCount += value > 0 ? 1 : 0
                minValue := na(minValue) ? value : math.min(minValue, value)
                maxValue := na(maxValue) ? value : math.max(maxValue, value)
                sumValue += value

    [valueCount, numericCount, positiveCount, minValue, maxValue, numericCount > 0 ? sumValue : na]

f_build_detector_probe_text(string probeLabel, array<float> sourceVolumes, int probeRow) =>
    int rowCount = array.size(sourceVolumes)
    string probeText = probeLabel + ": " + (not na(probeRow) ? str.tostring(probeRow + 1) : "na")

    if not na(probeRow) and probeRow >= 0 and probeRow < rowCount
        float currentVol = array.get(sourceVolumes, probeRow)
        float below1Vol = probeRow - 1 >= 0 ? array.get(sourceVolumes, probeRow - 1) : na
        float below2Vol = probeRow - 2 >= 0 ? array.get(sourceVolumes, probeRow - 2) : na
        float above1Vol = probeRow + 1 < rowCount ? array.get(sourceVolumes, probeRow + 1) : na
        float above2Vol = probeRow + 2 < rowCount ? array.get(sourceVolumes, probeRow + 2) : na
        float helperAvgBelow = f_average_volume(sourceVolumes, probeRow - surroundingRows, probeRow - 1)
        float helperAvgAbove = f_average_volume(sourceVolumes, probeRow + 1, probeRow + surroundingRows)
        float surroundingAvg = not na(helperAvgBelow) and not na(helperAvgAbove) ? (helperAvgBelow + helperAvgAbove) * 0.5 : na
        float manualAvgBelow = not na(below1Vol) and not na(below2Vol) ? (below1Vol + below2Vol) * 0.5 : na
        float manualAvgAbove = not na(above1Vol) and not na(above2Vol) ? (above1Vol + above2Vol) * 0.5 : na
        bool helperMatch = not na(helperAvgBelow) and not na(helperAvgAbove) and not na(manualAvgBelow) and not na(manualAvgAbove) and f_values_close(helperAvgBelow, manualAvgBelow) and f_values_close(helperAvgAbove, manualAvgAbove)

        probeText += "\nCurrent: " + (not na(currentVol) ? str.tostring(currentVol, "#.##") : "na")
        probeText += "\nBelow1: " + (not na(below1Vol) ? str.tostring(below1Vol, "#.##") : "na")
        probeText += "\nBelow2: " + (not na(below2Vol) ? str.tostring(below2Vol, "#.##") : "na")
        probeText += "\nAbove1: " + (not na(above1Vol) ? str.tostring(above1Vol, "#.##") : "na")
        probeText += "\nAbove2: " + (not na(above2Vol) ? str.tostring(above2Vol, "#.##") : "na")
        probeText += "\nHelper Avg Below: " + (not na(helperAvgBelow) ? str.tostring(helperAvgBelow, "#.##") : "na")
        probeText += "\nManual Avg Below: " + (not na(manualAvgBelow) ? str.tostring(manualAvgBelow, "#.##") : "na")
        probeText += "\nHelper Avg Above: " + (not na(helperAvgAbove) ? str.tostring(helperAvgAbove, "#.##") : "na")
        probeText += "\nManual Avg Above: " + (not na(manualAvgAbove) ? str.tostring(manualAvgAbove, "#.##") : "na")
        probeText += "\nAvg Below: " + (not na(helperAvgBelow) ? str.tostring(helperAvgBelow, "#.##") : "na")
        probeText += "\nAvg Above: " + (not na(helperAvgAbove) ? str.tostring(helperAvgAbove, "#.##") : "na")
        probeText += "\nSurrounding Avg: " + (not na(surroundingAvg) ? str.tostring(surroundingAvg, "#.##") : "na")
        probeText += "\nAverage Helper Match: " + (helperMatch ? "PASS" : "FAIL")
    else
        probeText += "\nProbe unavailable for current bounds."

    probeText

f_array_max(array<float> src) =>
    float maxValue = na
    if array.size(src) > 0
        maxValue := array.get(src, 0)
        if array.size(src) > 1
            for i = 1 to array.size(src) - 1
                maxValue := math.max(maxValue, array.get(src, i))
    maxValue

f_array_min(array<float> src) =>
    float minValue = na
    if array.size(src) > 0
        minValue := array.get(src, 0)
        if array.size(src) > 1
            for i = 1 to array.size(src) - 1
                minValue := math.min(minValue, array.get(src, i))
    minValue

f_push_candidate_region(
    array<int> outStartRows,
    array<int> outEndRows,
    array<float> outLows,
    array<float> outHighs,
    array<float> outCenters,
    array<float> outAvgVolumes,
    array<float> outTotalVolumes,
    array<float> outSurroundAvgs,
    array<float> outAvgAbove,
    array<float> outAvgBelow,
    array<float> outDepthRatios,
    array<float> outContrastRatios,
    array<int> outWidths,
    int startRow,
    int endRow,
    float regionLow,
    float regionHigh,
    float regionCenter,
    float regionAvgVolume,
    float regionTotalVolume,
    float surroundingAvg,
    float averageAbove,
    float averageBelow,
    float depthRatio,
    float contrastRatio,
    int regionWidth
) =>
    array.push(outStartRows, startRow)
    array.push(outEndRows, endRow)
    array.push(outLows, regionLow)
    array.push(outHighs, regionHigh)
    array.push(outCenters, regionCenter)
    array.push(outAvgVolumes, regionAvgVolume)
    array.push(outTotalVolumes, regionTotalVolume)
    array.push(outSurroundAvgs, surroundingAvg)
    array.push(outAvgAbove, averageAbove)
    array.push(outAvgBelow, averageBelow)
    array.push(outDepthRatios, depthRatio)
    array.push(outContrastRatios, contrastRatio)
    array.push(outWidths, regionWidth)

f_build_profile_chart_bars(array<float> srcHighs, array<float> srcLows, array<float> srcVolumes, float sessionHigh, float sessionLow, int rows, array<float> outVolumes, array<float> outRowLows, array<float> outRowHighs) =>
    array.clear(outVolumes)
    array.clear(outRowLows)
    array.clear(outRowHighs)

    bool validProfile = array.size(srcHighs) > 0 and not na(sessionHigh) and not na(sessionLow) and sessionHigh > sessionLow and rows > 0
    float rowHeight = na
    float totalVolume = 0.0
    int pocIndex = -1
    float pocVolume = na

    if validProfile
        rowHeight := (sessionHigh - sessionLow) / rows
        validProfile := rowHeight > 0

    if validProfile
        for row = 0 to rows - 1
            // Rows are modeled as contiguous half-open bins [low, high), except the final top row,
            // which is explicitly terminated at the frozen session high to avoid cumulative drift.
            float rowLow = sessionLow + row * rowHeight
            float rowHigh = row == rows - 1 ? sessionHigh : rowLow + rowHeight
            array.push(outRowLows, rowLow)
            array.push(outRowHighs, rowHigh)
            array.push(outVolumes, 0.0)

        for barIndex = 0 to array.size(srcHighs) - 1
            float candleHigh = array.get(srcHighs, barIndex)
            float candleLow = array.get(srcLows, barIndex)
            float candleVolume = math.max(array.get(srcVolumes, barIndex), 0.0)
            float candleRange = candleHigh - candleLow
            totalVolume += candleVolume

            if candleVolume > 0
                if candleRange <= 0
                    float clampedPrice = math.max(sessionLow, math.min(candleLow, sessionHigh))
                    int rowIndex = int(math.floor((clampedPrice - sessionLow) / rowHeight))
                    rowIndex := math.max(0, math.min(rows - 1, rowIndex))
                    array.set(outVolumes, rowIndex, array.get(outVolumes, rowIndex) + candleVolume)
                else
                    for row = 0 to rows - 1
                        float binLow = array.get(outRowLows, row)
                        float binHigh = array.get(outRowHighs, row)
                        float overlap = math.max(0.0, math.min(candleHigh, binHigh) - math.max(candleLow, binLow))
                        if overlap > 0
                            float allocatedVolume = candleVolume * overlap / candleRange
                            array.set(outVolumes, row, array.get(outVolumes, row) + allocatedVolume)

        float runningPocVolume = -1.0
        for row = 0 to array.size(outVolumes) - 1
            float rowVolume = array.get(outVolumes, row)
            if rowVolume > runningPocVolume
                runningPocVolume := rowVolume
                pocIndex := row

        pocVolume := pocIndex >= 0 ? array.get(outVolumes, pocIndex) : na

    [validProfile, rowHeight, totalVolume, pocIndex, pocVolume]

f_build_profile(array<float> srcHighs, array<float> srcLows, array<float> srcVolumes, float sessionHigh, float sessionLow, int rows, array<float> outVolumes, array<float> outRowLows, array<float> outRowHighs) =>
    // This dispatcher is kept separate so a future lower-timeframe implementation can replace or
    // augment the chart-bar approximation without changing strategy execution logic.
    f_build_profile_chart_bars(srcHighs, srcLows, srcVolumes, sessionHigh, sessionLow, rows, outVolumes, outRowLows, outRowHighs)

f_find_higher_volume_below(array<float> sourceVolumes, int startRow, int maxSearchRows, float targetVolume) =>
    bool found = false
    int distance = na
    int searchRow = startRow - 1

    while searchRow >= 0 and startRow - searchRow <= maxSearchRows
        if array.get(sourceVolumes, searchRow) > targetVolume
            found := true
            distance := startRow - searchRow
            break
        searchRow -= 1

    [found, distance]

f_find_higher_volume_above(array<float> sourceVolumes, int endRow, int maxSearchRows, float targetVolume) =>
    bool found = false
    int distance = na
    int rowCount = array.size(sourceVolumes)
    int searchRow = endRow + 1

    while searchRow < rowCount and searchRow - endRow <= maxSearchRows
        if array.get(sourceVolumes, searchRow) > targetVolume
            found := true
            distance := searchRow - endRow
            break
        searchRow += 1

    [found, distance]

f_evaluate_client_threshold_boundaries(array<float> sourceVolumes, int startRow, int endRow, float regionAvgVolume, float avgBelow, float avgAbove) =>
    bool lowerHvnFound = false
    bool upperHvnFound = false
    int distanceToLowerHvn = na
    int distanceToUpperHvn = na
    bool boundaryPass = false

    if clientThresholdBoundaryMode == "Immediate Surrounding Average"
        [lowerHvnFound, distanceToLowerHvn] = f_find_higher_volume_below(sourceVolumes, startRow, surroundingRows, regionAvgVolume)
        [upperHvnFound, distanceToUpperHvn] = f_find_higher_volume_above(sourceVolumes, endRow, surroundingRows, regionAvgVolume)
        boundaryPass := not na(avgBelow) and not na(avgAbove) and avgBelow > regionAvgVolume and avgAbove > regionAvgVolume
    else
        [lowerHvnFound, distanceToLowerHvn] = f_find_higher_volume_below(sourceVolumes, startRow, hvnBoundarySearchRows, regionAvgVolume)
        [upperHvnFound, distanceToUpperHvn] = f_find_higher_volume_above(sourceVolumes, endRow, hvnBoundarySearchRows, regionAvgVolume)
        boundaryPass := lowerHvnFound and upperHvnFound

    [boundaryPass, lowerHvnFound, upperHvnFound, distanceToLowerHvn, distanceToUpperHvn]

f_detect_client_threshold_candidates(
    array<float> sourceVolumes,
    array<float> sourceRowLows,
    array<float> sourceRowHighs,
    int pocIndex,
    array<int> outStartRows,
    array<int> outEndRows,
    array<float> outLows,
    array<float> outHighs,
    array<float> outCenters,
    array<float> outAvgVolumes,
    array<float> outTotalVolumes,
    array<float> outSurroundAvgs,
    array<float> outAvgAbove,
    array<float> outAvgBelow,
    array<float> outDepthRatios,
    array<float> outContrastRatios,
    array<int> outWidths
) =>
    int rowCount = array.size(sourceVolumes)
    float threshold = lvnThresholdPct / 100.0
    [sourceVolumesSize, sourceVolumesNumericCount, sourceVolumesPositiveCount, sourceVolumesMin, sourceVolumesMax, sourceVolumesSum] = f_collect_volume_stats(sourceVolumes)
    int sourceRowLowsSize = array.size(sourceRowLows)
    int sourceRowHighsSize = array.size(sourceRowHighs)
    bool detectorInputInvalid = sourceVolumesSize != profileRows or sourceRowLowsSize != profileRows or sourceRowHighsSize != profileRows
    int fixedProbeRow = rowCount >= surroundingRows * 2 + 1 ? surroundingRows : na
    int pocProbeRow = rowCount >= surroundingRows * 2 + 1 and pocIndex >= 0 ? math.max(surroundingRows, math.min(pocIndex, rowCount - surroundingRows - 1)) : na
    string fixedProbeText = detectorInputInvalid ? "Detector Probe Row: unavailable due to detector input error." : f_build_detector_probe_text("Detector Probe Row", sourceVolumes, fixedProbeRow)
    string pocProbeText = detectorInputInvalid ? "Detector POC Probe Row: unavailable due to detector input error." : f_build_detector_probe_text("Detector POC Probe Row", sourceVolumes, pocProbeRow)
    int localThresholdCandidateCount = 0
    int mergedLowVolumeRegionCount = 0
    int finalQualifyingCount = 0
    int evaluableInteriorRows = 0
    int rowsWithValidSurroundingAverage = 0
    float bestRawRowDepthRatio = na
    float minimumRawDepthRatioAcrossAllValidInteriorRows = na
    float bestMergedRegionDepthRatio = na
    float bestMergedRegionSurroundingAvg = na
    bool bestLowerHvnFound = false
    bool bestUpperHvnFound = false
    int bestDistanceToLowerHvn = na
    int bestDistanceToUpperHvn = na
    bool bestMergedRegionBoundaryPass = false
    bool bestMergedRegionContrastPass = false
    bool bestMergedRegionThresholdPass = false
    string bestMergedRegionReason = detectorInputInvalid ? "DETECTOR INPUT ERROR: expected " + str.tostring(profileRows) + " profile rows, received " + str.tostring(sourceVolumesSize) + "." : rowCount >= surroundingRows * 2 + 1 ? "No local threshold candidates passed the raw depth threshold." : "Not enough rows to evaluate Client Threshold Valley."

    if not detectorInputInvalid and rowCount >= surroundingRows * 2 + 1
        evaluableInteriorRows := rowCount - surroundingRows * 2
        array<bool> seedRows = array.new_bool(rowCount, false)

        for row = surroundingRows to rowCount - surroundingRows - 1
            float currentVol = array.get(sourceVolumes, row)
            float avgBelow = f_average_volume(sourceVolumes, row - surroundingRows, row - 1)
            float avgAbove = f_average_volume(sourceVolumes, row + 1, row + surroundingRows)
            float surroundingAvg = not na(avgBelow) and not na(avgAbove) ? (avgBelow + avgAbove) * 0.5 : na
            float rawDepthRatio = na
            if not na(surroundingAvg) and surroundingAvg > 0
                rowsWithValidSurroundingAverage += 1
                rawDepthRatio := currentVol / surroundingAvg
                if na(minimumRawDepthRatioAcrossAllValidInteriorRows) or rawDepthRatio < minimumRawDepthRatioAcrossAllValidInteriorRows
                    minimumRawDepthRatioAcrossAllValidInteriorRows := rawDepthRatio
            bool thresholdPass = not na(surroundingAvg) and surroundingAvg > 0 and currentVol <= surroundingAvg * threshold
            if thresholdPass
                localThresholdCandidateCount += 1
            array.set(seedRows, row, thresholdPass)

        bestRawRowDepthRatio := minimumRawDepthRatioAcrossAllValidInteriorRows

        if evaluableInteriorRows > 0 and rowsWithValidSurroundingAverage == 0
            bestMergedRegionReason := "No interior rows had a valid surrounding average."

        int row = surroundingRows
        while row <= rowCount - surroundingRows - 1
            if array.get(seedRows, row)
                int startRow = row
                int endRow = row
                while endRow + 1 <= rowCount - surroundingRows - 1 and array.get(seedRows, endRow + 1)
                    endRow += 1

                mergedLowVolumeRegionCount += 1
                if startRow - surroundingRows >= 0 and endRow + surroundingRows < rowCount
                    float avgBelow = f_average_volume(sourceVolumes, startRow - surroundingRows, startRow - 1)
                    float avgAbove = f_average_volume(sourceVolumes, endRow + 1, endRow + surroundingRows)
                    float regionTotalVolume = f_sum_volume(sourceVolumes, startRow, endRow)
                    int regionWidth = endRow - startRow + 1
                    float regionAvgVolume = not na(regionTotalVolume) and regionWidth > 0 ? regionTotalVolume / regionWidth : na
                    float surroundingAvg = not na(avgBelow) and not na(avgAbove) ? (avgBelow + avgAbove) * 0.5 : na
                    float depthRatio = not na(surroundingAvg) and surroundingAvg > 0 ? regionAvgVolume / surroundingAvg : na
                    float contrastRatio = not na(regionAvgVolume) and regionAvgVolume > 0 ? surroundingAvg / regionAvgVolume : na
                    bool thresholdPass = not na(regionAvgVolume) and not na(surroundingAvg) and regionAvgVolume <= surroundingAvg * threshold
                    [boundaryPass, lowerHvnFound, upperHvnFound, distanceToLowerHvn, distanceToUpperHvn] = f_evaluate_client_threshold_boundaries(sourceVolumes, startRow, endRow, regionAvgVolume, avgBelow, avgAbove)
                    bool contrastPass = not useContrastFilter or (not na(contrastRatio) and contrastRatio >= minContrastRatio)
                    bool qualifies = boundaryPass and contrastPass and thresholdPass

                    bool betterMergedRegion = not na(depthRatio) and (na(bestMergedRegionDepthRatio) or depthRatio < bestMergedRegionDepthRatio)
                    if betterMergedRegion
                        bestMergedRegionDepthRatio := depthRatio
                        bestMergedRegionSurroundingAvg := surroundingAvg
                        bestLowerHvnFound := lowerHvnFound
                        bestUpperHvnFound := upperHvnFound
                        bestDistanceToLowerHvn := distanceToLowerHvn
                        bestDistanceToUpperHvn := distanceToUpperHvn
                        bestMergedRegionBoundaryPass := boundaryPass
                        bestMergedRegionContrastPass := contrastPass
                        bestMergedRegionThresholdPass := thresholdPass
                        if not thresholdPass
                            bestMergedRegionReason := "Best raw row passed threshold, but merged region depth = " + str.tostring(depthRatio, "#.####") + " > " + str.tostring(threshold, "#.####")
                        else if not boundaryPass
                            if clientThresholdBoundaryMode == "Immediate Surrounding Average"
                                bestMergedRegionReason := "Merged region failed immediate surrounding average boundary requirement."
                            else if not lowerHvnFound and not upperHvnFound
                                bestMergedRegionReason := "Merged region failed upper/lower boundary requirement. No higher-volume nodes were found on either side."
                            else if not lowerHvnFound
                                bestMergedRegionReason := "Merged region failed upper/lower boundary requirement. No lower higher-volume node was found within search range."
                            else if not upperHvnFound
                                bestMergedRegionReason := "Merged region failed upper/lower boundary requirement. No upper higher-volume node was found within search range."
                            else
                                bestMergedRegionReason := "Merged region failed upper/lower boundary requirement."
                        else if not contrastPass
                            bestMergedRegionReason := "Merged region failed contrast filter."
                        else
                            bestMergedRegionReason := "Merged region qualified as an LVN."

                    if qualifies and regionWidth > 0
                        float regionLow = array.get(sourceRowLows, startRow)
                        float regionHigh = array.get(sourceRowHighs, endRow)
                        float regionCenter = (regionLow + regionHigh) * 0.5
                        if not na(depthRatio) and not na(contrastRatio)
                            f_push_candidate_region(outStartRows, outEndRows, outLows, outHighs, outCenters, outAvgVolumes, outTotalVolumes, outSurroundAvgs, outAvgAbove, outAvgBelow, outDepthRatios, outContrastRatios, outWidths, startRow, endRow, regionLow, regionHigh, regionCenter, regionAvgVolume, regionTotalVolume, surroundingAvg, avgAbove, avgBelow, depthRatio, contrastRatio, regionWidth)
                            finalQualifyingCount += 1

                row := endRow + 1
            else
                row += 1

    [localThresholdCandidateCount, mergedLowVolumeRegionCount, finalQualifyingCount, sourceVolumesSize, sourceRowLowsSize, sourceRowHighsSize, sourceVolumesNumericCount, sourceVolumesPositiveCount, sourceVolumesMin, sourceVolumesMax, sourceVolumesSum, evaluableInteriorRows, rowsWithValidSurroundingAverage, bestRawRowDepthRatio, minimumRawDepthRatioAcrossAllValidInteriorRows, bestMergedRegionDepthRatio, bestMergedRegionSurroundingAvg, bestLowerHvnFound, bestUpperHvnFound, bestDistanceToLowerHvn, bestDistanceToUpperHvn, bestMergedRegionBoundaryPass, bestMergedRegionContrastPass, bestMergedRegionThresholdPass, fixedProbeText, pocProbeText, bestMergedRegionReason]

f_detect_legacy_candidates(
    array<float> sourceVolumes,
    array<float> sourceRowLows,
    array<float> sourceRowHighs,
    int pocIndex,
    float pocVol,
    array<int> outStartRows,
    array<int> outEndRows,
    array<float> outLows,
    array<float> outHighs,
    array<float> outCenters,
    array<float> outAvgVolumes,
    array<float> outTotalVolumes,
    array<float> outSurroundAvgs,
    array<float> outAvgAbove,
    array<float> outAvgBelow,
    array<float> outDepthRatios,
    array<float> outContrastRatios,
    array<int> outWidths
) =>
    int rowCount = array.size(sourceVolumes)

    if rowCount >= neighborWindow * 2 + 1 and pocIndex >= 0 and not na(pocVol) and pocVol > 0
        for row = neighborWindow to rowCount - neighborWindow - 1
            float currentVol = array.get(sourceVolumes, row)
            bool localMin = true
            float neighborTotal = 0.0
            int neighborCount = 0

            for offset = 1 to neighborWindow
                float leftVol = array.get(sourceVolumes, row - offset)
                float rightVol = array.get(sourceVolumes, row + offset)
                localMin := localMin and currentVol < leftVol and currentVol < rightVol
                neighborTotal += leftVol + rightVol
                neighborCount += 2

            float surroundingAvg = neighborCount > 0 ? neighborTotal / neighborCount : na
            bool depthPass = not na(surroundingAvg) and currentVol <= surroundingAvg * relativeDepthThreshold
            bool pocPass = currentVol <= pocVol * pocVolumeThreshold

            bool methodPass = switch lvnMethod
                "Relative to POC" => localMin and pocPass
                "Neighbor Threshold" => localMin and depthPass
                => localMin

            if methodPass and not na(surroundingAvg) and surroundingAvg > 0
                float rowLow = array.get(sourceRowLows, row)
                float rowHigh = array.get(sourceRowHighs, row)
                float rowCenter = (rowLow + rowHigh) * 0.5
                float depthRatio = currentVol / surroundingAvg
                float contrastRatio = currentVol > 0 ? surroundingAvg / currentVol : na
                bool contrastPass = not useContrastFilter or (not na(contrastRatio) and contrastRatio >= minContrastRatio)
                if contrastPass and not na(contrastRatio)
                    float avgBelow = f_average_volume(sourceVolumes, row - neighborWindow, row - 1)
                    float avgAbove = f_average_volume(sourceVolumes, row + 1, row + neighborWindow)
                    f_push_candidate_region(outStartRows, outEndRows, outLows, outHighs, outCenters, outAvgVolumes, outTotalVolumes, outSurroundAvgs, outAvgAbove, outAvgBelow, outDepthRatios, outContrastRatios, outWidths, row, row, rowLow, rowHigh, rowCenter, currentVol, currentVol, surroundingAvg, avgAbove, avgBelow, depthRatio, contrastRatio, 1)

f_is_region_separated(int candidateStartRow, int candidateEndRow) =>
    bool separated = true
    if array.size(tradableStartRows) > 0
        for i = 0 to array.size(tradableStartRows) - 1
            int selectedStart = array.get(tradableStartRows, i)
            int selectedEnd = array.get(tradableEndRows, i)
            bool rowGapOk = candidateEndRow < selectedStart - minSeparationRows or candidateStartRow > selectedEnd + minSeparationRows
            separated := separated and rowGapOk
    separated

f_rank_and_store_tradable_lvns(
    array<int> candidateStartRows,
    array<int> candidateEndRows,
    array<float> candidateLows,
    array<float> candidateHighs,
    array<float> candidateCenters,
    array<float> candidateAvgVolumes,
    array<float> candidateTotalVolumes,
    array<float> candidateSurroundAvgs,
    array<float> candidateAvgAbove,
    array<float> candidateAvgBelow,
    array<float> candidateDepthRatios,
    array<float> candidateContrastRatios,
    array<int> candidateWidths
) =>
    f_clear_tradable_lvns()

    int candidateCount = array.size(candidateCenters)
    array<bool> selectedFlags = array.new_bool(candidateCount, false)

    if candidateCount > 0
        for rankSlot = 0 to math.min(maxLvns, candidateCount) - 1
            int bestIndex = -1

            for candidateIndex = 0 to candidateCount - 1
                if not array.get(selectedFlags, candidateIndex)
                    int candidateStartRow = array.get(candidateStartRows, candidateIndex)
                    int candidateEndRow = array.get(candidateEndRows, candidateIndex)
                    bool separated = f_is_region_separated(candidateStartRow, candidateEndRow)

                    if separated
                        float candidateRatio = array.get(candidateDepthRatios, candidateIndex)
                        float candidateContrast = array.get(candidateContrastRatios, candidateIndex)
                        int candidateWidth = array.get(candidateWidths, candidateIndex)
                        float candidateCenter = array.get(candidateCenters, candidateIndex)

                        if bestIndex == -1
                            bestIndex := candidateIndex
                        else
                            float bestRatio = array.get(candidateDepthRatios, bestIndex)
                            float bestContrast = array.get(candidateContrastRatios, bestIndex)
                            int bestWidth = array.get(candidateWidths, bestIndex)
                            float bestCenter = array.get(candidateCenters, bestIndex)

                            bool better = candidateRatio < bestRatio
                            better := better or (candidateRatio == bestRatio and candidateContrast > bestContrast)
                            better := better or (candidateRatio == bestRatio and candidateContrast == bestContrast and candidateWidth > bestWidth)
                            better := better or (candidateRatio == bestRatio and candidateContrast == bestContrast and candidateWidth == bestWidth and candidateCenter < bestCenter)

                            if better
                                bestIndex := candidateIndex

            if bestIndex != -1
                array.set(selectedFlags, bestIndex, true)
                array.push(tradableStartRows, array.get(candidateStartRows, bestIndex))
                array.push(tradableEndRows, array.get(candidateEndRows, bestIndex))
                array.push(tradableLows, array.get(candidateLows, bestIndex))
                array.push(tradableHighs, array.get(candidateHighs, bestIndex))
                array.push(tradableCenters, array.get(candidateCenters, bestIndex))
                array.push(tradableRegionAvgVolumes, array.get(candidateAvgVolumes, bestIndex))
                array.push(tradableRegionTotalVolumes, array.get(candidateTotalVolumes, bestIndex))
                array.push(tradableSurroundingAvgs, array.get(candidateSurroundAvgs, bestIndex))
                array.push(tradableAverageAboveVolumes, array.get(candidateAvgAbove, bestIndex))
                array.push(tradableAverageBelowVolumes, array.get(candidateAvgBelow, bestIndex))
                array.push(tradableDepthRatios, array.get(candidateDepthRatios, bestIndex))
                array.push(tradableContrastRatios, array.get(candidateContrastRatios, bestIndex))
                array.push(tradableRegionWidths, array.get(candidateWidths, bestIndex))

    array.size(tradableCenters)

f_prepare_tradable_lvns(array<float> sourceVolumes, array<float> sourceRowLows, array<float> sourceRowHighs, int pocIndex, float pocVol) =>
    [prepareEntryVolumesSize, prepareEntryNumericCount, prepareEntryPositiveCount, prepareEntryVolumesMin, prepareEntryVolumesMax, prepareEntryVolumesSum] = f_collect_volume_stats(sourceVolumes)
    int prepareEntryRowLowsSize = array.size(sourceRowLows)
    int prepareEntryRowHighsSize = array.size(sourceRowHighs)

    f_clear_tradable_lvns()

    [prepareAfterClearVolumesSize, prepareAfterClearNumericCount, prepareAfterClearPositiveCount, prepareAfterClearVolumesMin, prepareAfterClearVolumesMax, prepareAfterClearVolumesSum] = f_collect_volume_stats(sourceVolumes)
    int prepareAfterClearRowLowsSize = array.size(sourceRowLows)
    int prepareAfterClearRowHighsSize = array.size(sourceRowHighs)

    array<int> candidateStartRows = array.new_int()
    array<int> candidateEndRows = array.new_int()
    array<float> candidateLows = array.new_float()
    array<float> candidateHighs = array.new_float()
    array<float> candidateCenters = array.new_float()
    array<float> candidateAvgVolumes = array.new_float()
    array<float> candidateTotalVolumes = array.new_float()
    array<float> candidateSurroundAvgs = array.new_float()
    array<float> candidateAvgAbove = array.new_float()
    array<float> candidateAvgBelow = array.new_float()
    array<float> candidateDepthRatios = array.new_float()
    array<float> candidateContrastRatios = array.new_float()
    array<int> candidateWidths = array.new_int()
    int localThresholdCandidates = 0
    int mergedLowVolumeRegions = 0
    int finalQualifyingLvns = 0
    int sourceVolumesSize = 0
    int sourceRowLowsSize = 0
    int sourceRowHighsSize = 0
    int sourceVolumesNumericCount = 0
    int sourceVolumesPositiveCount = 0
    float sourceVolumesMin = na
    float sourceVolumesMax = na
    float sourceVolumesSum = na
    int evaluableInteriorRows = 0
    int rowsWithValidSurroundingAverage = 0
    float bestRawRowDepthRatio = na
    float minimumRawDepthRatioAcrossAllValidInteriorRows = na
    float bestMergedRegionDepthRatio = na
    float bestMergedRegionSurroundingAvg = na
    bool bestLowerHvnFound = false
    bool bestUpperHvnFound = false
    int distanceToLowerHvn = na
    int distanceToUpperHvn = na
    bool bestMergedRegionBoundaryPass = false
    bool bestMergedRegionContrastPass = false
    bool bestMergedRegionThresholdPass = false
    string fixedProbeText = ""
    string pocProbeText = ""
    string bestMergedRegionReason = ""

    if lvnMethod == "Client Threshold Valley"
        [localThresholdCandidates, mergedLowVolumeRegions, finalQualifyingLvns, sourceVolumesSize, sourceRowLowsSize, sourceRowHighsSize, sourceVolumesNumericCount, sourceVolumesPositiveCount, sourceVolumesMin, sourceVolumesMax, sourceVolumesSum, evaluableInteriorRows, rowsWithValidSurroundingAverage, bestRawRowDepthRatio, minimumRawDepthRatioAcrossAllValidInteriorRows, bestMergedRegionDepthRatio, bestMergedRegionSurroundingAvg, bestLowerHvnFound, bestUpperHvnFound, distanceToLowerHvn, distanceToUpperHvn, bestMergedRegionBoundaryPass, bestMergedRegionContrastPass, bestMergedRegionThresholdPass, fixedProbeText, pocProbeText, bestMergedRegionReason] = f_detect_client_threshold_candidates(sourceVolumes, sourceRowLows, sourceRowHighs, pocIndex, candidateStartRows, candidateEndRows, candidateLows, candidateHighs, candidateCenters, candidateAvgVolumes, candidateTotalVolumes, candidateSurroundAvgs, candidateAvgAbove, candidateAvgBelow, candidateDepthRatios, candidateContrastRatios, candidateWidths)
    else
        f_detect_legacy_candidates(sourceVolumes, sourceRowLows, sourceRowHighs, pocIndex, pocVol, candidateStartRows, candidateEndRows, candidateLows, candidateHighs, candidateCenters, candidateAvgVolumes, candidateTotalVolumes, candidateSurroundAvgs, candidateAvgAbove, candidateAvgBelow, candidateDepthRatios, candidateContrastRatios, candidateWidths)

    int preparedCount = f_rank_and_store_tradable_lvns(candidateStartRows, candidateEndRows, candidateLows, candidateHighs, candidateCenters, candidateAvgVolumes, candidateTotalVolumes, candidateSurroundAvgs, candidateAvgAbove, candidateAvgBelow, candidateDepthRatios, candidateContrastRatios, candidateWidths)

    [preparedCount, prepareEntryVolumesSize, prepareEntryRowLowsSize, prepareEntryRowHighsSize, prepareEntryVolumesSum, prepareEntryVolumesMin, prepareEntryVolumesMax, prepareAfterClearVolumesSize, prepareAfterClearRowLowsSize, prepareAfterClearRowHighsSize, prepareAfterClearVolumesSum, prepareAfterClearVolumesMin, prepareAfterClearVolumesMax, localThresholdCandidates, mergedLowVolumeRegions, finalQualifyingLvns, sourceVolumesSize, sourceRowLowsSize, sourceRowHighsSize, sourceVolumesNumericCount, sourceVolumesPositiveCount, sourceVolumesMin, sourceVolumesMax, sourceVolumesSum, evaluableInteriorRows, rowsWithValidSurroundingAverage, bestRawRowDepthRatio, minimumRawDepthRatioAcrossAllValidInteriorRows, bestMergedRegionDepthRatio, bestMergedRegionSurroundingAvg, bestLowerHvnFound, bestUpperHvnFound, distanceToLowerHvn, distanceToUpperHvn, bestMergedRegionBoundaryPass, bestMergedRegionContrastPass, bestMergedRegionThresholdPass, fixedProbeText, pocProbeText, bestMergedRegionReason]

f_get_trade_levels(int direction, float entryPrice, float lvnLow, float lvnHigh) =>
    float stopPrice = na
    float targetPrice = na

    if riskMode == "Fixed Points"
        if direction == 1
            stopPrice := entryPrice - fixedSLPoints
            targetPrice := entryPrice + fixedTPPoints
        else
            stopPrice := entryPrice + fixedSLPoints
            targetPrice := entryPrice - fixedTPPoints
    else
        if direction == 1
            stopPrice := lvnLow - lvnBoundaryBuffer
            float risk = entryPrice - stopPrice
            if risk > syminfo.mintick
                targetPrice := entryPrice + risk * rrMultiple
        else
            stopPrice := lvnHigh + lvnBoundaryBuffer
            float risk = stopPrice - entryPrice
            if risk > syminfo.mintick
                targetPrice := entryPrice - risk * rrMultiple

    [stopPrice, targetPrice]

f_trade_levels_valid(int direction, float entryPrice, float stopPrice, float targetPrice) =>
    float riskDistance = not na(stopPrice) ? math.abs(entryPrice - stopPrice) : na
    direction == 1 ? (not na(stopPrice) and not na(targetPrice) and not na(riskDistance) and riskDistance > syminfo.mintick and stopPrice < entryPrice and targetPrice > entryPrice) : (not na(stopPrice) and not na(targetPrice) and not na(riskDistance) and riskDistance > syminfo.mintick and stopPrice > entryPrice and targetPrice < entryPrice)

int sessionStamp = time(timeframe.period, profileSession, sessionTimezone)
int entrySessionStamp = time(timeframe.period, entrySessionFilter, sessionTimezone)
bool timeframeOk = timeframe.isintraday
bool withinDateRange = time >= startDate and time <= endDate
bool inProfileSession = not na(sessionStamp)
bool inEntrySession = not useEntrySessionFilter or not na(entrySessionStamp)
int sessionCloseTimestamp = f_session_close_timestamp()
int minutesToSessionEnd = inProfileSession ? int(math.floor((sessionCloseTimestamp - time_close) / 60000)) : na
bool entryCutoffActive = blockNewEntriesBeforeSessionEnd and inProfileSession and not na(minutesToSessionEnd) and minutesToSessionEnd <= entryCutoffMinutes
bool priorInSession = bar_index > 0 ? not na(sessionStamp[1]) : false
bool isNewProfileSession = inProfileSession and not priorInSession
bool isSessionJustEnded = not inProfileSession and priorInSession

if isNewProfileSession
    f_cancel_all_entry_orders()
    anyTradeTakenThisSession := false
    f_reset_usage_flags(lvnUsedThisSession, array.size(tradableCenters))
    if strategy.position_size == 0
        activeTradeLvnIndex := -1
    buildSessionActive := true
    skipCurrentBuild := false
    buildSessionHigh := na
    buildSessionLow := na
    buildSessionVolume := 0.0
    buildSessionHasPositiveVolume := false
    buildSessionStartTime := na
    buildSessionEndTime := na
    buildLastIncludedBarTime := na
    buildFirstIncludedBarIndex := na
    buildLastIncludedBarIndex := na
    f_clear_build_profile_buffers()
    f_reset_bool_flags(pendingLongOrders, array.size(tradableCenters))
    f_reset_bool_flags(pendingShortOrders, array.size(tradableCenters))
    frozenProfileAnchorBarIndex := array.size(profileVolumes) > 0 ? bar_index : na
    if not na(frozenProfileAnchorBarIndex)
        [drawnRowCount, drawnNonzeroRowCount, histogramLeftEdge, histogramRightEdge] = f_draw_frozen_profile_histogram(frozenProfileAnchorBarIndex, frozenFirstIncludedBarIndex, frozenLastIncludedBarIndex)
        frozenRenderedRowCount := drawnRowCount
        frozenRenderedNonzeroRowCount := drawnNonzeroRowCount
        frozenHistogramLeftEdge := histogramLeftEdge
        frozenHistogramRightEdge := histogramRightEdge
    else
        f_clear_box_array(profileBoxes)
        frozenRenderedRowCount := 0
        frozenRenderedNonzeroRowCount := 0
        frozenHistogramLeftEdge := na
        frozenHistogramRightEdge := na
else if inProfileSession and not buildSessionActive
    f_cancel_all_entry_orders()
    anyTradeTakenThisSession := false
    f_reset_usage_flags(lvnUsedThisSession, array.size(tradableCenters))
    buildSessionActive := true
    skipCurrentBuild := true
    buildSessionHigh := na
    buildSessionLow := na
    buildSessionVolume := 0.0
    buildSessionHasPositiveVolume := false
    buildSessionStartTime := na
    buildSessionEndTime := na
    buildLastIncludedBarTime := na
    buildFirstIncludedBarIndex := na
    buildLastIncludedBarIndex := na
    f_clear_build_profile_buffers()
    f_reset_bool_flags(pendingLongOrders, array.size(tradableCenters))
    f_reset_bool_flags(pendingShortOrders, array.size(tradableCenters))
    frozenProfileAnchorBarIndex := na
    f_clear_box_array(profileBoxes)
    frozenRenderedRowCount := 0
    frozenRenderedNonzeroRowCount := 0
    frozenHistogramLeftEdge := na
    frozenHistogramRightEdge := na
    dataWarning := "Initial history started mid-session. The first detected profile is skipped to avoid freezing a partial session."

if inProfileSession and buildSessionActive
    float safeVolume = na(volume) ? 0.0 : volume
    // Bars are collected by session membership at their open time. On M1 this includes the 18:00
    // bar and the 15:59 bar, while excluding the 16:00 bar that opens after the session closes.
    array.push(sessionBarHighs, high)
    array.push(sessionBarLows, low)
    array.push(sessionBarVolumes, safeVolume)
    buildSessionStartTime := na(buildSessionStartTime) ? time : buildSessionStartTime
    buildLastIncludedBarTime := time
    buildFirstIncludedBarIndex := na(buildFirstIncludedBarIndex) ? bar_index : buildFirstIncludedBarIndex
    buildLastIncludedBarIndex := bar_index
    buildSessionEndTime := time_close
    buildSessionHigh := na(buildSessionHigh) ? high : math.max(buildSessionHigh, high)
    buildSessionLow := na(buildSessionLow) ? low : math.min(buildSessionLow, low)
    buildSessionVolume += safeVolume
    buildSessionHasPositiveVolume := buildSessionHasPositiveVolume or safeVolume > 0

if isSessionJustEnded
    f_cancel_all_entry_orders()

    if closePositionsAtSessionEnd and strategy.position_size != 0
        strategy.close_all(comment = "Session End")

    if buildSessionActive and not skipCurrentBuild and buildSessionHasPositiveVolume
        [validProfile, rowHeight, totalVolume, pocIndex, pocVol] = f_build_profile(sessionBarHighs, sessionBarLows, sessionBarVolumes, buildSessionHigh, buildSessionLow, profileRows, profileVolumes, profileRowLows, profileRowHighs)

        if validProfile and totalVolume > 0 and pocIndex >= 0
            float sourceSessionHigh = f_array_max(sessionBarHighs)
            float sourceSessionLow = f_array_min(sessionBarLows)
            frozenSessionHigh := buildSessionHigh
            frozenSessionLow := buildSessionLow
            frozenRowHeight := rowHeight
            frozenProfileRange := buildSessionHigh - buildSessionLow
            previousPocVolume := pocVol
            previousPocRow := pocIndex
            previousPocPrice := (array.get(profileRowLows, pocIndex) + array.get(profileRowHighs, pocIndex)) * 0.5
            frozenSourceSessionVolume := totalVolume
            frozenSessionStartTime := buildSessionStartTime
            frozenSessionEndTime := buildSessionEndTime
            frozenFirstIncludedBarTime := buildSessionStartTime
            frozenLastIncludedBarTime := buildLastIncludedBarTime
            frozenFirstIncludedBarIndex := buildFirstIncludedBarIndex
            frozenLastIncludedBarIndex := buildLastIncludedBarIndex
            frozenSourceBarCount := array.size(sessionBarHighs)
            frozenMaxRowVolume := pocVol
            frozenProfileVolumeSum := array.size(profileVolumes) > 0 ? f_sum_volume(profileVolumes, 0, array.size(profileVolumes) - 1) : na
            frozenVolumeConservationErrorPct := not na(frozenSourceSessionVolume) and frozenSourceSessionVolume > 0 and not na(frozenProfileVolumeSum) ? math.abs(frozenProfileVolumeSum - frozenSourceSessionVolume) / frozenSourceSessionVolume * 100.0 : na
            frozenExpectedBottomRowLow := array.size(profileRowLows) > 0 ? array.get(profileRowLows, 0) : na
            frozenExpectedTopRowHigh := array.size(profileRowHighs) > 0 ? array.get(profileRowHighs, array.size(profileRowHighs) - 1) : na
            frozenProfileBoundaryPass := f_values_close(frozenExpectedBottomRowLow, frozenSessionLow) and f_values_close(frozenExpectedTopRowHigh, frozenSessionHigh)
            frozenRowCoveragePass := f_row_coverage_pass(profileRowLows, profileRowHighs, frozenSessionLow, frozenSessionHigh)
            frozenSourceHighMatchPass := f_values_close(sourceSessionHigh, frozenSessionHigh)
            frozenSourceLowMatchPass := f_values_close(sourceSessionLow, frozenSessionLow)
            frozenHistogramVerticalRangePass := frozenProfileBoundaryPass
            frozenSourceSessionAppearsIncomplete := timeframe.period == "1" and frozenSourceBarCount < 1188
            array<float> diagnosticProfileVolumeSnapshot = array.copy(profileVolumes)
            array<float> detectorVolumes = array.copy(profileVolumes)
            array<float> detectorRowLows = array.copy(profileRowLows)
            array<float> detectorRowHighs = array.copy(profileRowHighs)
            [snapshotSize, snapshotNumericCount, snapshotPositiveCount, snapshotMin, snapshotMax, snapshotSum] = f_collect_volume_stats(diagnosticProfileVolumeSnapshot)
            frozenPreDetectorProfileVolumeSize := snapshotSize
            frozenPreDetectorProfileVolumeSum := snapshotSum
            frozenPreDetectorProfileVolumeMin := snapshotMin
            frozenPreDetectorProfileVolumeMax := snapshotMax
            int preparedCount = 0
            int prepareEntryVolumesSize = 0
            int prepareEntryRowLowsSize = 0
            int prepareEntryRowHighsSize = 0
            int prepareEntryNumericCount = 0
            int prepareEntryPositiveCount = 0
            float prepareEntryVolumesSum = na
            float prepareEntryVolumesMin = na
            float prepareEntryVolumesMax = na
            int prepareAfterClearVolumesSize = 0
            int prepareAfterClearRowLowsSize = 0
            int prepareAfterClearRowHighsSize = 0
            int prepareAfterClearNumericCount = 0
            int prepareAfterClearPositiveCount = 0
            float prepareAfterClearVolumesSum = na
            float prepareAfterClearVolumesMin = na
            float prepareAfterClearVolumesMax = na
            int localThresholdCandidates = 0
            int mergedLowVolumeRegions = 0
            int finalQualifyingLvns = 0
            int sourceVolumesSize = 0
            int sourceRowLowsSize = 0
            int sourceRowHighsSize = 0
            int sourceVolumesNumericCount = 0
            int sourceVolumesPositiveCount = 0
            float sourceVolumesMin = na
            float sourceVolumesMax = na
            float sourceVolumesSum = na
            int evaluableInteriorRows = 0
            int rowsWithValidSurroundingAverage = 0
            float bestRawRowDepthRatio = na
            float minimumRawDepthRatioAcrossAllValidInteriorRows = na
            float bestMergedRegionDepthRatio = na
            float bestMergedRegionSurroundingAvg = na
            bool bestLowerHvnFound = false
            bool bestUpperHvnFound = false
            int distanceToLowerHvn = na
            int distanceToUpperHvn = na
            bool bestMergedRegionBoundaryPass = false
            bool bestMergedRegionContrastPass = false
            bool bestMergedRegionThresholdPass = false
            string fixedProbeText = ""
            string pocProbeText = ""
            string bestMergedRegionReason = ""

            if lvnMethod == "Client Threshold Valley"
                [prepareEntryVolumesSize, prepareEntryNumericCount, prepareEntryPositiveCount, prepareEntryVolumesMin, prepareEntryVolumesMax, prepareEntryVolumesSum] = f_collect_volume_stats(detectorVolumes)
                prepareEntryRowLowsSize := array.size(detectorRowLows)
                prepareEntryRowHighsSize := array.size(detectorRowHighs)

                f_clear_tradable_lvns()

                [prepareAfterClearVolumesSize, prepareAfterClearNumericCount, prepareAfterClearPositiveCount, prepareAfterClearVolumesMin, prepareAfterClearVolumesMax, prepareAfterClearVolumesSum] = f_collect_volume_stats(detectorVolumes)
                prepareAfterClearRowLowsSize := array.size(detectorRowLows)
                prepareAfterClearRowHighsSize := array.size(detectorRowHighs)

                array<int> candidateStartRows = array.new_int()
                array<int> candidateEndRows = array.new_int()
                array<float> candidateLows = array.new_float()
                array<float> candidateHighs = array.new_float()
                array<float> candidateCenters = array.new_float()
                array<float> candidateAvgVolumes = array.new_float()
                array<float> candidateTotalVolumes = array.new_float()
                array<float> candidateSurroundAvgs = array.new_float()
                array<float> candidateAvgAbove = array.new_float()
                array<float> candidateAvgBelow = array.new_float()
                array<float> candidateDepthRatios = array.new_float()
                array<float> candidateContrastRatios = array.new_float()
                array<int> candidateWidths = array.new_int()

                [localThresholdCandidates, mergedLowVolumeRegions, finalQualifyingLvns, sourceVolumesSize, sourceRowLowsSize, sourceRowHighsSize, sourceVolumesNumericCount, sourceVolumesPositiveCount, sourceVolumesMin, sourceVolumesMax, sourceVolumesSum, evaluableInteriorRows, rowsWithValidSurroundingAverage, bestRawRowDepthRatio, minimumRawDepthRatioAcrossAllValidInteriorRows, bestMergedRegionDepthRatio, bestMergedRegionSurroundingAvg, bestLowerHvnFound, bestUpperHvnFound, distanceToLowerHvn, distanceToUpperHvn, bestMergedRegionBoundaryPass, bestMergedRegionContrastPass, bestMergedRegionThresholdPass, fixedProbeText, pocProbeText, bestMergedRegionReason] = f_detect_client_threshold_candidates(detectorVolumes, detectorRowLows, detectorRowHighs, pocIndex, candidateStartRows, candidateEndRows, candidateLows, candidateHighs, candidateCenters, candidateAvgVolumes, candidateTotalVolumes, candidateSurroundAvgs, candidateAvgAbove, candidateAvgBelow, candidateDepthRatios, candidateContrastRatios, candidateWidths)
                preparedCount := f_rank_and_store_tradable_lvns(candidateStartRows, candidateEndRows, candidateLows, candidateHighs, candidateCenters, candidateAvgVolumes, candidateTotalVolumes, candidateSurroundAvgs, candidateAvgAbove, candidateAvgBelow, candidateDepthRatios, candidateContrastRatios, candidateWidths)
            else
                [preparedCount, prepareEntryVolumesSize, prepareEntryRowLowsSize, prepareEntryRowHighsSize, prepareEntryVolumesSum, prepareEntryVolumesMin, prepareEntryVolumesMax, prepareAfterClearVolumesSize, prepareAfterClearRowLowsSize, prepareAfterClearRowHighsSize, prepareAfterClearVolumesSum, prepareAfterClearVolumesMin, prepareAfterClearVolumesMax, localThresholdCandidates, mergedLowVolumeRegions, finalQualifyingLvns, sourceVolumesSize, sourceRowLowsSize, sourceRowHighsSize, sourceVolumesNumericCount, sourceVolumesPositiveCount, sourceVolumesMin, sourceVolumesMax, sourceVolumesSum, evaluableInteriorRows, rowsWithValidSurroundingAverage, bestRawRowDepthRatio, minimumRawDepthRatioAcrossAllValidInteriorRows, bestMergedRegionDepthRatio, bestMergedRegionSurroundingAvg, bestLowerHvnFound, bestUpperHvnFound, distanceToLowerHvn, distanceToUpperHvn, bestMergedRegionBoundaryPass, bestMergedRegionContrastPass, bestMergedRegionThresholdPass, fixedProbeText, pocProbeText, bestMergedRegionReason] = f_prepare_tradable_lvns(detectorVolumes, detectorRowLows, detectorRowHighs, pocIndex, pocVol)
            frozenPrepareEntryVolumesSize := prepareEntryVolumesSize
            frozenPrepareEntryRowLowsSize := prepareEntryRowLowsSize
            frozenPrepareEntryRowHighsSize := prepareEntryRowHighsSize
            frozenPrepareEntryVolumesSum := prepareEntryVolumesSum
            frozenPrepareEntryVolumesMin := prepareEntryVolumesMin
            frozenPrepareEntryVolumesMax := prepareEntryVolumesMax
            frozenPrepareAfterClearVolumesSize := prepareAfterClearVolumesSize
            frozenPrepareAfterClearRowLowsSize := prepareAfterClearRowLowsSize
            frozenPrepareAfterClearRowHighsSize := prepareAfterClearRowHighsSize
            frozenPrepareAfterClearVolumesSum := prepareAfterClearVolumesSum
            frozenPrepareAfterClearVolumesMin := prepareAfterClearVolumesMin
            frozenPrepareAfterClearVolumesMax := prepareAfterClearVolumesMax
            frozenLocalThresholdCandidates := localThresholdCandidates
            frozenMergedLowVolumeRegions := mergedLowVolumeRegions
            frozenFinalQualifyingLvns := finalQualifyingLvns
            frozenDetectorEntrySourceVolumesSize := sourceVolumesSize
            frozenDetectorEntrySourceRowLowsSize := sourceRowLowsSize
            frozenDetectorEntrySourceRowHighsSize := sourceRowHighsSize
            frozenDetectorEntryNumericSourceVolumes := sourceVolumesNumericCount
            frozenDetectorEntryPositiveSourceVolumes := sourceVolumesPositiveCount
            frozenDetectorEntryMinSourceVolume := sourceVolumesMin
            frozenDetectorEntryMaxSourceVolume := sourceVolumesMax
            frozenDetectorEntrySumSourceVolume := sourceVolumesSum
            frozenDetectorSnapshotMatch := snapshotSize == sourceVolumesSize and f_values_close(snapshotMin, sourceVolumesMin) and f_values_close(snapshotMax, sourceVolumesMax) and f_values_close(snapshotSum, sourceVolumesSum)
            frozenEvaluableInteriorRows := evaluableInteriorRows
            frozenRowsWithValidSurroundingAverage := rowsWithValidSurroundingAverage
            frozenBestRawRowDepthRatio := bestRawRowDepthRatio
            frozenMinimumRawDepthRatioAcrossAllValidInteriorRows := minimumRawDepthRatioAcrossAllValidInteriorRows
            frozenBestMergedRegionDepthRatio := bestMergedRegionDepthRatio
            frozenBestMergedRegionSurroundingAvg := bestMergedRegionSurroundingAvg
            frozenBestLowerHvnFound := bestLowerHvnFound
            frozenBestUpperHvnFound := bestUpperHvnFound
            frozenDistanceToLowerHvn := distanceToLowerHvn
            frozenDistanceToUpperHvn := distanceToUpperHvn
            frozenBestMergedRegionBoundaryPass := bestMergedRegionBoundaryPass
            frozenBestMergedRegionContrastPass := bestMergedRegionContrastPass
            frozenBestMergedRegionThresholdPass := bestMergedRegionThresholdPass
            frozenDetectorProbeFixedText := fixedProbeText
            frozenDetectorProbePocText := pocProbeText
            frozenBestMergedRegionReason := bestMergedRegionReason
            tradableProfileReady := preparedCount > 0
            f_reset_usage_flags(lvnUsedThisSession, preparedCount)
            f_reset_bool_flags(pendingLongOrders, preparedCount)
            f_reset_bool_flags(pendingShortOrders, preparedCount)
            frozenProfileAnchorBarIndex := na
            dataWarning := preparedCount > 0 ? "" : f_is_detector_input_error(bestMergedRegionReason) ? bestMergedRegionReason : "Profile completed, but no LVNs passed the current detection settings."
        else
            f_clear_frozen_profile_buffers()
            f_reset_usage_flags(lvnUsedThisSession, 0)
            f_reset_bool_flags(pendingLongOrders, 0)
            f_reset_bool_flags(pendingShortOrders, 0)
            tradableProfileReady := false
            frozenSessionHigh := na
            frozenSessionLow := na
            frozenRowHeight := na
            frozenProfileRange := na
            previousPocPrice := na
            previousPocRow := na
            previousPocVolume := na
            frozenSourceSessionVolume := na
            frozenProfileVolumeSum := na
            frozenVolumeConservationErrorPct := na
            frozenMaxRowVolume := na
            frozenRenderedRowCount := 0
            frozenRenderedNonzeroRowCount := 0
            frozenSessionStartTime := na
            frozenSessionEndTime := na
            frozenFirstIncludedBarTime := na
            frozenLastIncludedBarTime := na
            frozenFirstIncludedBarIndex := na
            frozenLastIncludedBarIndex := na
            frozenSourceBarCount := 0
            frozenHistogramLeftEdge := na
            frozenHistogramRightEdge := na
            frozenExpectedBottomRowLow := na
            frozenExpectedTopRowHigh := na
            frozenProfileBoundaryPass := false
            frozenRowCoveragePass := false
            frozenSourceHighMatchPass := false
            frozenSourceLowMatchPass := false
            frozenHistogramVerticalRangePass := false
            frozenSourceSessionAppearsIncomplete := false
            frozenLocalThresholdCandidates := 0
            frozenMergedLowVolumeRegions := 0
            frozenFinalQualifyingLvns := 0
            frozenPreDetectorProfileVolumeSize := 0
            frozenPreDetectorProfileVolumeSum := na
            frozenPreDetectorProfileVolumeMin := na
            frozenPreDetectorProfileVolumeMax := na
            frozenPrepareEntryVolumesSize := 0
            frozenPrepareEntryRowLowsSize := 0
            frozenPrepareEntryRowHighsSize := 0
            frozenPrepareEntryVolumesSum := na
            frozenPrepareEntryVolumesMin := na
            frozenPrepareEntryVolumesMax := na
            frozenPrepareAfterClearVolumesSize := 0
            frozenPrepareAfterClearRowLowsSize := 0
            frozenPrepareAfterClearRowHighsSize := 0
            frozenPrepareAfterClearVolumesSum := na
            frozenPrepareAfterClearVolumesMin := na
            frozenPrepareAfterClearVolumesMax := na
            frozenDetectorEntrySourceVolumesSize := 0
            frozenDetectorEntrySourceRowLowsSize := 0
            frozenDetectorEntrySourceRowHighsSize := 0
            frozenDetectorEntryNumericSourceVolumes := 0
            frozenDetectorEntryPositiveSourceVolumes := 0
            frozenDetectorEntryMinSourceVolume := na
            frozenDetectorEntryMaxSourceVolume := na
            frozenDetectorEntrySumSourceVolume := na
            frozenDetectorSnapshotMatch := false
            frozenEvaluableInteriorRows := 0
            frozenRowsWithValidSurroundingAverage := 0
            frozenBestRawRowDepthRatio := na
            frozenMinimumRawDepthRatioAcrossAllValidInteriorRows := na
            frozenBestMergedRegionDepthRatio := na
            frozenBestMergedRegionSurroundingAvg := na
            frozenBestLowerHvnFound := false
            frozenBestUpperHvnFound := false
            frozenDistanceToLowerHvn := na
            frozenDistanceToUpperHvn := na
            frozenBestMergedRegionBoundaryPass := false
            frozenBestMergedRegionContrastPass := false
            frozenBestMergedRegionThresholdPass := false
            frozenDetectorProbeFixedText := ""
            frozenDetectorProbePocText := ""
            frozenBestMergedRegionReason := ""
            frozenProfileAnchorBarIndex := na
            dataWarning := "Skipped profile because the session range or allocated volume was invalid."
    else
        f_clear_frozen_profile_buffers()
        f_reset_usage_flags(lvnUsedThisSession, 0)
        f_reset_bool_flags(pendingLongOrders, 0)
        f_reset_bool_flags(pendingShortOrders, 0)
        tradableProfileReady := false
        frozenSessionHigh := na
        frozenSessionLow := na
        frozenRowHeight := na
        frozenProfileRange := na
        previousPocPrice := na
        previousPocRow := na
        previousPocVolume := na
        frozenSourceSessionVolume := na
        frozenProfileVolumeSum := na
        frozenVolumeConservationErrorPct := na
        frozenMaxRowVolume := na
        frozenRenderedRowCount := 0
        frozenRenderedNonzeroRowCount := 0
        frozenSessionStartTime := na
        frozenSessionEndTime := na
        frozenFirstIncludedBarTime := na
        frozenLastIncludedBarTime := na
        frozenFirstIncludedBarIndex := na
        frozenLastIncludedBarIndex := na
        frozenSourceBarCount := 0
        frozenHistogramLeftEdge := na
        frozenHistogramRightEdge := na
        frozenExpectedBottomRowLow := na
        frozenExpectedTopRowHigh := na
        frozenProfileBoundaryPass := false
        frozenRowCoveragePass := false
        frozenSourceHighMatchPass := false
        frozenSourceLowMatchPass := false
        frozenHistogramVerticalRangePass := false
        frozenSourceSessionAppearsIncomplete := false
        frozenLocalThresholdCandidates := 0
        frozenMergedLowVolumeRegions := 0
        frozenFinalQualifyingLvns := 0
        frozenPreDetectorProfileVolumeSize := 0
        frozenPreDetectorProfileVolumeSum := na
        frozenPreDetectorProfileVolumeMin := na
        frozenPreDetectorProfileVolumeMax := na
        frozenPrepareEntryVolumesSize := 0
        frozenPrepareEntryRowLowsSize := 0
        frozenPrepareEntryRowHighsSize := 0
        frozenPrepareEntryVolumesSum := na
        frozenPrepareEntryVolumesMin := na
        frozenPrepareEntryVolumesMax := na
        frozenPrepareAfterClearVolumesSize := 0
        frozenPrepareAfterClearRowLowsSize := 0
        frozenPrepareAfterClearRowHighsSize := 0
        frozenPrepareAfterClearVolumesSum := na
        frozenPrepareAfterClearVolumesMin := na
        frozenPrepareAfterClearVolumesMax := na
        frozenDetectorEntrySourceVolumesSize := 0
        frozenDetectorEntrySourceRowLowsSize := 0
        frozenDetectorEntrySourceRowHighsSize := 0
        frozenDetectorEntryNumericSourceVolumes := 0
        frozenDetectorEntryPositiveSourceVolumes := 0
        frozenDetectorEntryMinSourceVolume := na
        frozenDetectorEntryMaxSourceVolume := na
        frozenDetectorEntrySumSourceVolume := na
        frozenDetectorSnapshotMatch := false
        frozenEvaluableInteriorRows := 0
        frozenRowsWithValidSurroundingAverage := 0
        frozenBestRawRowDepthRatio := na
        frozenMinimumRawDepthRatioAcrossAllValidInteriorRows := na
        frozenBestMergedRegionDepthRatio := na
        frozenBestMergedRegionSurroundingAvg := na
        frozenBestLowerHvnFound := false
        frozenBestUpperHvnFound := false
        frozenDistanceToLowerHvn := na
        frozenDistanceToUpperHvn := na
        frozenBestMergedRegionBoundaryPass := false
        frozenBestMergedRegionContrastPass := false
        frozenBestMergedRegionThresholdPass := false
        frozenDetectorProbeFixedText := ""
        frozenDetectorProbePocText := ""
        frozenBestMergedRegionReason := ""
        frozenProfileAnchorBarIndex := na
        dataWarning := skipCurrentBuild ? "Skipped an incomplete profile because the chart history started inside the session." : "Skipped profile because no usable volume was available."

    buildSessionActive := false
    skipCurrentBuild := false

bool newLongPosition = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0
bool newPositionOpened = (newLongPosition or newShortPosition) and strategy.opentrades > 0
bool positionClosed = strategy.position_size == 0 and strategy.position_size[1] != 0

if newPositionOpened
    activeEntryId := strategy.opentrades.entry_id(strategy.opentrades - 1)
    activeTradeDirection := strategy.position_size > 0 ? 1 : -1
    activeTradeLvnIndex := -1

    if array.size(tradableCenters) > 0
        for i = 0 to array.size(tradableCenters) - 1
            int rank = i + 1
            if activeEntryId == f_long_entry_id(rank) or activeEntryId == f_short_entry_id(rank)
                activeTradeLvnIndex := i
                if lvnFreshnessMode != "Allow Repeated Trades" and i < array.size(lvnUsedThisSession)
                    array.set(lvnUsedThisSession, i, true)
                anyTradeTakenThisSession := true
                break

    f_cancel_all_entry_orders()
    f_reset_bool_flags(pendingLongOrders, 0)
    f_reset_bool_flags(pendingShortOrders, 0)

if positionClosed
    if activeEntryId != ""
        strategy.cancel(f_exit_id(activeEntryId))
    activeTradeLvnIndex := -1
    activeTradeDirection := 0
    activeEntryId := ""
    activeStopPrice := na
    activeTargetPrice := na

bool canSubmitNewEntries = timeframeOk and withinDateRange and inProfileSession and inEntrySession and not entryCutoffActive and tradableProfileReady and strategy.position_size == 0
float referencePrice = bar_index > 0 ? close[1] : close

if canSubmitNewEntries and array.size(tradableCenters) > 0
    array<bool> nextPendingLongOrders = array.new_bool()
    array<bool> nextPendingShortOrders = array.new_bool()

    for i = 0 to array.size(tradableCenters) - 1
        int rank = i + 1
        float levelCenter = array.get(tradableCenters, i)
        float levelLow = array.get(tradableLows, i)
        float levelHigh = array.get(tradableHighs, i)
        float depthRatio = array.get(tradableDepthRatios, i)
        float contrastRatio = array.get(tradableContrastRatios, i)

        bool rankEnabled = f_is_rank_enabled(rank)
        bool alreadyUsed = i < array.size(lvnUsedThisSession) ? array.get(lvnUsedThisSession, i) : false
        bool hadPendingLongOrder = i < array.size(pendingLongOrders) ? array.get(pendingLongOrders, i) : false
        bool hadPendingShortOrder = i < array.size(pendingShortOrders) ? array.get(pendingShortOrders, i) : false
        bool tradeAllowedForRank = lvnFreshnessMode == "Allow Repeated Trades" or not alreadyUsed

        float longEntryPrice = f_lvn_entry_price(1, levelLow, levelHigh)
        float shortEntryPrice = f_lvn_entry_price(-1, levelLow, levelHigh)
        bool approachFromAbove = referencePrice > levelHigh + minimumApproachDistance
        bool approachFromBelow = referencePrice < levelLow - minimumApproachDistance
        bool pocContextOk = f_poc_context_ok(levelCenter)
        bool longTouchedWithActiveOrder = hadPendingLongOrder and f_zone_touched(1, longEntryPrice)
        bool shortTouchedWithActiveOrder = hadPendingShortOrder and f_zone_touched(-1, shortEntryPrice)
        bool consumedThisBar = false

        [projectedLongStop, projectedLongTarget] = f_get_trade_levels(1, longEntryPrice, levelLow, levelHigh)
        [projectedShortStop, projectedShortTarget] = f_get_trade_levels(-1, shortEntryPrice, levelLow, levelHigh)
        bool longRiskOk = tradeLongs and f_trade_levels_valid(1, longEntryPrice, projectedLongStop, projectedLongTarget)
        bool shortRiskOk = tradeShorts and f_trade_levels_valid(-1, shortEntryPrice, projectedShortStop, projectedShortTarget)
        string depthComment = str.tostring(depthRatio * 100.0, "#")
        string contrastComment = str.tostring(contrastRatio, "#.#")

        if rankEnabled and tradeAllowedForRank and pocContextOk and approachFromAbove and longRiskOk
            strategy.entry(f_long_entry_id(rank), strategy.long, qty = orderQty, limit = longEntryPrice, oca_name = ENTRY_OCA_GROUP, oca_type = strategy.oca.cancel, comment = "LVN" + str.tostring(rank) + "-L D" + depthComment + " C" + contrastComment)
            strategy.cancel(f_short_entry_id(rank))
            bool keepLongPending = true
            if lvnFreshnessMode == "First Touch Only" and longTouchedWithActiveOrder and i < array.size(lvnUsedThisSession)
                array.set(lvnUsedThisSession, i, true)
                consumedThisBar := true
                keepLongPending := false
            array.push(nextPendingLongOrders, keepLongPending and not consumedThisBar)
            array.push(nextPendingShortOrders, false)
        else if rankEnabled and tradeAllowedForRank and pocContextOk and approachFromBelow and shortRiskOk
            strategy.entry(f_short_entry_id(rank), strategy.short, qty = orderQty, limit = shortEntryPrice, oca_name = ENTRY_OCA_GROUP, oca_type = strategy.oca.cancel, comment = "LVN" + str.tostring(rank) + "-S D" + depthComment + " C" + contrastComment)
            strategy.cancel(f_long_entry_id(rank))
            bool keepShortPending = true
            if lvnFreshnessMode == "First Touch Only" and shortTouchedWithActiveOrder and i < array.size(lvnUsedThisSession)
                array.set(lvnUsedThisSession, i, true)
                consumedThisBar := true
                keepShortPending := false
            array.push(nextPendingLongOrders, false)
            array.push(nextPendingShortOrders, keepShortPending and not consumedThisBar)
        else
            f_cancel_rank_orders(rank)
            array.push(nextPendingLongOrders, false)
            array.push(nextPendingShortOrders, false)

    array.clear(pendingLongOrders)
    array.clear(pendingShortOrders)
    for i = 0 to array.size(nextPendingLongOrders) - 1
        array.push(pendingLongOrders, array.get(nextPendingLongOrders, i))
        array.push(pendingShortOrders, array.get(nextPendingShortOrders, i))
else
    f_cancel_all_entry_orders()
    f_reset_bool_flags(pendingLongOrders, 0)
    f_reset_bool_flags(pendingShortOrders, 0)

if strategy.position_size != 0 and activeTradeLvnIndex >= 0 and activeTradeLvnIndex < array.size(tradableCenters)
    float activeLvnLow = array.get(tradableLows, activeTradeLvnIndex)
    float activeLvnHigh = array.get(tradableHighs, activeTradeLvnIndex)
    [nextActiveStop, nextActiveTarget] = f_get_trade_levels(activeTradeDirection, strategy.position_avg_price, activeLvnLow, activeLvnHigh)
    activeStopPrice := nextActiveStop
    activeTargetPrice := nextActiveTarget

    if f_trade_levels_valid(activeTradeDirection, strategy.position_avg_price, activeStopPrice, activeTargetPrice)
        strategy.exit(f_exit_id(activeEntryId), from_entry = activeEntryId, stop = activeStopPrice, limit = activeTargetPrice, comment_profit = "TP", comment_loss = "SL")
    else
        strategy.close(activeEntryId, comment = "Invalid Risk")
else
    activeStopPrice := na
    activeTargetPrice := na

float lvnCenter1 = array.size(tradableCenters) > 0 ? array.get(tradableCenters, 0) : na
float lvnCenter2 = array.size(tradableCenters) > 1 ? array.get(tradableCenters, 1) : na
float lvnCenter3 = array.size(tradableCenters) > 2 ? array.get(tradableCenters, 2) : na
float lvnCenter4 = array.size(tradableCenters) > 3 ? array.get(tradableCenters, 3) : na
float lvnCenter5 = array.size(tradableCenters) > 4 ? array.get(tradableCenters, 4) : na
float lvnCenter6 = array.size(tradableCenters) > 5 ? array.get(tradableCenters, 5) : na
float lvnCenter7 = array.size(tradableCenters) > 6 ? array.get(tradableCenters, 6) : na
