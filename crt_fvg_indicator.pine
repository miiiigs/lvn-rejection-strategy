//@version=6
indicator(
    "Candle Range Theory + FVG Indicator",
    overlay = true,
    max_boxes_count = 300,
    max_lines_count = 500,
    max_labels_count = 300
)

string GROUP_STREAMS = "CRT Streams"
string GROUP_FILTERS = "Filters"
string GROUP_SMA = "4H SMA Filter"
string GROUP_SESSION = "Trading Day Session"
string GROUP_LIFECYCLE = "Range Lifecycle"
string GROUP_FVG = "FVG"
string GROUP_FVG_STYLE = "FVG Style"
string GROUP_STYLE = "Style"
string GROUP_DIAGNOSTICS = "Diagnostics"

string CRT_15M = "15"
string CRT_30M = "30"
string FVG_5M = "5"
string SMA_TF = "240"
int SMA_LENGTH = 200
int DIRECTION_BULLISH = 1
int DIRECTION_BEARISH = -1
int FVG_STREAM_1M = 1
int FVG_STREAM_5M = 5
int MILLISECONDS_PER_MINUTE = 60 * 1000
string FVG_DISPLAY_FIRST = "First FVG per CRT"
string FVG_DISPLAY_MOST_RECENT = "Most Recent FVG per CRT"
string FVG_DISPLAY_ALL = "All Qualifying FVGs"

string COMPLETION_AUTO = "Auto: History Keep / Live Hide"
string COMPLETION_KEEP = "Always Keep"
string COMPLETION_HIDE = "Always Hide"

string SESSION_TZ_NY = "America/New_York"
string SESSION_TZ_CHICAGO = "America/Chicago"
string SESSION_TZ_EXCHANGE = "Exchange"
int SESSION_START_HOUR = 18
int SESSION_END_HOUR = 17
int MILLISECONDS_PER_HOUR = 60 * 60 * 1000

bool enable15mCrt = input.bool(true, "Enable 15m CRT", group = GROUP_STREAMS)
bool enable30mCrt = input.bool(true, "Enable 30m CRT", group = GROUP_STREAMS)

bool enableMinimumRangeFilter = input.bool(false, "Enable Minimum Range Filter", group = GROUP_FILTERS)
float minimumRange = input.float(0.0, "Minimum Range", minval = 0.0, step = 0.25, group = GROUP_FILTERS)
string rangeUnit = input.string("Price", "Range Unit", options = ["Price", "Ticks"], group = GROUP_FILTERS)

string sessionTimezoneChoice = input.string(
    SESSION_TZ_NY,
    "Session Timezone",
    options = [SESSION_TZ_NY, SESSION_TZ_CHICAGO, SESSION_TZ_EXCHANGE],
    tooltip = "Client trading day is 18:00 through 16:59. New York is the current default pending final timezone confirmation. Exchange uses the symbol's exchange timezone.",
    group = GROUP_SESSION
)
string sessionTimezone = sessionTimezoneChoice == SESSION_TZ_EXCHANGE ? syminfo.timezone : sessionTimezoneChoice
bool showSessionExpiryLabels = input.bool(false, "Mark Session-Expired Historical Ranges", tooltip = "Optional visual marker only. Historical ranges already stop at the 17:00 session boundary.", group = GROUP_SESSION)

bool show4h200Sma = input.bool(true, "Show 4H 200 SMA", group = GROUP_SMA)

string completedRangeBehavior = input.string(
    COMPLETION_AUTO,
    "Completed Range Behavior",
    options = [COMPLETION_AUTO, COMPLETION_KEEP, COMPLETION_HIDE],
    tooltip = "All CRTs are session-scoped to 18:00-16:59. Auto keeps target-hit ranges through the remainder of a historical session for backtesting, but hides them immediately when hit live. Always Keep retains target-hit ranges until session end. Always Hide removes target-hit ranges immediately everywhere.",
    group = GROUP_LIFECYCLE
)
int maximumStoredCrtRanges = input.int(40, "Maximum Stored CRT Ranges", minval = 1, maxval = 120, group = GROUP_LIFECYCLE)

bool showCrtLabels = input.bool(true, "Show CRT Labels", group = GROUP_STYLE)
bool dimCompletedRanges = input.bool(true, "Dim Completed Historical Ranges", tooltip = "When completed ranges are retained, make them visually lighter and append HIT to their label.", group = GROUP_STYLE)
int activeFillTransparency = input.int(90, "Active Range Fill Transparency", minval = 0, maxval = 100, group = GROUP_STYLE)
int completedFillTransparency = input.int(96, "Completed Range Fill Transparency", minval = 0, maxval = 100, group = GROUP_STYLE)

color bullish15mColor = input.color(color.aqua, "15m Bullish Color", group = GROUP_STYLE)
color bearish15mColor = input.color(color.blue, "15m Bearish Color", group = GROUP_STYLE)
color bullish30mColor = input.color(color.fuchsia, "30m Bullish Color", group = GROUP_STYLE)
color bearish30mColor = input.color(color.purple, "30m Bearish Color", group = GROUP_STYLE)

bool enableFvgDetection = input.bool(true, "Enable FVG Detection", group = GROUP_FVG)
bool show1mFvg = input.bool(true, "Show 1m FVG", group = GROUP_FVG)
bool show5mFvg = input.bool(true, "Show 5m FVG", group = GROUP_FVG)
string fvgDisplayMode = input.string(FVG_DISPLAY_FIRST, "FVG Display Mode", options = [FVG_DISPLAY_FIRST, FVG_DISPLAY_MOST_RECENT, FVG_DISPLAY_ALL], group = GROUP_FVG)
bool showFvgComparisonTable = input.bool(true, "Show FVG Comparison Table", group = GROUP_FVG)
int maximumStoredFvgs = input.int(100, "Maximum Stored FVGs", minval = 1, maxval = 100, group = GROUP_FVG)

color bullishFvgColor = input.color(color.green, "Bullish FVG Color", group = GROUP_FVG_STYLE)
color bearishFvgColor = input.color(color.red, "Bearish FVG Color", group = GROUP_FVG_STYLE)
int fvg1mFillTransparency = input.int(90, "1m Fill Transparency", minval = 0, maxval = 100, group = GROUP_FVG_STYLE)
int fvg5mFillTransparency = input.int(82, "5m Fill Transparency", minval = 0, maxval = 100, group = GROUP_FVG_STYLE)
bool showFvgLabels = input.bool(false, "Show FVG Labels", group = GROUP_FVG_STYLE)

bool showUnsupportedWarnings = input.bool(true, "Show Unsupported Timeframe Warnings", group = GROUP_DIAGNOSTICS)

var array<int> crtStreamMinutes = array.new_int()
var array<int> crtDirections = array.new_int()
var array<float> crtRangeHighs = array.new_float()
var array<float> crtRangeLows = array.new_float()
var array<float> crtMidpoints = array.new_float()
var array<float> crtTargets = array.new_float()
var array<int> crtConfirmationTimes = array.new_int()
var array<int> crtRangeStartTimes = array.new_int()
var array<int> crtActivationBars = array.new_int()
var array<int> crtSessionKeys = array.new_int()
var array<bool> crtCompleted = array.new_bool()
var array<bool> crtExpired = array.new_bool()
var array<box> crtBoxes = array.new_box()
var array<line> crtHighLines = array.new_line()
var array<line> crtLowLines = array.new_line()
var array<line> crtMidLines = array.new_line()
var array<label> crtLabels = array.new_label()

var array<int> fvgStreamMinutes = array.new_int()
var array<int> fvgDirections = array.new_int()
var array<float> fvgZoneHighs = array.new_float()
var array<float> fvgZoneLows = array.new_float()
var array<int> fvgConfirmationTimes = array.new_int()
var array<int> fvgOwnerCrtConfirmationTimes = array.new_int()
var array<int> fvgOwnerCrtStreamMinutes = array.new_int()
var array<int> fvgSessionKeys = array.new_int()
var array<int> fvgActivationBars = array.new_int()
var array<bool> fvgCanFillOnActivationBar = array.new_bool()
var array<bool> fvgFilled = array.new_bool()
var array<bool> fvgExpired = array.new_bool()
var array<box> fvgBoxes = array.new_box()
var array<label> fvgLabels = array.new_label()

var array<int> metricCrtConfirmationTimes = array.new_int()
var array<int> metricCrtStreamMinutes = array.new_int()
var array<int> metricCrtDirections = array.new_int()
var array<int> metricCrtSessionKeys = array.new_int()
var array<bool> metricCrtHas1mFvg = array.new_bool()
var array<bool> metricCrtHas5mFvg = array.new_bool()
var array<bool> metricCrtDisplayedFirst1mFvg = array.new_bool()
var array<bool> metricCrtDisplayedFirst5mFvg = array.new_bool()

var array<int> qualifying1mFvgCount = array.new_int(1, 0)
var array<int> qualifying5mFvgCount = array.new_int(1, 0)
var array<int> covered1mCrtCount = array.new_int(1, 0)
var array<int> covered5mCrtCount = array.new_int(1, 0)
var array<float> first1mFvgDelayMinutesTotal = array.new_float(1, 0.0)
var array<float> first5mFvgDelayMinutesTotal = array.new_float(1, 0.0)

var label warningLabel = na
var table fvgComparisonTable = table.new(position.top_right, 3, 7, border_width = 1)

f_stream_name(int streamMinutes) =>
    str.tostring(streamMinutes) + "m"

f_is_in_client_session(int barTime) =>
    int localHour = hour(barTime, sessionTimezone)
    localHour >= SESSION_START_HOUR or localHour < SESSION_END_HOUR

f_session_key(int barTime) =>
    int key = -1
    if not na(barTime) and f_is_in_client_session(barTime)
        int localHour = hour(barTime, sessionTimezone)
        // Bars from midnight through 16:59 belong to the session that began the previous calendar day.
        // Subtracting 18 absolute hours is only used to obtain a stable previous local calendar date key.
        int anchorTime = localHour < SESSION_END_HOUR ? barTime - 18 * MILLISECONDS_PER_HOUR : barTime
        key := year(anchorTime, sessionTimezone) * 10000 + month(anchorTime, sessionTimezone) * 100 + dayofmonth(anchorTime, sessionTimezone)
    key

f_is_session_end_boundary(int boundaryTime) =>
    not na(boundaryTime) and hour(boundaryTime, sessionTimezone) == SESSION_END_HOUR and minute(boundaryTime, sessionTimezone) == 0

f_chart_supports_stream(string timeframeCode) =>
    // Only allow chart timeframes that divide the source timeframe evenly.
    // That keeps each 15m/30m confirmation aligned to a real chart-bar close.
    int chartSeconds = timeframe.in_seconds()
    int streamSeconds = timeframe.in_seconds(timeframeCode)
    timeframe.isintraday and chartSeconds <= streamSeconds and streamSeconds % chartSeconds == 0

f_crt_color(int streamMinutes, int direction) =>
    if streamMinutes == 15
        direction == DIRECTION_BULLISH ? bullish15mColor : bearish15mColor
    else
        direction == DIRECTION_BULLISH ? bullish30mColor : bearish30mColor

f_is_dual_sweep(float c1High, float c1Low, float c2High, float c2Low) =>
    c2High > c1High and c2Low < c1Low

f_passes_minimum_range_filter(float rangeHigh, float rangeLow) =>
    float rangeSize = rangeHigh - rangeLow
    float rangeTicks = syminfo.mintick > 0 ? rangeSize / syminfo.mintick : na
    not enableMinimumRangeFilter or (rangeUnit == "Price" ? rangeSize >= minimumRange : not na(rangeTicks) and rangeTicks >= minimumRange)

f_is_bullish_crt(float c1High, float c1Low, float c2High, float c2Low, float c2Close) =>
    not f_is_dual_sweep(c1High, c1Low, c2High, c2Low) and c2High <= c1High and c2Low < c1Low and c2Close > c1Low and c2Close < c1High

f_is_bearish_crt(float c1High, float c1Low, float c2High, float c2Low, float c2Close) =>
    not f_is_dual_sweep(c1High, c1Low, c2High, c2Low) and c2Low >= c1Low and c2High > c1High and c2Close < c1High and c2Close > c1Low

f_passes_sma_filter(int direction, float c2Close, float confirmedSma) =>
    not na(confirmedSma) and (direction == DIRECTION_BULLISH ? c2Close > confirmedSma : c2Close < confirmedSma)

f_set_crt_right_edge(int index, int rightTime) =>
    box crtBox = array.get(crtBoxes, index)
    line highLine = array.get(crtHighLines, index)
    line lowLine = array.get(crtLowLines, index)
    line midLine = array.get(crtMidLines, index)
    box.set_right(crtBox, rightTime)
    line.set_x2(highLine, rightTime)
    line.set_x2(lowLine, rightTime)
    line.set_x2(midLine, rightTime)

f_delete_crt_objects(int index) =>
    box crtBox = array.get(crtBoxes, index)
    line highLine = array.get(crtHighLines, index)
    line lowLine = array.get(crtLowLines, index)
    line midLine = array.get(crtMidLines, index)
    label crtLabel = array.get(crtLabels, index)
    box.delete(crtBox)
    line.delete(highLine)
    line.delete(lowLine)
    line.delete(midLine)
    if not na(crtLabel)
        label.delete(crtLabel)
    int deletedCount = 1
    deletedCount

f_remove_crt(int index) =>
    f_delete_crt_objects(index)
    array.remove(crtStreamMinutes, index)
    array.remove(crtDirections, index)
    array.remove(crtRangeHighs, index)
    array.remove(crtRangeLows, index)
    array.remove(crtMidpoints, index)
    array.remove(crtTargets, index)
    array.remove(crtConfirmationTimes, index)
    array.remove(crtRangeStartTimes, index)
    array.remove(crtActivationBars, index)
    array.remove(crtSessionKeys, index)
    array.remove(crtCompleted, index)
    array.remove(crtExpired, index)
    array.remove(crtBoxes, index)
    array.remove(crtHighLines, index)
    array.remove(crtLowLines, index)
    array.remove(crtMidLines, index)
    array.remove(crtLabels, index)
    int removedCount = 1
    removedCount

f_find_oldest_removal_index() =>
    int candidateIndex = -1
    if array.size(crtConfirmationTimes) > 0
        for index = 0 to array.size(crtConfirmationTimes) - 1
            if candidateIndex == -1
                candidateIndex := index
            else
                bool candidateCompleted = array.get(crtCompleted, candidateIndex)
                bool currentCompleted = array.get(crtCompleted, index)
                bool candidateExpired = array.get(crtExpired, candidateIndex)
                bool currentExpired = array.get(crtExpired, index)
                bool candidateInactive = candidateCompleted or candidateExpired
                bool currentInactive = currentCompleted or currentExpired
                int candidateTime = array.get(crtConfirmationTimes, candidateIndex)
                int currentTime = array.get(crtConfirmationTimes, index)
                bool currentIsOlder = currentTime < candidateTime
                bool preferCurrent = currentInactive and not candidateInactive
                if preferCurrent or (currentInactive == candidateInactive and currentIsOlder)
                    candidateIndex := index
    candidateIndex

f_enforce_storage_limit() =>
    int removedCount = 0

    while array.size(crtConfirmationTimes) > maximumStoredCrtRanges
        int removalIndex = f_find_oldest_removal_index()

        if removalIndex < 0
            break

        f_remove_crt(removalIndex)
        removedCount += 1

    removedCount

f_fvg_stream_name(int streamMinutes) =>
    str.tostring(streamMinutes) + "m"

f_show_fvg_stream(int streamMinutes) =>
    streamMinutes == FVG_STREAM_1M ? show1mFvg : show5mFvg

f_fvg_color(int streamMinutes, int direction) =>
    direction == DIRECTION_BULLISH ? bullishFvgColor : bearishFvgColor

f_fvg_fill_transparency(int streamMinutes) =>
    streamMinutes == FVG_STREAM_1M ? fvg1mFillTransparency : fvg5mFillTransparency

f_register_crt_metric(int streamMinutes, int direction, int confirmationTime, int sessionKey) =>
    array.push(metricCrtConfirmationTimes, confirmationTime)
    array.push(metricCrtStreamMinutes, streamMinutes)
    array.push(metricCrtDirections, direction)
    array.push(metricCrtSessionKeys, sessionKey)
    array.push(metricCrtHas1mFvg, false)
    array.push(metricCrtHas5mFvg, false)
    array.push(metricCrtDisplayedFirst1mFvg, false)
    array.push(metricCrtDisplayedFirst5mFvg, false)
    int registeredCount = 1
    registeredCount

f_find_metric_crt_index(int streamMinutes, int direction, int confirmationTime, int sessionKey) =>
    int metricIndex = -1
    if array.size(metricCrtConfirmationTimes) > 0
        for index = array.size(metricCrtConfirmationTimes) - 1 to 0
            bool sameStream = array.get(metricCrtStreamMinutes, index) == streamMinutes
            bool sameDirection = array.get(metricCrtDirections, index) == direction
            bool sameConfirmation = array.get(metricCrtConfirmationTimes, index) == confirmationTime
            bool sameSession = array.get(metricCrtSessionKeys, index) == sessionKey
            if sameStream and sameDirection and sameConfirmation and sameSession
                metricIndex := index
                break
    metricIndex

f_record_qualifying_fvg_metric(int fvgStreamMinutesValue, int crtStreamMinutesValue, int direction, int crtConfirmationTime, int sessionKey, int fvgConfirmationTime) =>
    int metricIndex = f_find_metric_crt_index(crtStreamMinutesValue, direction, crtConfirmationTime, sessionKey)
    if metricIndex >= 0
        float delayMinutes = float(fvgConfirmationTime - crtConfirmationTime) / MILLISECONDS_PER_MINUTE
        if fvgStreamMinutesValue == FVG_STREAM_1M
            array.set(qualifying1mFvgCount, 0, array.get(qualifying1mFvgCount, 0) + 1)
            if not array.get(metricCrtHas1mFvg, metricIndex)
                array.set(metricCrtHas1mFvg, metricIndex, true)
                array.set(covered1mCrtCount, 0, array.get(covered1mCrtCount, 0) + 1)
                array.set(first1mFvgDelayMinutesTotal, 0, array.get(first1mFvgDelayMinutesTotal, 0) + delayMinutes)
        else
            array.set(qualifying5mFvgCount, 0, array.get(qualifying5mFvgCount, 0) + 1)
            if not array.get(metricCrtHas5mFvg, metricIndex)
                array.set(metricCrtHas5mFvg, metricIndex, true)
                array.set(covered5mCrtCount, 0, array.get(covered5mCrtCount, 0) + 1)
                array.set(first5mFvgDelayMinutesTotal, 0, array.get(first5mFvgDelayMinutesTotal, 0) + delayMinutes)
    int recordedCount = metricIndex >= 0 ? 1 : 0
    recordedCount

f_has_displayed_first_fvg(int metricIndex, int streamMinutes) =>
    streamMinutes == FVG_STREAM_1M ? array.get(metricCrtDisplayedFirst1mFvg, metricIndex) : array.get(metricCrtDisplayedFirst5mFvg, metricIndex)

f_mark_displayed_first_fvg(int metricIndex, int streamMinutes) =>
    if streamMinutes == FVG_STREAM_1M
        array.set(metricCrtDisplayedFirst1mFvg, metricIndex, true)
    else
        array.set(metricCrtDisplayedFirst5mFvg, metricIndex, true)
    int markedCount = 1
    markedCount

f_is_bullish_fvg(float aHigh, float cLow) =>
    cLow > aHigh

f_is_bearish_fvg(float aLow, float cHigh) =>
    cHigh < aLow

f_find_owner_crt_index(int direction, int sessionKey, int fvgConfirmationTime) =>
    int ownerIndex = -1
    if array.size(crtConfirmationTimes) > 0
        for index = array.size(crtConfirmationTimes) - 1 to 0
            bool completed = array.get(crtCompleted, index)
            bool expired = array.get(crtExpired, index)
            int crtDirection = array.get(crtDirections, index)
            int crtSessionKey = array.get(crtSessionKeys, index)
            int crtConfirmationTime = array.get(crtConfirmationTimes, index)
            bool eligible = not completed and not expired and crtDirection == direction and crtSessionKey == sessionKey and crtConfirmationTime < fvgConfirmationTime
            if eligible
                ownerIndex := index
                break
    ownerIndex

f_set_fvg_right_edge(int index, int rightTime) =>
    box fvgBox = array.get(fvgBoxes, index)
    if not na(fvgBox)
        box.set_right(fvgBox, rightTime)
    int updatedCount = 1
    updatedCount

f_delete_fvg_objects(int index) =>
    box fvgBox = array.get(fvgBoxes, index)
    label fvgLabel = array.get(fvgLabels, index)
    if not na(fvgBox)
        box.delete(fvgBox)
    if not na(fvgLabel)
        label.delete(fvgLabel)
    int deletedCount = 1
    deletedCount

f_remove_fvg(int index) =>
    f_delete_fvg_objects(index)
    array.remove(fvgStreamMinutes, index)
    array.remove(fvgDirections, index)
    array.remove(fvgZoneHighs, index)
    array.remove(fvgZoneLows, index)
    array.remove(fvgConfirmationTimes, index)
    array.remove(fvgOwnerCrtConfirmationTimes, index)
    array.remove(fvgOwnerCrtStreamMinutes, index)
    array.remove(fvgSessionKeys, index)
    array.remove(fvgActivationBars, index)
    array.remove(fvgCanFillOnActivationBar, index)
    array.remove(fvgFilled, index)
    array.remove(fvgExpired, index)
    array.remove(fvgBoxes, index)
    array.remove(fvgLabels, index)
    int removedCount = 1
    removedCount

f_remove_displayed_fvgs_for_owner(int streamMinutes, int ownerCrtConfirmationTime, int ownerCrtStreamMinutes) =>
    int removedCount = 0
    if array.size(fvgConfirmationTimes) > 0
        for index = array.size(fvgConfirmationTimes) - 1 to 0
            bool sameFvgStream = array.get(fvgStreamMinutes, index) == streamMinutes
            bool sameOwnerTime = array.get(fvgOwnerCrtConfirmationTimes, index) == ownerCrtConfirmationTime
            bool sameOwnerStream = array.get(fvgOwnerCrtStreamMinutes, index) == ownerCrtStreamMinutes
            if sameFvgStream and sameOwnerTime and sameOwnerStream
                f_remove_fvg(index)
                removedCount += 1
    removedCount

f_find_oldest_fvg_index() =>
    int candidateIndex = -1
    if array.size(fvgConfirmationTimes) > 0
        for index = 0 to array.size(fvgConfirmationTimes) - 1
            if candidateIndex == -1 or array.get(fvgConfirmationTimes, index) < array.get(fvgConfirmationTimes, candidateIndex)
                candidateIndex := index
    candidateIndex

f_enforce_fvg_storage_limit() =>
    int removedCount = 0
    while array.size(fvgConfirmationTimes) > maximumStoredFvgs
        int removalIndex = f_find_oldest_fvg_index()
        if removalIndex < 0
            break
        f_remove_fvg(removalIndex)
        removedCount += 1
    removedCount

f_add_fvg(int streamMinutes, int direction, float zoneLow, float zoneHigh, int fvgStartTime, int confirmationTime, int ownerCrtConfirmationTime, int ownerCrtStreamMinutes, int sessionKey, int activationBar, bool canFillOnActivationBar, int initialRightTime) =>
    color streamColor = f_fvg_color(streamMinutes, direction)
    string labelText = f_fvg_stream_name(streamMinutes) + " " + (direction == DIRECTION_BULLISH ? "Bull FVG" : "Bear FVG")
    int fillTransparency = f_fvg_fill_transparency(streamMinutes)
    int borderTransparency = math.max(fillTransparency - 35, 0)
    box fvgBox = box.new(fvgStartTime, zoneHigh, initialRightTime, zoneLow, xloc = xloc.bar_time, bgcolor = color.new(streamColor, fillTransparency), border_color = color.new(streamColor, borderTransparency), border_width = 1)
    label fvgLabel = na
    if showFvgLabels
        float labelPrice = direction == DIRECTION_BULLISH ? zoneLow : zoneHigh
        fvgLabel := label.new(fvgStartTime, labelPrice, labelText, xloc = xloc.bar_time, style = direction == DIRECTION_BULLISH ? label.style_label_up : label.style_label_down, color = color.new(streamColor, 15), textcolor = color.white, size = size.tiny)
    array.push(fvgStreamMinutes, streamMinutes)
    array.push(fvgDirections, direction)
    array.push(fvgZoneHighs, zoneHigh)
    array.push(fvgZoneLows, zoneLow)
    array.push(fvgConfirmationTimes, confirmationTime)
    array.push(fvgOwnerCrtConfirmationTimes, ownerCrtConfirmationTime)
    array.push(fvgOwnerCrtStreamMinutes, ownerCrtStreamMinutes)
    array.push(fvgSessionKeys, sessionKey)
    array.push(fvgActivationBars, activationBar)
    array.push(fvgCanFillOnActivationBar, canFillOnActivationBar)
    array.push(fvgFilled, false)
    array.push(fvgExpired, false)
    array.push(fvgBoxes, fvgBox)
    array.push(fvgLabels, fvgLabel)
    f_enforce_fvg_storage_limit()

f_process_qualifying_fvg(int streamMinutes, int direction, float zoneLow, float zoneHigh, int fvgStartTime, int confirmationTime, int sessionKey, int activationBar, bool canFillOnActivationBar, int initialRightTime) =>
    int ownerIndex = f_find_owner_crt_index(direction, sessionKey, confirmationTime)
    if ownerIndex >= 0
        int ownerCrtConfirmationTime = array.get(crtConfirmationTimes, ownerIndex)
        int ownerCrtStreamMinutes = array.get(crtStreamMinutes, ownerIndex)
        int metricIndex = f_find_metric_crt_index(ownerCrtStreamMinutes, direction, ownerCrtConfirmationTime, sessionKey)
        bool shouldCreateDisplayRecord = false
        if f_show_fvg_stream(streamMinutes)
            if fvgDisplayMode == FVG_DISPLAY_ALL
                shouldCreateDisplayRecord := true
            else if fvgDisplayMode == FVG_DISPLAY_FIRST
                shouldCreateDisplayRecord := metricIndex >= 0 and not f_has_displayed_first_fvg(metricIndex, streamMinutes)
            else
                f_remove_displayed_fvgs_for_owner(streamMinutes, ownerCrtConfirmationTime, ownerCrtStreamMinutes)
                shouldCreateDisplayRecord := true

        if shouldCreateDisplayRecord
            f_add_fvg(streamMinutes, direction, zoneLow, zoneHigh, fvgStartTime, confirmationTime, ownerCrtConfirmationTime, ownerCrtStreamMinutes, sessionKey, activationBar, canFillOnActivationBar, initialRightTime)
        if shouldCreateDisplayRecord and metricIndex >= 0 and fvgDisplayMode == FVG_DISPLAY_FIRST
            f_mark_displayed_first_fvg(metricIndex, streamMinutes)
        f_record_qualifying_fvg_metric(streamMinutes, ownerCrtStreamMinutes, direction, ownerCrtConfirmationTime, sessionKey, confirmationTime)
    int processedCount = ownerIndex >= 0 ? 1 : 0
    processedCount

f_update_fvg_lifecycle() =>
    int stateChanges = 0
    int currentSessionKey = f_session_key(time)
    if array.size(fvgConfirmationTimes) > 0
        for index = array.size(fvgConfirmationTimes) - 1 to 0
            bool filled = array.get(fvgFilled, index)
            bool expired = array.get(fvgExpired, index)
            int fvgSessionKey = array.get(fvgSessionKeys, index)
            int direction = array.get(fvgDirections, index)
            float zoneHigh = array.get(fvgZoneHighs, index)
            float zoneLow = array.get(fvgZoneLows, index)
            int activationBar = array.get(fvgActivationBars, index)
            bool canFillOnActivationBar = array.get(fvgCanFillOnActivationBar, index)
            bool sameSession = currentSessionKey >= 0 and currentSessionKey == fvgSessionKey
            bool canMonitorFill = not filled and not expired and sameSession and (canFillOnActivationBar ? bar_index >= activationBar : bar_index > activationBar)

            if not filled and not expired and sameSession
                f_set_fvg_right_edge(index, time_close)

            if canMonitorFill
                bool fullyFilled = direction == DIRECTION_BULLISH ? low <= zoneLow : high >= zoneHigh
                if fullyFilled
                    array.set(fvgFilled, index, true)
                    stateChanges += 1

            if index < array.size(fvgSessionKeys)
                bool stillFilled = array.get(fvgFilled, index)
                bool stillExpired = array.get(fvgExpired, index)
                int stillSessionKey = array.get(fvgSessionKeys, index)
                bool closingOwnSession = not stillFilled and not stillExpired and stillSessionKey == fvgSessionKey and sameSession and barstate.isconfirmed and f_is_session_end_boundary(time_close)
                bool crossedOutOfSession = not stillFilled and not stillExpired and stillSessionKey == fvgSessionKey and not sameSession

                if closingOwnSession or crossedOutOfSession
                    array.set(fvgExpired, index, true)
                    stateChanges += 1
    stateChanges

f_metric_count_text(int value) =>
    str.tostring(value)

f_metric_percent_text(int numerator, int denominator) =>
    denominator > 0 ? str.tostring(float(numerator) * 100.0 / denominator, "#.##") + "%" : "n/a"

f_metric_average_text(float numerator, int denominator) =>
    denominator > 0 ? str.tostring(numerator / denominator, "#.##") : "n/a"

f_render_fvg_comparison_table() =>
    int eligibleCrtCount = array.size(metricCrtConfirmationTimes)
    table.cell(fvgComparisonTable, 0, 0, "Metric", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(fvgComparisonTable, 1, 0, "1m", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(fvgComparisonTable, 2, 0, "5m", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(fvgComparisonTable, 0, 1, "Eligible CRTs", text_color = color.white)
    table.cell(fvgComparisonTable, 1, 1, f_metric_count_text(eligibleCrtCount))
    table.cell(fvgComparisonTable, 2, 1, f_metric_count_text(eligibleCrtCount))

    if not enableFvgDetection
        table.cell(fvgComparisonTable, 0, 2, "FVG Detection", text_color = color.white)
        table.cell(fvgComparisonTable, 1, 2, "Disabled", text_color = color.silver)
        table.cell(fvgComparisonTable, 2, 2, "Disabled", text_color = color.silver)
        for row = 3 to 6
            table.cell(fvgComparisonTable, 0, row, "")
            table.cell(fvgComparisonTable, 1, row, "")
            table.cell(fvgComparisonTable, 2, row, "")
    else
        table.cell(fvgComparisonTable, 0, 2, "Qualifying FVGs", text_color = color.white)
        table.cell(fvgComparisonTable, 1, 2, f_metric_count_text(array.get(qualifying1mFvgCount, 0)))
        table.cell(fvgComparisonTable, 2, 2, f_metric_count_text(array.get(qualifying5mFvgCount, 0)))
        table.cell(fvgComparisonTable, 0, 3, "CRTs with ≥1 FVG", text_color = color.white)
        table.cell(fvgComparisonTable, 1, 3, f_metric_count_text(array.get(covered1mCrtCount, 0)))
        table.cell(fvgComparisonTable, 2, 3, f_metric_count_text(array.get(covered5mCrtCount, 0)))
        table.cell(fvgComparisonTable, 0, 4, "CRT Coverage %", text_color = color.white)
        table.cell(fvgComparisonTable, 1, 4, f_metric_percent_text(array.get(covered1mCrtCount, 0), eligibleCrtCount))
        table.cell(fvgComparisonTable, 2, 4, f_metric_percent_text(array.get(covered5mCrtCount, 0), eligibleCrtCount))
        table.cell(fvgComparisonTable, 0, 5, "Avg FVGs per CRT", text_color = color.white)
        table.cell(fvgComparisonTable, 1, 5, f_metric_average_text(float(array.get(qualifying1mFvgCount, 0)), eligibleCrtCount))
        table.cell(fvgComparisonTable, 2, 5, f_metric_average_text(float(array.get(qualifying5mFvgCount, 0)), eligibleCrtCount))
        table.cell(fvgComparisonTable, 0, 6, "Avg Minutes to First FVG", text_color = color.white)
        table.cell(fvgComparisonTable, 1, 6, f_metric_average_text(array.get(first1mFvgDelayMinutesTotal, 0), array.get(covered1mCrtCount, 0)))
        table.cell(fvgComparisonTable, 2, 6, f_metric_average_text(array.get(first5mFvgDelayMinutesTotal, 0), array.get(covered5mCrtCount, 0)))

    int renderedCount = 1
    renderedCount

f_add_crt(int streamMinutes, int direction, float rangeHigh, float rangeLow, int rangeStartTime, int confirmationTime, int activationBar, int sessionKey, int initialRightTime) =>
    float midpoint = (rangeHigh + rangeLow) * 0.5
    float target = direction == DIRECTION_BULLISH ? rangeHigh : rangeLow
    color streamColor = f_crt_color(streamMinutes, direction)
    color fillColor = color.new(streamColor, activeFillTransparency)
    color midpointColor = color.new(streamColor, 35)
    string labelText = f_stream_name(streamMinutes) + " " + (direction == DIRECTION_BULLISH ? "Bull CRT" : "Bear CRT")
    box crtBox = box.new(rangeStartTime, rangeHigh, initialRightTime, rangeLow, xloc = xloc.bar_time, bgcolor = fillColor, border_color = streamColor, border_width = 1)
    line highLine = line.new(rangeStartTime, rangeHigh, initialRightTime, rangeHigh, xloc = xloc.bar_time, color = streamColor, width = 1)
    line lowLine = line.new(rangeStartTime, rangeLow, initialRightTime, rangeLow, xloc = xloc.bar_time, color = streamColor, width = 1)
    line midLine = line.new(rangeStartTime, midpoint, initialRightTime, midpoint, xloc = xloc.bar_time, color = midpointColor, width = 1, style = line.style_dotted)
    label crtLabel = na
    if showCrtLabels
        float labelPrice = direction == DIRECTION_BULLISH ? rangeLow : rangeHigh
        crtLabel := label.new(
             confirmationTime,
             labelPrice,
             labelText,
             xloc = xloc.bar_time,
             style = direction == DIRECTION_BULLISH ? label.style_label_up : label.style_label_down,
             color = streamColor,
             textcolor = color.white,
             size = size.tiny
         )
    array.push(crtStreamMinutes, streamMinutes)
    array.push(crtDirections, direction)
    array.push(crtRangeHighs, rangeHigh)
    array.push(crtRangeLows, rangeLow)
    array.push(crtMidpoints, midpoint)
    array.push(crtTargets, target)
    array.push(crtConfirmationTimes, confirmationTime)
    array.push(crtRangeStartTimes, rangeStartTime)
    array.push(crtActivationBars, activationBar)
    array.push(crtSessionKeys, sessionKey)
    array.push(crtCompleted, false)
    array.push(crtExpired, false)
    array.push(crtBoxes, crtBox)
    array.push(crtHighLines, highLine)
    array.push(crtLowLines, lowLine)
    array.push(crtMidLines, midLine)
    array.push(crtLabels, crtLabel)
    f_register_crt_metric(streamMinutes, direction, confirmationTime, sessionKey)
    f_enforce_storage_limit()

f_should_remove_completed_range() =>
    completedRangeBehavior == COMPLETION_HIDE or (completedRangeBehavior == COMPLETION_AUTO and barstate.isrealtime)

f_style_completed_crt(int index) =>
    int streamMinutes = array.get(crtStreamMinutes, index)
    int direction = array.get(crtDirections, index)
    color streamColor = f_crt_color(streamMinutes, direction)
    box crtBox = array.get(crtBoxes, index)
    line highLine = array.get(crtHighLines, index)
    line lowLine = array.get(crtLowLines, index)
    line midLine = array.get(crtMidLines, index)
    label crtLabel = array.get(crtLabels, index)

    if dimCompletedRanges
        box.set_bgcolor(crtBox, color.new(streamColor, completedFillTransparency))
        box.set_border_color(crtBox, color.new(streamColor, 55))
        line.set_color(highLine, color.new(streamColor, 55))
        line.set_color(lowLine, color.new(streamColor, 55))
        line.set_color(midLine, color.new(streamColor, 70))

        if not na(crtLabel)
            string completedText = f_stream_name(streamMinutes) + " " + (direction == DIRECTION_BULLISH ? "Bull CRT" : "Bear CRT") + " • HIT"
            label.set_text(crtLabel, completedText)
            label.set_color(crtLabel, color.new(streamColor, 35))

    int styledCount = 1
    styledCount

f_style_expired_crt(int index) =>
    label crtLabel = array.get(crtLabels, index)
    if showSessionExpiryLabels and not na(crtLabel)
        int streamMinutes = array.get(crtStreamMinutes, index)
        int direction = array.get(crtDirections, index)
        string currentText = label.get_text(crtLabel)
        string expiryText = currentText + " • DAY END"
        label.set_text(crtLabel, expiryText)
    int styledCount = 1
    styledCount

f_update_crt_lifecycle() =>
    int stateChanges = 0
    int currentSessionKey = f_session_key(time)

    if array.size(crtConfirmationTimes) > 0
        for index = array.size(crtConfirmationTimes) - 1 to 0
            bool completed = array.get(crtCompleted, index)
            bool expired = array.get(crtExpired, index)
            int activationBar = array.get(crtActivationBars, index)
            int crtSessionKey = array.get(crtSessionKeys, index)
            int direction = array.get(crtDirections, index)
            float target = array.get(crtTargets, index)

            bool sameSession = currentSessionKey >= 0 and currentSessionKey == crtSessionKey
            bool canMonitorTarget = not completed and not expired and sameSession and bar_index >= activationBar

            // A retained CRT continues through the session even after its opposite-side target
            // has been hit historically. It never extends into another 18:00-16:59 trading day.
            if not expired and sameSession
                f_set_crt_right_edge(index, time_close)

            bool removedThisExecution = false

            if canMonitorTarget
                bool targetHit = direction == DIRECTION_BULLISH ? high >= target : low <= target
                if targetHit
                    bool removeCompletedRange = f_should_remove_completed_range()

                    if removeCompletedRange
                        f_remove_crt(index)
                        removedThisExecution := true
                    else
                        array.set(crtCompleted, index, true)
                        f_style_completed_crt(index)

                    stateChanges += 1

            // If the CRT still exists after target processing, finalize/remove it at the
            // 17:00 boundary. Historical objects remain finite for backtesting; live objects
            // are removed so no range carries beyond the client's trading day.
            if not removedThisExecution and index < array.size(crtSessionKeys)
                bool stillExpired = array.get(crtExpired, index)
                int stillSessionKey = array.get(crtSessionKeys, index)
                bool closingOwnSession = not stillExpired and stillSessionKey == crtSessionKey and sameSession and barstate.isconfirmed and f_is_session_end_boundary(time_close)
                bool crossedOutOfSession = not stillExpired and stillSessionKey == crtSessionKey and not sameSession

                if closingOwnSession or crossedOutOfSession
                    if barstate.isrealtime
                        f_remove_crt(index)
                    else
                        array.set(crtExpired, index, true)
                        f_style_expired_crt(index)
                    stateChanges += 1

    stateChanges

bool supports15mStream = f_chart_supports_stream(CRT_15M)
bool supports30mStream = f_chart_supports_stream(CRT_30M)
bool supports1mFvgStream = timeframe.isintraday and timeframe.in_seconds() == 60
bool supports5mFvgStream = f_chart_supports_stream(FVG_5M)
bool useNative5mFvg = timeframe.isintraday and timeframe.in_seconds() == timeframe.in_seconds(FVG_5M)

// This uses the last confirmed 4H SMA value on every chart bar without leaking future 4H data.
float confirmed4hSma200 = request.security(
    syminfo.tickerid,
    SMA_TF,
    ta.sma(close, SMA_LENGTH)[1],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)

plot(show4h200Sma ? confirmed4hSma200 : na, "Confirmed 4H SMA 200", color = color.yellow, linewidth = 2)

// Each CRT stream uses confirmed source candles only:
// C2 is the most recently completed source candle [1], and C1 is the candle immediately before it [2].
int confirmationTime15 = request.security(syminfo.tickerid, CRT_15M, time_close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int rangeStartTime15 = request.security(syminfo.tickerid, CRT_15M, time[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1High15 = request.security(syminfo.tickerid, CRT_15M, high[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1Low15 = request.security(syminfo.tickerid, CRT_15M, low[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2High15 = request.security(syminfo.tickerid, CRT_15M, high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Low15 = request.security(syminfo.tickerid, CRT_15M, low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Close15 = request.security(syminfo.tickerid, CRT_15M, close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c1SessionKey15 = request.security(syminfo.tickerid, CRT_15M, f_session_key(time[2]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c2SessionKey15 = request.security(syminfo.tickerid, CRT_15M, f_session_key(time[1]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

int confirmationTime30 = request.security(syminfo.tickerid, CRT_30M, time_close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int rangeStartTime30 = request.security(syminfo.tickerid, CRT_30M, time[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1High30 = request.security(syminfo.tickerid, CRT_30M, high[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1Low30 = request.security(syminfo.tickerid, CRT_30M, low[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2High30 = request.security(syminfo.tickerid, CRT_30M, high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Low30 = request.security(syminfo.tickerid, CRT_30M, low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Close30 = request.security(syminfo.tickerid, CRT_30M, close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c1SessionKey30 = request.security(syminfo.tickerid, CRT_30M, f_session_key(time[2]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c2SessionKey30 = request.security(syminfo.tickerid, CRT_30M, f_session_key(time[1]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

int fvg1mStartTime = time[2]
int fvg1mConfirmationTime = time_close
float fvg1mAHigh = high[2]
float fvg1mALow = low[2]
float fvg1mCHigh = high
float fvg1mCLow = low
int fvg1mSessionKeyA = f_session_key(time[2])
int fvg1mSessionKeyB = f_session_key(time[1])
int fvg1mSessionKeyC = f_session_key(time)

int fvg5mStartTime = useNative5mFvg ? time[2] : request.security(syminfo.tickerid, FVG_5M, time[3], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int fvg5mConfirmationTime = useNative5mFvg ? time_close : request.security(syminfo.tickerid, FVG_5M, time_close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float fvg5mAHigh = useNative5mFvg ? high[2] : request.security(syminfo.tickerid, FVG_5M, high[3], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float fvg5mALow = useNative5mFvg ? low[2] : request.security(syminfo.tickerid, FVG_5M, low[3], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float fvg5mCHigh = useNative5mFvg ? high : request.security(syminfo.tickerid, FVG_5M, high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float fvg5mCLow = useNative5mFvg ? low : request.security(syminfo.tickerid, FVG_5M, low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int fvg5mSessionKeyA = useNative5mFvg ? f_session_key(time[2]) : request.security(syminfo.tickerid, FVG_5M, f_session_key(time[3]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int fvg5mSessionKeyB = useNative5mFvg ? f_session_key(time[1]) : request.security(syminfo.tickerid, FVG_5M, f_session_key(time[2]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int fvg5mSessionKeyC = useNative5mFvg ? f_session_key(time) : request.security(syminfo.tickerid, FVG_5M, f_session_key(time[1]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// Keep the activation condition true throughout the realtime activation bar so rollback can
// recreate the same uncommitted CRT state on every tick until the bar closes and commits it.
bool valid15mSessionPair = c1SessionKey15 >= 0 and c1SessionKey15 == c2SessionKey15 and f_is_in_client_session(confirmationTime15)
bool valid30mSessionPair = c1SessionKey30 >= 0 and c1SessionKey30 == c2SessionKey30 and f_is_in_client_session(confirmationTime30)
bool valid1mFvgSessionTriple = fvg1mSessionKeyA >= 0 and fvg1mSessionKeyA == fvg1mSessionKeyB and fvg1mSessionKeyB == fvg1mSessionKeyC and f_is_in_client_session(fvg1mConfirmationTime)
bool valid5mFvgSessionTriple = fvg5mSessionKeyA >= 0 and fvg5mSessionKeyA == fvg5mSessionKeyB and fvg5mSessionKeyB == fvg5mSessionKeyC and f_is_in_client_session(fvg5mConfirmationTime)

bool new15mEvent = enable15mCrt and supports15mStream and valid15mSessionPair and not na(confirmationTime15) and ta.change(confirmationTime15) != 0
bool new30mEvent = enable30mCrt and supports30mStream and valid30mSessionPair and not na(confirmationTime30) and ta.change(confirmationTime30) != 0
bool new1mFvgEvent = enableFvgDetection and supports1mFvgStream and valid1mFvgSessionTriple and barstate.isconfirmed
bool new5mFvgEvent = enableFvgDetection and supports5mFvgStream and valid5mFvgSessionTriple and (useNative5mFvg ? barstate.isconfirmed : not na(fvg5mConfirmationTime) and ta.change(fvg5mConfirmationTime) != 0)

if new15mEvent and not na(c1High15) and not na(c1Low15) and not na(rangeStartTime15) and f_passes_minimum_range_filter(c1High15, c1Low15)
    bool bullish15m = f_is_bullish_crt(c1High15, c1Low15, c2High15, c2Low15, c2Close15) and f_passes_sma_filter(DIRECTION_BULLISH, c2Close15, confirmed4hSma200)
    bool bearish15m = f_is_bearish_crt(c1High15, c1Low15, c2High15, c2Low15, c2Close15) and f_passes_sma_filter(DIRECTION_BEARISH, c2Close15, confirmed4hSma200)
    if bullish15m
        f_add_crt(15, DIRECTION_BULLISH, c1High15, c1Low15, rangeStartTime15, confirmationTime15, bar_index, c2SessionKey15, time_close)
    if bearish15m
        f_add_crt(15, DIRECTION_BEARISH, c1High15, c1Low15, rangeStartTime15, confirmationTime15, bar_index, c2SessionKey15, time_close)

if new30mEvent and not na(c1High30) and not na(c1Low30) and not na(rangeStartTime30) and f_passes_minimum_range_filter(c1High30, c1Low30)
    bool bullish30m = f_is_bullish_crt(c1High30, c1Low30, c2High30, c2Low30, c2Close30) and f_passes_sma_filter(DIRECTION_BULLISH, c2Close30, confirmed4hSma200)
    bool bearish30m = f_is_bearish_crt(c1High30, c1Low30, c2High30, c2Low30, c2Close30) and f_passes_sma_filter(DIRECTION_BEARISH, c2Close30, confirmed4hSma200)
    if bullish30m
        f_add_crt(30, DIRECTION_BULLISH, c1High30, c1Low30, rangeStartTime30, confirmationTime30, bar_index, c2SessionKey30, time_close)
    if bearish30m
        f_add_crt(30, DIRECTION_BEARISH, c1High30, c1Low30, rangeStartTime30, confirmationTime30, bar_index, c2SessionKey30, time_close)

f_update_crt_lifecycle()

if new1mFvgEvent and not na(fvg1mAHigh) and not na(fvg1mALow)
    bool bullish1mFvg = f_is_bullish_fvg(fvg1mAHigh, fvg1mCLow)
    bool bearish1mFvg = f_is_bearish_fvg(fvg1mALow, fvg1mCHigh)
    if bullish1mFvg
        f_process_qualifying_fvg(FVG_STREAM_1M, DIRECTION_BULLISH, fvg1mAHigh, fvg1mCLow, fvg1mStartTime, fvg1mConfirmationTime, fvg1mSessionKeyC, bar_index, false, time_close)
    if bearish1mFvg
        f_process_qualifying_fvg(FVG_STREAM_1M, DIRECTION_BEARISH, fvg1mCHigh, fvg1mALow, fvg1mStartTime, fvg1mConfirmationTime, fvg1mSessionKeyC, bar_index, false, time_close)

if new5mFvgEvent and not na(fvg5mAHigh) and not na(fvg5mALow) and not na(fvg5mConfirmationTime)
    bool bullish5mFvg = f_is_bullish_fvg(fvg5mAHigh, fvg5mCLow)
    bool bearish5mFvg = f_is_bearish_fvg(fvg5mALow, fvg5mCHigh)
    if bullish5mFvg
        f_process_qualifying_fvg(FVG_STREAM_5M, DIRECTION_BULLISH, fvg5mAHigh, fvg5mCLow, fvg5mStartTime, fvg5mConfirmationTime, fvg5mSessionKeyC, bar_index, not useNative5mFvg, time_close)
    if bearish5mFvg
        f_process_qualifying_fvg(FVG_STREAM_5M, DIRECTION_BEARISH, fvg5mCHigh, fvg5mALow, fvg5mStartTime, fvg5mConfirmationTime, fvg5mSessionKeyC, bar_index, not useNative5mFvg, time_close)

f_update_fvg_lifecycle()

if barstate.islast
    if not na(warningLabel)
        label.delete(warningLabel)
        warningLabel := na
    if showUnsupportedWarnings
        string warningText = ""
        if enable15mCrt and not supports15mStream
            warningText += (str.length(warningText) > 0 ? "\n" : "") + "15m CRT disabled on " + timeframe.period + ". Use an intraday chart that is 15m or lower and evenly divides 15 minutes."
        if enable30mCrt and not supports30mStream
            warningText += (str.length(warningText) > 0 ? "\n" : "") + "30m CRT disabled on " + timeframe.period + ". Use an intraday chart that is 30m or lower and evenly divides 30 minutes."
        if enableFvgDetection and not supports1mFvgStream
            warningText += (str.length(warningText) > 0 ? "\n" : "") + "1m FVG comparison requires a 1m chart."
        if enableFvgDetection and not supports5mFvgStream
            warningText += (str.length(warningText) > 0 ? "\n" : "") + "5m FVG requires a 1m or 5m chart with safe source alignment."
        if str.length(warningText) > 0
            warningLabel := label.new(time, high, warningText, xloc = xloc.bar_time, style = label.style_label_upper_left, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    if showFvgComparisonTable
        f_render_fvg_comparison_table()
