//@version=6
indicator(
    "Candle Range Theory (CRT) Indicator v0.3",
    overlay = true,
    max_boxes_count = 300,
    max_lines_count = 500,
    max_labels_count = 300
)

string GROUP_STREAMS = "CRT Streams"
string GROUP_FILTERS = "Filters"
string GROUP_SMA = "4H SMA Filter"
string GROUP_SESSION = "Trading Day Session"
string GROUP_LIFECYCLE = "Range Lifecycle"
string GROUP_STYLE = "Style"
string GROUP_DIAGNOSTICS = "Diagnostics"

string CRT_15M = "15"
string CRT_30M = "30"
string SMA_TF = "240"
int SMA_LENGTH = 200
int DIRECTION_BULLISH = 1
int DIRECTION_BEARISH = -1

string COMPLETION_AUTO = "Auto: History Keep / Live Hide"
string COMPLETION_KEEP = "Always Keep"
string COMPLETION_HIDE = "Always Hide"

string SESSION_TZ_NY = "America/New_York"
string SESSION_TZ_CHICAGO = "America/Chicago"
string SESSION_TZ_EXCHANGE = "Exchange"
int SESSION_START_HOUR = 18
int SESSION_END_HOUR = 17
int MILLISECONDS_PER_HOUR = 60 * 60 * 1000

bool enable15mCrt = input.bool(true, "Enable 15m CRT", group = GROUP_STREAMS)
bool enable30mCrt = input.bool(true, "Enable 30m CRT", group = GROUP_STREAMS)

bool enableMinimumRangeFilter = input.bool(false, "Enable Minimum Range Filter", group = GROUP_FILTERS)
float minimumRange = input.float(0.0, "Minimum Range", minval = 0.0, step = 0.25, group = GROUP_FILTERS)
string rangeUnit = input.string("Price", "Range Unit", options = ["Price", "Ticks"], group = GROUP_FILTERS)

string sessionTimezoneChoice = input.string(
    SESSION_TZ_NY,
    "Session Timezone",
    options = [SESSION_TZ_NY, SESSION_TZ_CHICAGO, SESSION_TZ_EXCHANGE],
    tooltip = "Client trading day is 18:00 through 16:59. New York is the current default pending final timezone confirmation. Exchange uses the symbol's exchange timezone.",
    group = GROUP_SESSION
)
string sessionTimezone = sessionTimezoneChoice == SESSION_TZ_EXCHANGE ? syminfo.timezone : sessionTimezoneChoice
bool showSessionExpiryLabels = input.bool(false, "Mark Session-Expired Historical Ranges", tooltip = "Optional visual marker only. Historical ranges already stop at the 17:00 session boundary.", group = GROUP_SESSION)

bool show4h200Sma = input.bool(true, "Show 4H 200 SMA", group = GROUP_SMA)

string completedRangeBehavior = input.string(
    COMPLETION_AUTO,
    "Completed Range Behavior",
    options = [COMPLETION_AUTO, COMPLETION_KEEP, COMPLETION_HIDE],
    tooltip = "All CRTs are session-scoped to 18:00-16:59. Auto keeps target-hit ranges through the remainder of a historical session for backtesting, but hides them immediately when hit live. Always Keep retains target-hit ranges until session end. Always Hide removes target-hit ranges immediately everywhere.",
    group = GROUP_LIFECYCLE
)
int maximumStoredCrtRanges = input.int(40, "Maximum Stored CRT Ranges", minval = 1, maxval = 120, group = GROUP_LIFECYCLE)

bool showCrtLabels = input.bool(true, "Show CRT Labels", group = GROUP_STYLE)
bool dimCompletedRanges = input.bool(true, "Dim Completed Historical Ranges", tooltip = "When completed ranges are retained, make them visually lighter and append HIT to their label.", group = GROUP_STYLE)
int activeFillTransparency = input.int(90, "Active Range Fill Transparency", minval = 0, maxval = 100, group = GROUP_STYLE)
int completedFillTransparency = input.int(96, "Completed Range Fill Transparency", minval = 0, maxval = 100, group = GROUP_STYLE)

color bullish15mColor = input.color(color.teal, "15m Bullish Color", group = GROUP_STYLE)
color bearish15mColor = input.color(color.orange, "15m Bearish Color", group = GROUP_STYLE)
color bullish30mColor = input.color(color.blue, "30m Bullish Color", group = GROUP_STYLE)
color bearish30mColor = input.color(color.maroon, "30m Bearish Color", group = GROUP_STYLE)

bool showUnsupportedWarnings = input.bool(true, "Show Unsupported Timeframe Warnings", group = GROUP_DIAGNOSTICS)

var array<int> crtStreamMinutes = array.new_int()
var array<int> crtDirections = array.new_int()
var array<float> crtRangeHighs = array.new_float()
var array<float> crtRangeLows = array.new_float()
var array<float> crtMidpoints = array.new_float()
var array<float> crtTargets = array.new_float()
var array<int> crtConfirmationTimes = array.new_int()
var array<int> crtRangeStartTimes = array.new_int()
var array<int> crtActivationBars = array.new_int()
var array<int> crtSessionKeys = array.new_int()
var array<bool> crtCompleted = array.new_bool()
var array<bool> crtExpired = array.new_bool()
var array<box> crtBoxes = array.new_box()
var array<line> crtHighLines = array.new_line()
var array<line> crtLowLines = array.new_line()
var array<line> crtMidLines = array.new_line()
var array<label> crtLabels = array.new_label()

var label warningLabel = na

f_stream_name(int streamMinutes) =>
    str.tostring(streamMinutes) + "m"

f_is_in_client_session(int barTime) =>
    int localHour = hour(barTime, sessionTimezone)
    localHour >= SESSION_START_HOUR or localHour < SESSION_END_HOUR

f_session_key(int barTime) =>
    int key = -1
    if not na(barTime) and f_is_in_client_session(barTime)
        int localHour = hour(barTime, sessionTimezone)
        // Bars from midnight through 16:59 belong to the session that began the previous calendar day.
        // Subtracting 18 absolute hours is only used to obtain a stable previous local calendar date key.
        int anchorTime = localHour < SESSION_END_HOUR ? barTime - 18 * MILLISECONDS_PER_HOUR : barTime
        key := year(anchorTime, sessionTimezone) * 10000 + month(anchorTime, sessionTimezone) * 100 + dayofmonth(anchorTime, sessionTimezone)
    key

f_is_session_end_boundary(int boundaryTime) =>
    not na(boundaryTime) and hour(boundaryTime, sessionTimezone) == SESSION_END_HOUR and minute(boundaryTime, sessionTimezone) == 0

f_chart_supports_stream(string timeframeCode) =>
    // Only allow chart timeframes that divide the source timeframe evenly.
    // That keeps each 15m/30m confirmation aligned to a real chart-bar close.
    int chartSeconds = timeframe.in_seconds()
    int streamSeconds = timeframe.in_seconds(timeframeCode)
    timeframe.isintraday and chartSeconds <= streamSeconds and streamSeconds % chartSeconds == 0

f_crt_color(int streamMinutes, int direction) =>
    if streamMinutes == 15
        direction == DIRECTION_BULLISH ? bullish15mColor : bearish15mColor
    else
        direction == DIRECTION_BULLISH ? bullish30mColor : bearish30mColor

f_is_dual_sweep(float c1High, float c1Low, float c2High, float c2Low) =>
    c2High > c1High and c2Low < c1Low

f_passes_minimum_range_filter(float rangeHigh, float rangeLow) =>
    float rangeSize = rangeHigh - rangeLow
    float rangeTicks = syminfo.mintick > 0 ? rangeSize / syminfo.mintick : na
    not enableMinimumRangeFilter or (rangeUnit == "Price" ? rangeSize >= minimumRange : not na(rangeTicks) and rangeTicks >= minimumRange)

f_is_bullish_crt(float c1High, float c1Low, float c2High, float c2Low, float c2Close) =>
    not f_is_dual_sweep(c1High, c1Low, c2High, c2Low) and c2High <= c1High and c2Low < c1Low and c2Close > c1Low and c2Close < c1High

f_is_bearish_crt(float c1High, float c1Low, float c2High, float c2Low, float c2Close) =>
    not f_is_dual_sweep(c1High, c1Low, c2High, c2Low) and c2Low >= c1Low and c2High > c1High and c2Close < c1High and c2Close > c1Low

f_passes_sma_filter(int direction, float c2Close, float confirmedSma) =>
    not na(confirmedSma) and (direction == DIRECTION_BULLISH ? c2Close > confirmedSma : c2Close < confirmedSma)

f_set_crt_right_edge(int index, int rightTime) =>
    box crtBox = array.get(crtBoxes, index)
    line highLine = array.get(crtHighLines, index)
    line lowLine = array.get(crtLowLines, index)
    line midLine = array.get(crtMidLines, index)
    box.set_right(crtBox, rightTime)
    line.set_x2(highLine, rightTime)
    line.set_x2(lowLine, rightTime)
    line.set_x2(midLine, rightTime)

f_delete_crt_objects(int index) =>
    box crtBox = array.get(crtBoxes, index)
    line highLine = array.get(crtHighLines, index)
    line lowLine = array.get(crtLowLines, index)
    line midLine = array.get(crtMidLines, index)
    label crtLabel = array.get(crtLabels, index)
    box.delete(crtBox)
    line.delete(highLine)
    line.delete(lowLine)
    line.delete(midLine)
    if not na(crtLabel)
        label.delete(crtLabel)
    int deletedCount = 1
    deletedCount

f_remove_crt(int index) =>
    f_delete_crt_objects(index)
    array.remove(crtStreamMinutes, index)
    array.remove(crtDirections, index)
    array.remove(crtRangeHighs, index)
    array.remove(crtRangeLows, index)
    array.remove(crtMidpoints, index)
    array.remove(crtTargets, index)
    array.remove(crtConfirmationTimes, index)
    array.remove(crtRangeStartTimes, index)
    array.remove(crtActivationBars, index)
    array.remove(crtSessionKeys, index)
    array.remove(crtCompleted, index)
    array.remove(crtExpired, index)
    array.remove(crtBoxes, index)
    array.remove(crtHighLines, index)
    array.remove(crtLowLines, index)
    array.remove(crtMidLines, index)
    array.remove(crtLabels, index)
    int removedCount = 1
    removedCount

f_find_oldest_removal_index() =>
    int candidateIndex = -1
    if array.size(crtConfirmationTimes) > 0
        for index = 0 to array.size(crtConfirmationTimes) - 1
            if candidateIndex == -1
                candidateIndex := index
            else
                bool candidateCompleted = array.get(crtCompleted, candidateIndex)
                bool currentCompleted = array.get(crtCompleted, index)
                bool candidateExpired = array.get(crtExpired, candidateIndex)
                bool currentExpired = array.get(crtExpired, index)
                bool candidateInactive = candidateCompleted or candidateExpired
                bool currentInactive = currentCompleted or currentExpired
                int candidateTime = array.get(crtConfirmationTimes, candidateIndex)
                int currentTime = array.get(crtConfirmationTimes, index)
                bool currentIsOlder = currentTime < candidateTime
                bool preferCurrent = currentInactive and not candidateInactive
                if preferCurrent or (currentInactive == candidateInactive and currentIsOlder)
                    candidateIndex := index
    candidateIndex

f_enforce_storage_limit() =>
    int removedCount = 0

    while array.size(crtConfirmationTimes) > maximumStoredCrtRanges
        int removalIndex = f_find_oldest_removal_index()

        if removalIndex < 0
            break

        f_remove_crt(removalIndex)
        removedCount += 1

    removedCount

f_add_crt(int streamMinutes, int direction, float rangeHigh, float rangeLow, int rangeStartTime, int confirmationTime, int activationBar, int sessionKey, int initialRightTime) =>
    float midpoint = (rangeHigh + rangeLow) * 0.5
    float target = direction == DIRECTION_BULLISH ? rangeHigh : rangeLow
    color streamColor = f_crt_color(streamMinutes, direction)
    color fillColor = color.new(streamColor, activeFillTransparency)
    color midpointColor = color.new(streamColor, 35)
    string labelText = f_stream_name(streamMinutes) + " " + (direction == DIRECTION_BULLISH ? "Bull CRT" : "Bear CRT")
    box crtBox = box.new(rangeStartTime, rangeHigh, initialRightTime, rangeLow, xloc = xloc.bar_time, bgcolor = fillColor, border_color = streamColor, border_width = 1)
    line highLine = line.new(rangeStartTime, rangeHigh, initialRightTime, rangeHigh, xloc = xloc.bar_time, color = streamColor, width = 1)
    line lowLine = line.new(rangeStartTime, rangeLow, initialRightTime, rangeLow, xloc = xloc.bar_time, color = streamColor, width = 1)
    line midLine = line.new(rangeStartTime, midpoint, initialRightTime, midpoint, xloc = xloc.bar_time, color = midpointColor, width = 1, style = line.style_dotted)
    label crtLabel = na
    if showCrtLabels
        float labelPrice = direction == DIRECTION_BULLISH ? rangeLow : rangeHigh
        crtLabel := label.new(
             confirmationTime,
             labelPrice,
             labelText,
             xloc = xloc.bar_time,
             style = direction == DIRECTION_BULLISH ? label.style_label_up : label.style_label_down,
             color = streamColor,
             textcolor = color.white,
             size = size.tiny
         )
    array.push(crtStreamMinutes, streamMinutes)
    array.push(crtDirections, direction)
    array.push(crtRangeHighs, rangeHigh)
    array.push(crtRangeLows, rangeLow)
    array.push(crtMidpoints, midpoint)
    array.push(crtTargets, target)
    array.push(crtConfirmationTimes, confirmationTime)
    array.push(crtRangeStartTimes, rangeStartTime)
    array.push(crtActivationBars, activationBar)
    array.push(crtSessionKeys, sessionKey)
    array.push(crtCompleted, false)
    array.push(crtExpired, false)
    array.push(crtBoxes, crtBox)
    array.push(crtHighLines, highLine)
    array.push(crtLowLines, lowLine)
    array.push(crtMidLines, midLine)
    array.push(crtLabels, crtLabel)
    f_enforce_storage_limit()

f_should_remove_completed_range() =>
    completedRangeBehavior == COMPLETION_HIDE or (completedRangeBehavior == COMPLETION_AUTO and barstate.isrealtime)

f_style_completed_crt(int index) =>
    int streamMinutes = array.get(crtStreamMinutes, index)
    int direction = array.get(crtDirections, index)
    color streamColor = f_crt_color(streamMinutes, direction)
    box crtBox = array.get(crtBoxes, index)
    line highLine = array.get(crtHighLines, index)
    line lowLine = array.get(crtLowLines, index)
    line midLine = array.get(crtMidLines, index)
    label crtLabel = array.get(crtLabels, index)

    if dimCompletedRanges
        box.set_bgcolor(crtBox, color.new(streamColor, completedFillTransparency))
        box.set_border_color(crtBox, color.new(streamColor, 55))
        line.set_color(highLine, color.new(streamColor, 55))
        line.set_color(lowLine, color.new(streamColor, 55))
        line.set_color(midLine, color.new(streamColor, 70))

        if not na(crtLabel)
            string completedText = f_stream_name(streamMinutes) + " " + (direction == DIRECTION_BULLISH ? "Bull CRT" : "Bear CRT") + " • HIT"
            label.set_text(crtLabel, completedText)
            label.set_color(crtLabel, color.new(streamColor, 35))

    int styledCount = 1
    styledCount

f_style_expired_crt(int index) =>
    label crtLabel = array.get(crtLabels, index)
    if showSessionExpiryLabels and not na(crtLabel)
        int streamMinutes = array.get(crtStreamMinutes, index)
        int direction = array.get(crtDirections, index)
        string currentText = label.get_text(crtLabel)
        string expiryText = currentText + " • DAY END"
        label.set_text(crtLabel, expiryText)
    int styledCount = 1
    styledCount

f_update_crt_lifecycle() =>
    int stateChanges = 0
    int currentSessionKey = f_session_key(time)

    if array.size(crtConfirmationTimes) > 0
        for index = array.size(crtConfirmationTimes) - 1 to 0
            bool completed = array.get(crtCompleted, index)
            bool expired = array.get(crtExpired, index)
            int activationBar = array.get(crtActivationBars, index)
            int crtSessionKey = array.get(crtSessionKeys, index)
            int direction = array.get(crtDirections, index)
            float target = array.get(crtTargets, index)

            bool sameSession = currentSessionKey >= 0 and currentSessionKey == crtSessionKey
            bool canMonitorTarget = not completed and not expired and sameSession and bar_index >= activationBar

            // A retained CRT continues through the session even after its opposite-side target
            // has been hit historically. It never extends into another 18:00-16:59 trading day.
            if not expired and sameSession
                f_set_crt_right_edge(index, time_close)

            bool removedThisExecution = false

            if canMonitorTarget
                bool targetHit = direction == DIRECTION_BULLISH ? high >= target : low <= target
                if targetHit
                    bool removeCompletedRange = f_should_remove_completed_range()

                    if removeCompletedRange
                        f_remove_crt(index)
                        removedThisExecution := true
                    else
                        array.set(crtCompleted, index, true)
                        f_style_completed_crt(index)

                    stateChanges += 1

            // If the CRT still exists after target processing, finalize/remove it at the
            // 17:00 boundary. Historical objects remain finite for backtesting; live objects
            // are removed so no range carries beyond the client's trading day.
            if not removedThisExecution and index < array.size(crtSessionKeys)
                bool stillExpired = array.get(crtExpired, index)
                int stillSessionKey = array.get(crtSessionKeys, index)
                bool closingOwnSession = not stillExpired and stillSessionKey == crtSessionKey and sameSession and barstate.isconfirmed and f_is_session_end_boundary(time_close)
                bool crossedOutOfSession = not stillExpired and stillSessionKey == crtSessionKey and not sameSession

                if closingOwnSession or crossedOutOfSession
                    if barstate.isrealtime
                        f_remove_crt(index)
                    else
                        array.set(crtExpired, index, true)
                        f_style_expired_crt(index)
                    stateChanges += 1

    stateChanges

bool supports15mStream = f_chart_supports_stream(CRT_15M)
bool supports30mStream = f_chart_supports_stream(CRT_30M)

// This uses the last confirmed 4H SMA value on every chart bar without leaking future 4H data.
float confirmed4hSma200 = request.security(
    syminfo.tickerid,
    SMA_TF,
    ta.sma(close, SMA_LENGTH)[1],
    gaps = barmerge.gaps_off,
    lookahead = barmerge.lookahead_on
)

plot(show4h200Sma ? confirmed4hSma200 : na, "Confirmed 4H SMA 200", color = color.yellow, linewidth = 2)

// Each CRT stream uses confirmed source candles only:
// C2 is the most recently completed source candle [1], and C1 is the candle immediately before it [2].
int confirmationTime15 = request.security(syminfo.tickerid, CRT_15M, time_close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int rangeStartTime15 = request.security(syminfo.tickerid, CRT_15M, time[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1High15 = request.security(syminfo.tickerid, CRT_15M, high[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1Low15 = request.security(syminfo.tickerid, CRT_15M, low[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2High15 = request.security(syminfo.tickerid, CRT_15M, high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Low15 = request.security(syminfo.tickerid, CRT_15M, low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Close15 = request.security(syminfo.tickerid, CRT_15M, close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c1SessionKey15 = request.security(syminfo.tickerid, CRT_15M, f_session_key(time[2]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c2SessionKey15 = request.security(syminfo.tickerid, CRT_15M, f_session_key(time[1]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

int confirmationTime30 = request.security(syminfo.tickerid, CRT_30M, time_close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int rangeStartTime30 = request.security(syminfo.tickerid, CRT_30M, time[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1High30 = request.security(syminfo.tickerid, CRT_30M, high[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c1Low30 = request.security(syminfo.tickerid, CRT_30M, low[2], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2High30 = request.security(syminfo.tickerid, CRT_30M, high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Low30 = request.security(syminfo.tickerid, CRT_30M, low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float c2Close30 = request.security(syminfo.tickerid, CRT_30M, close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c1SessionKey30 = request.security(syminfo.tickerid, CRT_30M, f_session_key(time[2]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
int c2SessionKey30 = request.security(syminfo.tickerid, CRT_30M, f_session_key(time[1]), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// Keep the activation condition true throughout the realtime activation bar so rollback can
// recreate the same uncommitted CRT state on every tick until the bar closes and commits it.
bool valid15mSessionPair = c1SessionKey15 >= 0 and c1SessionKey15 == c2SessionKey15 and f_is_in_client_session(confirmationTime15)
bool valid30mSessionPair = c1SessionKey30 >= 0 and c1SessionKey30 == c2SessionKey30 and f_is_in_client_session(confirmationTime30)

bool new15mEvent = enable15mCrt and supports15mStream and valid15mSessionPair and not na(confirmationTime15) and ta.change(confirmationTime15) != 0
bool new30mEvent = enable30mCrt and supports30mStream and valid30mSessionPair and not na(confirmationTime30) and ta.change(confirmationTime30) != 0

if new15mEvent and not na(c1High15) and not na(c1Low15) and not na(rangeStartTime15) and f_passes_minimum_range_filter(c1High15, c1Low15)
    bool bullish15m = f_is_bullish_crt(c1High15, c1Low15, c2High15, c2Low15, c2Close15) and f_passes_sma_filter(DIRECTION_BULLISH, c2Close15, confirmed4hSma200)
    bool bearish15m = f_is_bearish_crt(c1High15, c1Low15, c2High15, c2Low15, c2Close15) and f_passes_sma_filter(DIRECTION_BEARISH, c2Close15, confirmed4hSma200)
    if bullish15m
        f_add_crt(15, DIRECTION_BULLISH, c1High15, c1Low15, rangeStartTime15, confirmationTime15, bar_index, c2SessionKey15, time_close)
    if bearish15m
        f_add_crt(15, DIRECTION_BEARISH, c1High15, c1Low15, rangeStartTime15, confirmationTime15, bar_index, c2SessionKey15, time_close)

if new30mEvent and not na(c1High30) and not na(c1Low30) and not na(rangeStartTime30) and f_passes_minimum_range_filter(c1High30, c1Low30)
    bool bullish30m = f_is_bullish_crt(c1High30, c1Low30, c2High30, c2Low30, c2Close30) and f_passes_sma_filter(DIRECTION_BULLISH, c2Close30, confirmed4hSma200)
    bool bearish30m = f_is_bearish_crt(c1High30, c1Low30, c2High30, c2Low30, c2Close30) and f_passes_sma_filter(DIRECTION_BEARISH, c2Close30, confirmed4hSma200)
    if bullish30m
        f_add_crt(30, DIRECTION_BULLISH, c1High30, c1Low30, rangeStartTime30, confirmationTime30, bar_index, c2SessionKey30, time_close)
    if bearish30m
        f_add_crt(30, DIRECTION_BEARISH, c1High30, c1Low30, rangeStartTime30, confirmationTime30, bar_index, c2SessionKey30, time_close)

f_update_crt_lifecycle()

if barstate.islast
    if not na(warningLabel)
        label.delete(warningLabel)
        warningLabel := na
    if showUnsupportedWarnings
        string warningText = ""
        if enable15mCrt and not supports15mStream
            warningText += (str.length(warningText) > 0 ? "\n" : "") + "15m CRT disabled on " + timeframe.period + ". Use an intraday chart that is 15m or lower and evenly divides 15 minutes."
        if enable30mCrt and not supports30mStream
            warningText += (str.length(warningText) > 0 ? "\n" : "") + "30m CRT disabled on " + timeframe.period + ". Use an intraday chart that is 30m or lower and evenly divides 30 minutes."
        if str.length(warningText) > 0
            warningLabel := label.new(time, high, warningText, xloc = xloc.bar_time, style = label.style_label_upper_left, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
