lvnUpperPlot4 = plot(showLvnsForDisplay ? lvnHigh4 : na, "LVN Rank #4 Upper", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot4 = plot(showLvnsForDisplay ? lvnLow4 : na, "LVN Rank #4 Lower", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter4 : na, "LVN Rank #4 Center", color = color.new(color.orange, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot5 = plot(showLvnsForDisplay ? lvnHigh5 : na, "LVN Rank #5 Upper", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot5 = plot(showLvnsForDisplay ? lvnLow5 : na, "LVN Rank #5 Lower", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
