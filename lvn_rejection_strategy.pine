//@version=6
strategy(
    "LVN Rejection Strategy",
    overlay = true,
    pyramiding = 0,
    initial_capital = 100000,
    default_qty_type = strategy.fixed,
    default_qty_value = 1,
    commission_type = strategy.commission.percent,
    commission_value = 0.0,
    slippage = 0,
    calc_on_order_fills = true,
    process_orders_on_close = false,
    use_bar_magnifier = true,
    fill_orders_on_standard_ohlc = true,
    backtest_fill_limits_assumption = 0,
    max_boxes_count = 100,
    max_lines_count = 100,
    max_labels_count = 100
)

// Premium-capable variant: Bar Magnifier remains enabled for users who have access to it.
// The strategy freezes each completed session's profile, detects LVN zones from that completed
// profile, and trades those frozen zones during the following session only.
// The profile engine is a custom volume-at-price implementation and does not guarantee parity
// with TradingView's native Fixed Range Volume Profile.

string GROUP_SESSION = "Session"
string GROUP_PROFILE = "Volume Profile"
string GROUP_LVN = "LVN Detection"
string GROUP_SELECTION = "LVN Selection"
string GROUP_ENTRY = "Entry"
string GROUP_RISK = "Risk Management"
string GROUP_BACKTEST = "Backtesting"
string GROUP_DISPLAY = "Display"
string ENTRY_OCA_GROUP = "LVN_ENTRIES"

int MAX_SUPPORTED_RANKS = 10

string profileSession = input.session("1800-1600", "Profile Session", group = GROUP_SESSION)
string sessionTimezone = input.string("America/New_York", "Timezone", group = GROUP_SESSION)
bool closePositionsAtSessionEnd = input.bool(true, "Close positions at session end", group = GROUP_SESSION)

int profileRows = input.int(24, "Profile Rows", minval = 8, maxval = 200, group = GROUP_PROFILE)
string profileCalculationMode = input.string("Chart Bar Approximation", "Profile Calculation", options = ["Chart Bar Approximation"], group = GROUP_PROFILE)

string lvnMethod = input.string("Client Threshold Valley", "LVN Detection Method", options = ["Client Threshold Valley", "Local Minimum", "Relative to POC", "Neighbor Threshold"], group = GROUP_LVN)
float lvnThresholdPct = input.float(40.0, "LVN Threshold (%)", minval = 1.0, maxval = 100.0, step = 1.0, group = GROUP_LVN)
int surroundingRows = input.int(2, "Surrounding Rows Per Side", minval = 1, maxval = 5, group = GROUP_LVN)
bool useContrastFilter = input.bool(false, "Use Minimum LVN Contrast", group = GROUP_LVN)
float minContrastRatio = input.float(1.25, "Minimum Surrounding Volume Contrast", minval = 1.0, step = 0.05, group = GROUP_LVN)
int neighborWindow = input.int(1, "Legacy Neighbor Window", minval = 1, maxval = 5, group = GROUP_LVN)
float relativeDepthThreshold = input.float(0.50, "Legacy Neighbor Threshold", minval = 0.05, maxval = 2.0, step = 0.05, group = GROUP_LVN)
float pocVolumeThreshold = input.float(0.25, "Legacy Max POC Volume Ratio", minval = 0.01, maxval = 1.0, step = 0.01, group = GROUP_LVN)
int minSeparationRows = input.int(2, "Minimum LVN Separation (rows)", minval = 0, maxval = 20, group = GROUP_LVN)
int maxLvns = input.int(MAX_SUPPORTED_RANKS, "Maximum Ranked LVNs", minval = 1, maxval = MAX_SUPPORTED_RANKS, group = GROUP_LVN)

bool tradeLVN1 = input.bool(true, "Trade LVN #1", group = GROUP_SELECTION)
bool tradeLVN2 = input.bool(false, "Trade LVN #2", group = GROUP_SELECTION)
bool tradeLVN3 = input.bool(false, "Trade LVN #3", group = GROUP_SELECTION)
bool tradeLVN4 = input.bool(false, "Trade LVN #4", group = GROUP_SELECTION)
bool tradeLVN5 = input.bool(false, "Trade LVN #5", group = GROUP_SELECTION)
bool tradeLVN6 = input.bool(false, "Trade LVN #6", group = GROUP_SELECTION)
bool tradeLVN7 = input.bool(false, "Trade LVN #7", group = GROUP_SELECTION)
bool tradeLVN8 = input.bool(false, "Trade LVN #8", group = GROUP_SELECTION)
bool tradeLVN9 = input.bool(false, "Trade LVN #9", group = GROUP_SELECTION)
bool tradeLVN10 = input.bool(false, "Trade LVN #10", group = GROUP_SELECTION)

bool tradeLongs = input.bool(true, "Trade Longs", group = GROUP_ENTRY)
bool tradeShorts = input.bool(true, "Trade Shorts", group = GROUP_ENTRY)
float minimumApproachDistance = input.float(0.0, "Minimum Approach Distance", minval = 0.0, step = 0.01, group = GROUP_ENTRY)
string lvnFreshnessMode = input.string("First Touch Only", "LVN Freshness Mode", options = ["First Touch Only", "One Trade Per LVN", "Allow Repeated Trades"], group = GROUP_ENTRY)
bool useEntrySessionFilter = input.bool(false, "Use Entry Session Filter", group = GROUP_ENTRY)
string entrySessionFilter = input.session("0930-1600", "Entry Session", group = GROUP_ENTRY)
bool blockNewEntriesBeforeSessionEnd = input.bool(true, "Block New Entries Before Session End", group = GROUP_ENTRY)
int entryCutoffMinutes = input.int(5, "Entry Cutoff Minutes", minval = 0, maxval = 120, group = GROUP_ENTRY)
float orderQty = input.float(1.0, "Order Size", minval = 0.01, step = 0.01, group = GROUP_ENTRY)

string riskMode = input.string("Fixed Points", "Risk Management", options = ["Fixed Points", "LVN Boundary + R"], group = GROUP_RISK)
float fixedSLPoints = input.float(5.0, "Fixed Stop Loss Points", minval = 0.0, step = 0.01, group = GROUP_RISK)
float fixedTPPoints = input.float(10.0, "Fixed Take Profit Points", minval = 0.0, step = 0.01, group = GROUP_RISK)
float rrMultiple = input.float(1.5, "Reward / Risk Multiple", minval = 0.1, step = 0.1, group = GROUP_RISK)
float lvnBoundaryBuffer = input.float(0.0, "LVN Boundary Buffer", minval = 0.0, step = 0.01, group = GROUP_RISK)
bool usePocDistanceFilter = input.bool(false, "Use Minimum Distance From POC", group = GROUP_RISK)
float minimumPocDistance = input.float(0.0, "Minimum Distance From POC", minval = 0.0, step = 0.01, group = GROUP_RISK)
bool tradeLvnsAbovePoc = input.bool(true, "Trade LVNs Above POC", group = GROUP_RISK)
bool tradeLvnsBelowPoc = input.bool(true, "Trade LVNs Below POC", group = GROUP_RISK)

int startDate = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Start Date", group = GROUP_BACKTEST)
int endDate = input.time(timestamp("31 Dec 2099 23:59 +0000"), "End Date", group = GROUP_BACKTEST)
string testLabel = input.string("Baseline", "Test Label", group = GROUP_BACKTEST)

bool showLvns = input.bool(true, "Show LVNs", group = GROUP_DISPLAY)
bool showVolumeProfileHistogram = input.bool(true, "Show Volume Profile Histogram", group = GROUP_DISPLAY)
int profileVisualWidth = input.int(25, "Profile Visual Width", minval = 5, maxval = 80, group = GROUP_DISPLAY)
bool nativeFrvpComparisonMode = input.bool(false, "Native FRVP Comparison Mode", group = GROUP_DISPLAY)
bool showPoc = input.bool(true, "Show Prior POC", group = GROUP_DISPLAY)
bool showSessionMarkers = input.bool(true, "Show Session Markers", group = GROUP_DISPLAY)
bool showTradeLevels = input.bool(true, "Show Active SL / TP", group = GROUP_DISPLAY)
bool showDebug = input.bool(false, "Show Debug Diagnostics", group = GROUP_DISPLAY)
bool showRowDiagnostics = input.bool(false, "Show Row Diagnostics", group = GROUP_DISPLAY)
bool showLvnLabels = input.bool(true, "Show LVN Labels", group = GROUP_DISPLAY)
bool shadeLvnZones = input.bool(true, "Shade LVN Zones", group = GROUP_DISPLAY)

var array<float> sessionBarHighs = array.new_float()
var array<float> sessionBarLows = array.new_float()
var array<float> sessionBarVolumes = array.new_float()

var array<float> profileVolumes = array.new_float()
var array<float> profileRowLows = array.new_float()
var array<float> profileRowHighs = array.new_float()

var array<float> tradableCenters = array.new_float()
var array<float> tradableLows = array.new_float()
var array<float> tradableHighs = array.new_float()
var array<float> tradableRegionAvgVolumes = array.new_float()
var array<float> tradableRegionTotalVolumes = array.new_float()
var array<float> tradableSurroundingAvgs = array.new_float()
var array<float> tradableAverageAboveVolumes = array.new_float()
var array<float> tradableAverageBelowVolumes = array.new_float()
var array<float> tradableDepthRatios = array.new_float()
var array<float> tradableContrastRatios = array.new_float()
var array<int> tradableStartRows = array.new_int()
var array<int> tradableEndRows = array.new_int()
var array<int> tradableRegionWidths = array.new_int()
var array<bool> lvnUsedThisSession = array.new_bool()
var array<bool> pendingLongOrders = array.new_bool()
var array<bool> pendingShortOrders = array.new_bool()
var array<label> lvnLabels = array.new<label>()
var array<box> profileBoxes = array.new<box>()
var table rowDiagnosticsTable = table.new(position.top_right, 8, 205, border_width = 1)

var float buildSessionHigh = na
var float buildSessionLow = na
var float buildSessionVolume = 0.0
var bool buildSessionHasPositiveVolume = false
var bool buildSessionActive = false
var bool skipCurrentBuild = false

var float frozenSessionHigh = na
var float frozenSessionLow = na
var float frozenRowHeight = na
var float frozenProfileRange = na
var float previousPocPrice = na
var int previousPocRow = na
var float previousPocVolume = na
var float frozenSourceSessionVolume = na
var float frozenProfileVolumeSum = na
var float frozenVolumeConservationErrorPct = na
var float frozenMaxRowVolume = na
var int frozenRenderedRowCount = 0
var int frozenSessionStartTime = na
var int frozenSessionEndTime = na
var bool tradableProfileReady = false
var string dataWarning = ""
var bool anyTradeTakenThisSession = false

var int activeTradeLvnIndex = -1
var int activeTradeDirection = 0
var string activeEntryId = ""
var float activeStopPrice = na
var float activeTargetPrice = na
var label statusLabel = na
var label debugLabel = na
var int frozenProfileAnchorBarIndex = na
var int buildSessionStartTime = na
var int buildSessionEndTime = na

f_long_entry_id(int rank) =>
    "LVN-L-" + str.tostring(rank)

f_short_entry_id(int rank) =>
    "LVN-S-" + str.tostring(rank)

f_exit_id(string entryId) =>
    entryId + "-X"

f_is_rank_enabled(int rank) =>
    switch rank
        1 => tradeLVN1
        2 => tradeLVN2
        3 => tradeLVN3
        4 => tradeLVN4
        5 => tradeLVN5
        6 => tradeLVN6
        7 => tradeLVN7
        8 => tradeLVN8
        9 => tradeLVN9
        10 => tradeLVN10
        => false

f_clear_label_array(array<label> labels) =>
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
    array.clear(labels)

f_clear_box_array(array<box> boxes) =>
    if array.size(boxes) > 0
        for i = 0 to array.size(boxes) - 1
            box.delete(array.get(boxes, i))
    array.clear(boxes)

f_reset_usage_flags(array<bool> flags, int size) =>
    array.clear(flags)
    if size > 0
        for i = 0 to size - 1
            array.push(flags, false)

f_reset_bool_flags(array<bool> flags, int size) =>
    array.clear(flags)
    if size > 0
        for i = 0 to size - 1
            array.push(flags, false)

f_clear_tradable_lvns() =>
    array.clear(tradableCenters)
    array.clear(tradableLows)
    array.clear(tradableHighs)
    array.clear(tradableRegionAvgVolumes)
    array.clear(tradableRegionTotalVolumes)
    array.clear(tradableSurroundingAvgs)
    array.clear(tradableAverageAboveVolumes)
    array.clear(tradableAverageBelowVolumes)
    array.clear(tradableDepthRatios)
    array.clear(tradableContrastRatios)
    array.clear(tradableStartRows)
    array.clear(tradableEndRows)
    array.clear(tradableRegionWidths)

f_clear_build_profile_buffers() =>
    array.clear(sessionBarHighs)
    array.clear(sessionBarLows)
    array.clear(sessionBarVolumes)

f_clear_frozen_profile_buffers() =>
    f_clear_tradable_lvns()
    array.clear(profileVolumes)
    array.clear(profileRowLows)
    array.clear(profileRowHighs)
    f_clear_box_array(profileBoxes)

f_cancel_rank_orders(int rank) =>
    strategy.cancel(f_long_entry_id(rank))
    strategy.cancel(f_short_entry_id(rank))

f_cancel_all_entry_orders() =>
    for rank = 1 to MAX_SUPPORTED_RANKS
        f_cancel_rank_orders(rank)

f_lvn_entry_price(int direction, float lvnLow, float lvnHigh) =>
    direction == 1 ? lvnHigh : lvnLow

f_lvn_strength_class(float depthRatio) =>
    string strength = "Custom"
    if not na(depthRatio)
        if depthRatio <= 0.30
            strength := "Very Strict"
        else if depthRatio <= 0.40
            strength := "Strong"
        else if depthRatio <= 0.50
            strength := "Moderate"
        else
            strength := "Shallow"
    strength

f_enabled_ranks_summary() =>
    string enabledRanks = ""
    for rank = 1 to MAX_SUPPORTED_RANKS
        if f_is_rank_enabled(rank)
            enabledRanks += str.length(enabledRanks) > 0 ? "," + str.tostring(rank) : str.tostring(rank)
    str.length(enabledRanks) > 0 ? enabledRanks : "None"

f_format_timestamp(int ts) =>
    string formatted = "na"
    if not na(ts)
        string yearText = str.tostring(year(ts, sessionTimezone))
        string monthText = str.tostring(month(ts, sessionTimezone), "00")
        string dayText = str.tostring(dayofmonth(ts, sessionTimezone), "00")
        string hourText = str.tostring(hour(ts, sessionTimezone), "00")
        string minuteText = str.tostring(minute(ts, sessionTimezone), "00")
        formatted := yearText + "-" + monthText + "-" + dayText + " " + hourText + ":" + minuteText
    formatted

f_format_date(int ts) =>
    string formatted = "na"
    if not na(ts)
        string yearText = str.tostring(year(ts, sessionTimezone))
        string monthText = str.tostring(month(ts, sessionTimezone), "00")
        string dayText = str.tostring(dayofmonth(ts, sessionTimezone), "00")
        formatted := yearText + "-" + monthText + "-" + dayText
    formatted

f_configuration_fingerprint() =>
    string rankSummary = f_enabled_ranks_summary()
    string directionSummary = tradeLongs and tradeShorts ? "BOTH" : tradeLongs ? "LONG" : tradeShorts ? "SHORT" : "OFF"
    string riskSummary = riskMode == "Fixed Points" ? "FIX" + str.tostring(fixedSLPoints, "#.##") + "x" + str.tostring(fixedTPPoints, "#.##") : "BR" + str.tostring(rrMultiple, "#.##")
    string histogramSummary = showVolumeProfileHistogram or nativeFrvpComparisonMode ? "HIST" : "NOHIST"
    timeframe.period + " | R" + str.tostring(profileRows) + " | T" + str.tostring(lvnThresholdPct, "#") + " | S" + str.tostring(surroundingRows) + " | LVN" + rankSummary + " | " + directionSummary + " | " + lvnFreshnessMode + " | " + riskSummary + " | " + histogramSummary

f_row_is_lvn(int rowIndex) =>
    bool isLvnRow = false
    if array.size(tradableStartRows) > 0
        for i = 0 to array.size(tradableStartRows) - 1
            int startRow = array.get(tradableStartRows, i)
            int endRow = array.get(tradableEndRows, i)
            isLvnRow := isLvnRow or (rowIndex >= startRow and rowIndex <= endRow)
    isLvnRow

f_row_lvn_index(int rowIndex) =>
    int lvnIndex = -1
    if array.size(tradableStartRows) > 0
        for i = 0 to array.size(tradableStartRows) - 1
            int startRow = array.get(tradableStartRows, i)
            int endRow = array.get(tradableEndRows, i)
            if rowIndex >= startRow and rowIndex <= endRow
                lvnIndex := i
                break
    lvnIndex

f_draw_frozen_profile_histogram(int anchorBarIndex) =>
    f_clear_box_array(profileBoxes)
    int renderedRowCount = 0

    if (showVolumeProfileHistogram or nativeFrvpComparisonMode) and array.size(profileVolumes) > 0 and array.size(profileRowLows) == array.size(profileVolumes) and array.size(profileRowHighs) == array.size(profileVolumes) and not na(anchorBarIndex)
        float maxRowVolume = 0.0
        int pocRowIndex = -1

        for row = 0 to array.size(profileVolumes) - 1
            float rowVolume = array.get(profileVolumes, row)
            if rowVolume > maxRowVolume
                maxRowVolume := rowVolume
                pocRowIndex := row

        if maxRowVolume > 0 and pocRowIndex >= 0
            int profileRightEdge = anchorBarIndex - 1

            for row = 0 to array.size(profileVolumes) - 1
                float rowVolume = array.get(profileVolumes, row)
                if rowVolume > 0
                    float normalizedWidth = rowVolume / maxRowVolume
                    int widthBars = math.max(1, int(math.round(normalizedWidth * profileVisualWidth)))
                    int rowLeftEdge = profileRightEdge - widthBars
                    float rowLow = array.get(profileRowLows, row)
                    float rowHigh = array.get(profileRowHighs, row)
                    bool isPocRow = row == pocRowIndex
                    bool isLvnRow = f_row_is_lvn(row)
                    color fillColor = isPocRow ? color.new(color.orange, 65) : isLvnRow ? color.new(color.red, 78) : color.new(color.blue, 82)
                    color borderColor = isPocRow ? color.new(color.orange, 0) : isLvnRow ? color.new(color.red, 20) : color.new(color.blue, 55)
                    box rowBox = box.new(rowLeftEdge, rowHigh, profileRightEdge, rowLow, xloc = xloc.bar_index, bgcolor = fillColor, border_color = borderColor, border_width = isPocRow ? 2 : 1)
                    array.push(profileBoxes, rowBox)
                    renderedRowCount += 1

    renderedRowCount

f_update_row_diagnostics_table() =>
    table.clear(rowDiagnosticsTable, 0, 0, 7, 204)

    bool showDiagnostics = showDebug and (showRowDiagnostics or nativeFrvpComparisonMode)
    if showDiagnostics
        table.cell(rowDiagnosticsTable, 0, 0, "Row", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 1, 0, "Low", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 2, 0, "High", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 3, 0, "Vol", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 4, 0, "%POC", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 5, 0, "LVN?", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 6, 0, "Depth", text_color = color.white, bgcolor = color.new(color.navy, 0))
        table.cell(rowDiagnosticsTable, 7, 0, "Contrast", text_color = color.white, bgcolor = color.new(color.navy, 0))

        if array.size(profileVolumes) > 0
            float pocVol = not na(previousPocVolume) ? previousPocVolume : frozenMaxRowVolume
            int rowCount = array.size(profileVolumes)
            for displayIndex = 0 to rowCount - 1
                int row = rowCount - 1 - displayIndex
                int tableRow = displayIndex + 1
                float rowLow = array.get(profileRowLows, row)
                float rowHigh = array.get(profileRowHighs, row)
                float rowVolume = array.get(profileVolumes, row)
                float rowPctOfPoc = not na(pocVol) and pocVol > 0 ? rowVolume / pocVol * 100.0 : na
                int lvnIndex = f_row_lvn_index(row)
                string lvnFlag = lvnIndex >= 0 ? "Y" : ""
                string depthText = lvnIndex >= 0 ? str.tostring(array.get(tradableDepthRatios, lvnIndex), "#.###") : ""
                string contrastText = lvnIndex >= 0 ? str.tostring(array.get(tradableContrastRatios, lvnIndex), "#.##") : ""
                color rowBg = lvnIndex >= 0 ? color.new(color.red, 88) : color.new(color.black, 92)

                table.cell(rowDiagnosticsTable, 0, tableRow, str.tostring(row + 1), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 1, tableRow, str.tostring(rowLow, format.mintick), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 2, tableRow, str.tostring(rowHigh, format.mintick), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 3, tableRow, str.tostring(rowVolume, "#.##"), text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 4, tableRow, not na(rowPctOfPoc) ? str.tostring(rowPctOfPoc, "#.##") + "%" : "", text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 5, tableRow, lvnFlag, text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 6, tableRow, depthText, text_color = color.white, bgcolor = rowBg)
                table.cell(rowDiagnosticsTable, 7, tableRow, contrastText, text_color = color.white, bgcolor = rowBg)

f_zone_touched(int direction, float entryPrice) =>
    direction == 1 ? low <= entryPrice : high >= entryPrice

f_poc_context_ok(float levelCenter) =>
    bool distanceOk = not usePocDistanceFilter
    bool sideOk = true

    if not na(previousPocPrice)
        float distanceFromPoc = math.abs(levelCenter - previousPocPrice)
        distanceOk := not usePocDistanceFilter or distanceFromPoc >= minimumPocDistance

        if levelCenter > previousPocPrice
            sideOk := tradeLvnsAbovePoc
        else if levelCenter < previousPocPrice
            sideOk := tradeLvnsBelowPoc
        else
            sideOk := tradeLvnsAbovePoc or tradeLvnsBelowPoc

    distanceOk and sideOk

f_session_close_timestamp() =>
    int closeYear = year(time_close, sessionTimezone)
    int closeMonth = month(time_close, sessionTimezone)
    int closeDay = dayofmonth(time_close, sessionTimezone)
    int closeHour = hour(time_close, sessionTimezone)
    closeHour >= 18 ? timestamp(sessionTimezone, closeYear, closeMonth, closeDay + 1, 16, 0) : timestamp(sessionTimezone, closeYear, closeMonth, closeDay, 16, 0)

f_average_volume(array<float> src, int startIndex, int endIndex) =>
    float avgValue = na
    if startIndex >= 0 and endIndex < array.size(src) and startIndex <= endIndex
        float totalValue = 0.0
        int count = 0
        for i = startIndex to endIndex
            totalValue += array.get(src, i)
            count += 1
        avgValue := count > 0 ? totalValue / count : na
    avgValue

f_sum_volume(array<float> src, int startIndex, int endIndex) =>
    float totalValue = na
    if startIndex >= 0 and endIndex < array.size(src) and startIndex <= endIndex
        totalValue := 0.0
        for i = startIndex to endIndex
            totalValue += array.get(src, i)
    totalValue

f_push_candidate_region(
    array<int> outStartRows,
    array<int> outEndRows,
    array<float> outLows,
    array<float> outHighs,
    array<float> outCenters,
    array<float> outAvgVolumes,
    array<float> outTotalVolumes,
    array<float> outSurroundAvgs,
    array<float> outAvgAbove,
    array<float> outAvgBelow,
    array<float> outDepthRatios,
    array<float> outContrastRatios,
    array<int> outWidths,
    int startRow,
    int endRow,
    float regionLow,
    float regionHigh,
    float regionCenter,
    float regionAvgVolume,
    float regionTotalVolume,
    float surroundingAvg,
    float averageAbove,
    float averageBelow,
    float depthRatio,
    float contrastRatio,
    int regionWidth
) =>
    array.push(outStartRows, startRow)
    array.push(outEndRows, endRow)
    array.push(outLows, regionLow)
    array.push(outHighs, regionHigh)
    array.push(outCenters, regionCenter)
    array.push(outAvgVolumes, regionAvgVolume)
    array.push(outTotalVolumes, regionTotalVolume)
    array.push(outSurroundAvgs, surroundingAvg)
    array.push(outAvgAbove, averageAbove)
    array.push(outAvgBelow, averageBelow)
    array.push(outDepthRatios, depthRatio)
    array.push(outContrastRatios, contrastRatio)
    array.push(outWidths, regionWidth)

f_build_profile_chart_bars(array<float> srcHighs, array<float> srcLows, array<float> srcVolumes, float sessionHigh, float sessionLow, int rows, array<float> outVolumes, array<float> outRowLows, array<float> outRowHighs) =>
    array.clear(outVolumes)
    array.clear(outRowLows)
    array.clear(outRowHighs)

    bool validProfile = array.size(srcHighs) > 0 and not na(sessionHigh) and not na(sessionLow) and sessionHigh > sessionLow and rows > 0
    float rowHeight = na
    float totalVolume = 0.0
    int pocIndex = -1
    float pocVolume = na

    if validProfile
        rowHeight := (sessionHigh - sessionLow) / rows
        validProfile := rowHeight > 0

    if validProfile
        for row = 0 to rows - 1
            float rowLow = sessionLow + row * rowHeight
            float rowHigh = row == rows - 1 ? sessionHigh : rowLow + rowHeight
            array.push(outRowLows, rowLow)
            array.push(outRowHighs, rowHigh)
            array.push(outVolumes, 0.0)

        for barIndex = 0 to array.size(srcHighs) - 1
            float candleHigh = array.get(srcHighs, barIndex)
            float candleLow = array.get(srcLows, barIndex)
            float candleVolume = math.max(array.get(srcVolumes, barIndex), 0.0)
            float candleRange = candleHigh - candleLow
            totalVolume += candleVolume

            if candleVolume > 0
                if candleRange <= 0
                    float clampedPrice = math.max(sessionLow, math.min(candleLow, sessionHigh))
                    int rowIndex = int(math.floor((clampedPrice - sessionLow) / rowHeight))
                    rowIndex := math.max(0, math.min(rows - 1, rowIndex))
                    array.set(outVolumes, rowIndex, array.get(outVolumes, rowIndex) + candleVolume)
                else
                    for row = 0 to rows - 1
                        float binLow = array.get(outRowLows, row)
                        float binHigh = array.get(outRowHighs, row)
                        float overlap = math.max(0.0, math.min(candleHigh, binHigh) - math.max(candleLow, binLow))
                        if overlap > 0
                            float allocatedVolume = candleVolume * overlap / candleRange
                            array.set(outVolumes, row, array.get(outVolumes, row) + allocatedVolume)

        float runningPocVolume = -1.0
        for row = 0 to array.size(outVolumes) - 1
            float rowVolume = array.get(outVolumes, row)
            if rowVolume > runningPocVolume
                runningPocVolume := rowVolume
                pocIndex := row

        pocVolume := pocIndex >= 0 ? array.get(outVolumes, pocIndex) : na

    [validProfile, rowHeight, totalVolume, pocIndex, pocVolume]

f_build_profile(array<float> srcHighs, array<float> srcLows, array<float> srcVolumes, float sessionHigh, float sessionLow, int rows, array<float> outVolumes, array<float> outRowLows, array<float> outRowHighs) =>
    // This dispatcher is kept separate so a future lower-timeframe implementation can replace or
    // augment the chart-bar approximation without changing strategy execution logic.
    f_build_profile_chart_bars(srcHighs, srcLows, srcVolumes, sessionHigh, sessionLow, rows, outVolumes, outRowLows, outRowHighs)

f_detect_client_threshold_candidates(
    array<float> sourceVolumes,
    array<float> sourceRowLows,
    array<float> sourceRowHighs,
    array<int> outStartRows,
    array<int> outEndRows,
    array<float> outLows,
    array<float> outHighs,
    array<float> outCenters,
    array<float> outAvgVolumes,
    array<float> outTotalVolumes,
    array<float> outSurroundAvgs,
    array<float> outAvgAbove,
    array<float> outAvgBelow,
    array<float> outDepthRatios,
    array<float> outContrastRatios,
    array<int> outWidths
) =>
    int rowCount = array.size(sourceVolumes)
    float threshold = lvnThresholdPct / 100.0

    if rowCount >= surroundingRows * 2 + 1
        array<bool> seedRows = array.new_bool(rowCount, false)

        for row = surroundingRows to rowCount - surroundingRows - 1
            float currentVol = array.get(sourceVolumes, row)
            float avgBelow = f_average_volume(sourceVolumes, row - surroundingRows, row - 1)
            float avgAbove = f_average_volume(sourceVolumes, row + 1, row + surroundingRows)
            float surroundingAvg = not na(avgBelow) and not na(avgAbove) ? (avgBelow + avgAbove) * 0.5 : na
            bool bounded = not na(surroundingAvg) and avgBelow > currentVol and avgAbove > currentVol
            bool qualifies = bounded and currentVol <= surroundingAvg * threshold
            array.set(seedRows, row, qualifies)

        int row = surroundingRows
        while row <= rowCount - surroundingRows - 1
            if array.get(seedRows, row)
                int startRow = row
                int endRow = row
                while endRow + 1 <= rowCount - surroundingRows - 1 and array.get(seedRows, endRow + 1)
                    endRow += 1

                if startRow - surroundingRows >= 0 and endRow + surroundingRows < rowCount
                    float avgBelow = f_average_volume(sourceVolumes, startRow - surroundingRows, startRow - 1)
                    float avgAbove = f_average_volume(sourceVolumes, endRow + 1, endRow + surroundingRows)
                    float regionTotalVolume = f_sum_volume(sourceVolumes, startRow, endRow)
                    int regionWidth = endRow - startRow + 1
                    float regionAvgVolume = not na(regionTotalVolume) and regionWidth > 0 ? regionTotalVolume / regionWidth : na
                    float surroundingAvg = not na(avgBelow) and not na(avgAbove) ? (avgBelow + avgAbove) * 0.5 : na
                    bool bounded = not na(regionAvgVolume) and not na(surroundingAvg) and avgBelow > regionAvgVolume and avgAbove > regionAvgVolume
                    float depthRatio = not na(surroundingAvg) and surroundingAvg > 0 ? regionAvgVolume / surroundingAvg : na
                    float contrastRatio = not na(regionAvgVolume) and regionAvgVolume > 0 ? surroundingAvg / regionAvgVolume : na
                    bool contrastPass = not useContrastFilter or (not na(contrastRatio) and contrastRatio >= minContrastRatio)
                    bool qualifies = bounded and contrastPass and not na(regionAvgVolume) and not na(surroundingAvg) and regionAvgVolume <= surroundingAvg * threshold

                    if qualifies and regionWidth > 0
                        float regionLow = array.get(sourceRowLows, startRow)
                        float regionHigh = array.get(sourceRowHighs, endRow)
                        float regionCenter = (regionLow + regionHigh) * 0.5
                        if not na(depthRatio) and not na(contrastRatio)
                            f_push_candidate_region(outStartRows, outEndRows, outLows, outHighs, outCenters, outAvgVolumes, outTotalVolumes, outSurroundAvgs, outAvgAbove, outAvgBelow, outDepthRatios, outContrastRatios, outWidths, startRow, endRow, regionLow, regionHigh, regionCenter, regionAvgVolume, regionTotalVolume, surroundingAvg, avgAbove, avgBelow, depthRatio, contrastRatio, regionWidth)

                row := endRow + 1
            else
                row += 1

f_detect_legacy_candidates(
    array<float> sourceVolumes,
    array<float> sourceRowLows,
    array<float> sourceRowHighs,
    int pocIndex,
    float pocVol,
    array<int> outStartRows,
    array<int> outEndRows,
    array<float> outLows,
    array<float> outHighs,
    array<float> outCenters,
    array<float> outAvgVolumes,
    array<float> outTotalVolumes,
    array<float> outSurroundAvgs,
    array<float> outAvgAbove,
    array<float> outAvgBelow,
    array<float> outDepthRatios,
    array<float> outContrastRatios,
    array<int> outWidths
) =>
    int rowCount = array.size(sourceVolumes)

    if rowCount >= neighborWindow * 2 + 1 and pocIndex >= 0 and not na(pocVol) and pocVol > 0
        for row = neighborWindow to rowCount - neighborWindow - 1
            float currentVol = array.get(sourceVolumes, row)
            bool localMin = true
            float neighborTotal = 0.0
            int neighborCount = 0

            for offset = 1 to neighborWindow
                float leftVol = array.get(sourceVolumes, row - offset)
                float rightVol = array.get(sourceVolumes, row + offset)
                localMin := localMin and currentVol < leftVol and currentVol < rightVol
                neighborTotal += leftVol + rightVol
                neighborCount += 2

            float surroundingAvg = neighborCount > 0 ? neighborTotal / neighborCount : na
            bool depthPass = not na(surroundingAvg) and currentVol <= surroundingAvg * relativeDepthThreshold
            bool pocPass = currentVol <= pocVol * pocVolumeThreshold

            bool methodPass = switch lvnMethod
                "Relative to POC" => localMin and pocPass
                "Neighbor Threshold" => localMin and depthPass
                => localMin

            if methodPass and not na(surroundingAvg) and surroundingAvg > 0
                float rowLow = array.get(sourceRowLows, row)
                float rowHigh = array.get(sourceRowHighs, row)
                float rowCenter = (rowLow + rowHigh) * 0.5
                float depthRatio = currentVol / surroundingAvg
                float contrastRatio = currentVol > 0 ? surroundingAvg / currentVol : na
                bool contrastPass = not useContrastFilter or (not na(contrastRatio) and contrastRatio >= minContrastRatio)
                if contrastPass and not na(contrastRatio)
                    float avgBelow = f_average_volume(sourceVolumes, row - neighborWindow, row - 1)
                    float avgAbove = f_average_volume(sourceVolumes, row + 1, row + neighborWindow)
                    f_push_candidate_region(outStartRows, outEndRows, outLows, outHighs, outCenters, outAvgVolumes, outTotalVolumes, outSurroundAvgs, outAvgAbove, outAvgBelow, outDepthRatios, outContrastRatios, outWidths, row, row, rowLow, rowHigh, rowCenter, currentVol, currentVol, surroundingAvg, avgAbove, avgBelow, depthRatio, contrastRatio, 1)

f_is_region_separated(int candidateStartRow, int candidateEndRow) =>
    bool separated = true
    if array.size(tradableStartRows) > 0
        for i = 0 to array.size(tradableStartRows) - 1
            int selectedStart = array.get(tradableStartRows, i)
            int selectedEnd = array.get(tradableEndRows, i)
            bool rowGapOk = candidateEndRow < selectedStart - minSeparationRows or candidateStartRow > selectedEnd + minSeparationRows
            separated := separated and rowGapOk
    separated

f_prepare_tradable_lvns(array<float> sourceVolumes, array<float> sourceRowLows, array<float> sourceRowHighs, int pocIndex, float pocVol) =>
    f_clear_tradable_lvns()

    array<int> candidateStartRows = array.new_int()
    array<int> candidateEndRows = array.new_int()
    array<float> candidateLows = array.new_float()
    array<float> candidateHighs = array.new_float()
    array<float> candidateCenters = array.new_float()
    array<float> candidateAvgVolumes = array.new_float()
    array<float> candidateTotalVolumes = array.new_float()
    array<float> candidateSurroundAvgs = array.new_float()
    array<float> candidateAvgAbove = array.new_float()
    array<float> candidateAvgBelow = array.new_float()
    array<float> candidateDepthRatios = array.new_float()
    array<float> candidateContrastRatios = array.new_float()
    array<int> candidateWidths = array.new_int()

    if lvnMethod == "Client Threshold Valley"
        f_detect_client_threshold_candidates(sourceVolumes, sourceRowLows, sourceRowHighs, candidateStartRows, candidateEndRows, candidateLows, candidateHighs, candidateCenters, candidateAvgVolumes, candidateTotalVolumes, candidateSurroundAvgs, candidateAvgAbove, candidateAvgBelow, candidateDepthRatios, candidateContrastRatios, candidateWidths)
    else
        f_detect_legacy_candidates(sourceVolumes, sourceRowLows, sourceRowHighs, pocIndex, pocVol, candidateStartRows, candidateEndRows, candidateLows, candidateHighs, candidateCenters, candidateAvgVolumes, candidateTotalVolumes, candidateSurroundAvgs, candidateAvgAbove, candidateAvgBelow, candidateDepthRatios, candidateContrastRatios, candidateWidths)

    int candidateCount = array.size(candidateCenters)
    array<bool> selectedFlags = array.new_bool(candidateCount, false)

    if candidateCount > 0
        for rankSlot = 0 to math.min(maxLvns, candidateCount) - 1
            int bestIndex = -1

            for candidateIndex = 0 to candidateCount - 1
                if not array.get(selectedFlags, candidateIndex)
                    int candidateStartRow = array.get(candidateStartRows, candidateIndex)
                    int candidateEndRow = array.get(candidateEndRows, candidateIndex)
                    bool separated = f_is_region_separated(candidateStartRow, candidateEndRow)

                    if separated
                        float candidateRatio = array.get(candidateDepthRatios, candidateIndex)
                        float candidateContrast = array.get(candidateContrastRatios, candidateIndex)
                        int candidateWidth = array.get(candidateWidths, candidateIndex)
                        float candidateCenter = array.get(candidateCenters, candidateIndex)

                        if bestIndex == -1
                            bestIndex := candidateIndex
                        else
                            float bestRatio = array.get(candidateDepthRatios, bestIndex)
                            float bestContrast = array.get(candidateContrastRatios, bestIndex)
                            int bestWidth = array.get(candidateWidths, bestIndex)
                            float bestCenter = array.get(candidateCenters, bestIndex)

                            bool better = candidateRatio < bestRatio
                            better := better or (candidateRatio == bestRatio and candidateContrast > bestContrast)
                            better := better or (candidateRatio == bestRatio and candidateContrast == bestContrast and candidateWidth > bestWidth)
                            better := better or (candidateRatio == bestRatio and candidateContrast == bestContrast and candidateWidth == bestWidth and candidateCenter < bestCenter)

                            if better
                                bestIndex := candidateIndex

            if bestIndex != -1
                array.set(selectedFlags, bestIndex, true)
                array.push(tradableStartRows, array.get(candidateStartRows, bestIndex))
                array.push(tradableEndRows, array.get(candidateEndRows, bestIndex))
                array.push(tradableLows, array.get(candidateLows, bestIndex))
                array.push(tradableHighs, array.get(candidateHighs, bestIndex))
                array.push(tradableCenters, array.get(candidateCenters, bestIndex))
                array.push(tradableRegionAvgVolumes, array.get(candidateAvgVolumes, bestIndex))
                array.push(tradableRegionTotalVolumes, array.get(candidateTotalVolumes, bestIndex))
                array.push(tradableSurroundingAvgs, array.get(candidateSurroundAvgs, bestIndex))
                array.push(tradableAverageAboveVolumes, array.get(candidateAvgAbove, bestIndex))
                array.push(tradableAverageBelowVolumes, array.get(candidateAvgBelow, bestIndex))
                array.push(tradableDepthRatios, array.get(candidateDepthRatios, bestIndex))
                array.push(tradableContrastRatios, array.get(candidateContrastRatios, bestIndex))
                array.push(tradableRegionWidths, array.get(candidateWidths, bestIndex))

    array.size(tradableCenters)

f_get_trade_levels(int direction, float entryPrice, float lvnLow, float lvnHigh) =>
    float stopPrice = na
    float targetPrice = na

    if riskMode == "Fixed Points"
        if direction == 1
            stopPrice := entryPrice - fixedSLPoints
            targetPrice := entryPrice + fixedTPPoints
        else
            stopPrice := entryPrice + fixedSLPoints
            targetPrice := entryPrice - fixedTPPoints
    else
        if direction == 1
            stopPrice := lvnLow - lvnBoundaryBuffer
            float risk = entryPrice - stopPrice
            if risk > syminfo.mintick
                targetPrice := entryPrice + risk * rrMultiple
        else
            stopPrice := lvnHigh + lvnBoundaryBuffer
            float risk = stopPrice - entryPrice
            if risk > syminfo.mintick
                targetPrice := entryPrice - risk * rrMultiple

    [stopPrice, targetPrice]

f_trade_levels_valid(int direction, float entryPrice, float stopPrice, float targetPrice) =>
    float riskDistance = not na(stopPrice) ? math.abs(entryPrice - stopPrice) : na
    direction == 1 ? (not na(stopPrice) and not na(targetPrice) and not na(riskDistance) and riskDistance > syminfo.mintick and stopPrice < entryPrice and targetPrice > entryPrice) : (not na(stopPrice) and not na(targetPrice) and not na(riskDistance) and riskDistance > syminfo.mintick and stopPrice > entryPrice and targetPrice < entryPrice)

int sessionStamp = time(timeframe.period, profileSession, sessionTimezone)
int entrySessionStamp = time(timeframe.period, entrySessionFilter, sessionTimezone)
bool timeframeOk = timeframe.isintraday
bool withinDateRange = time >= startDate and time <= endDate
bool inProfileSession = not na(sessionStamp)
bool inEntrySession = not useEntrySessionFilter or not na(entrySessionStamp)
int sessionCloseTimestamp = f_session_close_timestamp()
int minutesToSessionEnd = inProfileSession ? int(math.floor((sessionCloseTimestamp - time_close) / 60000)) : na
bool entryCutoffActive = blockNewEntriesBeforeSessionEnd and inProfileSession and not na(minutesToSessionEnd) and minutesToSessionEnd <= entryCutoffMinutes
bool priorInSession = bar_index > 0 ? not na(sessionStamp[1]) : false
bool isNewProfileSession = inProfileSession and not priorInSession
bool isSessionJustEnded = not inProfileSession and priorInSession

if isNewProfileSession
    f_cancel_all_entry_orders()
    anyTradeTakenThisSession := false
    f_reset_usage_flags(lvnUsedThisSession, array.size(tradableCenters))
    if strategy.position_size == 0
        activeTradeLvnIndex := -1
    buildSessionActive := true
    skipCurrentBuild := false
    buildSessionHigh := na
    buildSessionLow := na
    buildSessionVolume := 0.0
    buildSessionHasPositiveVolume := false
    buildSessionStartTime := na
    buildSessionEndTime := na
    f_clear_build_profile_buffers()
    f_reset_bool_flags(pendingLongOrders, array.size(tradableCenters))
    f_reset_bool_flags(pendingShortOrders, array.size(tradableCenters))
    frozenProfileAnchorBarIndex := tradableProfileReady and array.size(profileVolumes) > 0 ? bar_index : na
    if not na(frozenProfileAnchorBarIndex)
        frozenRenderedRowCount := f_draw_frozen_profile_histogram(frozenProfileAnchorBarIndex)
    else
        f_clear_box_array(profileBoxes)
        frozenRenderedRowCount := 0
else if inProfileSession and not buildSessionActive
    f_cancel_all_entry_orders()
    anyTradeTakenThisSession := false
    f_reset_usage_flags(lvnUsedThisSession, array.size(tradableCenters))
    buildSessionActive := true
    skipCurrentBuild := true
    buildSessionHigh := na
    buildSessionLow := na
    buildSessionVolume := 0.0
    buildSessionHasPositiveVolume := false
    buildSessionStartTime := na
    buildSessionEndTime := na
    f_clear_build_profile_buffers()
    f_reset_bool_flags(pendingLongOrders, array.size(tradableCenters))
    f_reset_bool_flags(pendingShortOrders, array.size(tradableCenters))
    frozenProfileAnchorBarIndex := na
    f_clear_box_array(profileBoxes)
    dataWarning := "Initial history started mid-session. The first detected profile is skipped to avoid freezing a partial session."

if inProfileSession and buildSessionActive
    float safeVolume = na(volume) ? 0.0 : volume
    array.push(sessionBarHighs, high)
    array.push(sessionBarLows, low)
    array.push(sessionBarVolumes, safeVolume)
    buildSessionStartTime := na(buildSessionStartTime) ? time : buildSessionStartTime
    buildSessionEndTime := time_close
    buildSessionHigh := na(buildSessionHigh) ? high : math.max(buildSessionHigh, high)
    buildSessionLow := na(buildSessionLow) ? low : math.min(buildSessionLow, low)
    buildSessionVolume += safeVolume
    buildSessionHasPositiveVolume := buildSessionHasPositiveVolume or safeVolume > 0

if isSessionJustEnded
    f_cancel_all_entry_orders()

    if closePositionsAtSessionEnd and strategy.position_size != 0
        strategy.close_all(comment = "Session End")

    if buildSessionActive and not skipCurrentBuild and buildSessionHasPositiveVolume
        [validProfile, rowHeight, totalVolume, pocIndex, pocVol] = f_build_profile(sessionBarHighs, sessionBarLows, sessionBarVolumes, buildSessionHigh, buildSessionLow, profileRows, profileVolumes, profileRowLows, profileRowHighs)

        if validProfile and totalVolume > 0 and pocIndex >= 0
            frozenSessionHigh := buildSessionHigh
            frozenSessionLow := buildSessionLow
            frozenRowHeight := rowHeight
            frozenProfileRange := buildSessionHigh - buildSessionLow
            previousPocVolume := pocVol
            previousPocRow := pocIndex
            previousPocPrice := (array.get(profileRowLows, pocIndex) + array.get(profileRowHighs, pocIndex)) * 0.5
            frozenSourceSessionVolume := totalVolume
            frozenSessionStartTime := buildSessionStartTime
            frozenSessionEndTime := buildSessionEndTime
            frozenMaxRowVolume := pocVol
            frozenProfileVolumeSum := array.size(profileVolumes) > 0 ? f_sum_volume(profileVolumes, 0, array.size(profileVolumes) - 1) : na
            frozenVolumeConservationErrorPct := not na(frozenSourceSessionVolume) and frozenSourceSessionVolume > 0 and not na(frozenProfileVolumeSum) ? math.abs(frozenProfileVolumeSum - frozenSourceSessionVolume) / frozenSourceSessionVolume * 100.0 : na

            int preparedCount = f_prepare_tradable_lvns(profileVolumes, profileRowLows, profileRowHighs, pocIndex, pocVol)
            tradableProfileReady := preparedCount > 0
            f_reset_usage_flags(lvnUsedThisSession, preparedCount)
            f_reset_bool_flags(pendingLongOrders, preparedCount)
            f_reset_bool_flags(pendingShortOrders, preparedCount)
            frozenProfileAnchorBarIndex := na
            dataWarning := preparedCount > 0 ? "" : "Profile completed, but no LVNs passed the current detection settings."
        else
            f_clear_frozen_profile_buffers()
            f_reset_usage_flags(lvnUsedThisSession, 0)
            f_reset_bool_flags(pendingLongOrders, 0)
            f_reset_bool_flags(pendingShortOrders, 0)
            tradableProfileReady := false
            frozenSessionHigh := na
            frozenSessionLow := na
            frozenRowHeight := na
            frozenProfileRange := na
            previousPocPrice := na
            previousPocRow := na
            previousPocVolume := na
            frozenSourceSessionVolume := na
            frozenProfileVolumeSum := na
            frozenVolumeConservationErrorPct := na
            frozenMaxRowVolume := na
            frozenRenderedRowCount := 0
            frozenSessionStartTime := na
            frozenSessionEndTime := na
            frozenProfileAnchorBarIndex := na
            dataWarning := "Skipped profile because the session range or allocated volume was invalid."
    else
        f_clear_frozen_profile_buffers()
        f_reset_usage_flags(lvnUsedThisSession, 0)
        f_reset_bool_flags(pendingLongOrders, 0)
        f_reset_bool_flags(pendingShortOrders, 0)
        tradableProfileReady := false
        frozenSessionHigh := na
        frozenSessionLow := na
        frozenRowHeight := na
        frozenProfileRange := na
        previousPocPrice := na
        previousPocRow := na
        previousPocVolume := na
        frozenSourceSessionVolume := na
        frozenProfileVolumeSum := na
        frozenVolumeConservationErrorPct := na
        frozenMaxRowVolume := na
        frozenRenderedRowCount := 0
        frozenSessionStartTime := na
        frozenSessionEndTime := na
        frozenProfileAnchorBarIndex := na
        dataWarning := skipCurrentBuild ? "Skipped an incomplete profile because the chart history started inside the session." : "Skipped profile because no usable volume was available."

    buildSessionActive := false
    skipCurrentBuild := false

bool newLongPosition = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0
bool newPositionOpened = (newLongPosition or newShortPosition) and strategy.opentrades > 0
bool positionClosed = strategy.position_size == 0 and strategy.position_size[1] != 0

if newPositionOpened
    activeEntryId := strategy.opentrades.entry_id(strategy.opentrades - 1)
    activeTradeDirection := strategy.position_size > 0 ? 1 : -1
    activeTradeLvnIndex := -1

    if array.size(tradableCenters) > 0
        for i = 0 to array.size(tradableCenters) - 1
            int rank = i + 1
            if activeEntryId == f_long_entry_id(rank) or activeEntryId == f_short_entry_id(rank)
                activeTradeLvnIndex := i
                if lvnFreshnessMode != "Allow Repeated Trades" and i < array.size(lvnUsedThisSession)
                    array.set(lvnUsedThisSession, i, true)
                anyTradeTakenThisSession := true
                break

    f_cancel_all_entry_orders()
    f_reset_bool_flags(pendingLongOrders, 0)
    f_reset_bool_flags(pendingShortOrders, 0)

if positionClosed
    if activeEntryId != ""
        strategy.cancel(f_exit_id(activeEntryId))
    activeTradeLvnIndex := -1
    activeTradeDirection := 0
    activeEntryId := ""
    activeStopPrice := na
    activeTargetPrice := na

bool canSubmitNewEntries = timeframeOk and withinDateRange and inProfileSession and inEntrySession and not entryCutoffActive and tradableProfileReady and strategy.position_size == 0
float referencePrice = bar_index > 0 ? close[1] : close

if canSubmitNewEntries and array.size(tradableCenters) > 0
    array<bool> nextPendingLongOrders = array.new_bool()
    array<bool> nextPendingShortOrders = array.new_bool()

    for i = 0 to array.size(tradableCenters) - 1
        int rank = i + 1
        float levelCenter = array.get(tradableCenters, i)
        float levelLow = array.get(tradableLows, i)
        float levelHigh = array.get(tradableHighs, i)
        float depthRatio = array.get(tradableDepthRatios, i)
        float contrastRatio = array.get(tradableContrastRatios, i)

        bool rankEnabled = f_is_rank_enabled(rank)
        bool alreadyUsed = i < array.size(lvnUsedThisSession) ? array.get(lvnUsedThisSession, i) : false
        bool hadPendingLongOrder = i < array.size(pendingLongOrders) ? array.get(pendingLongOrders, i) : false
        bool hadPendingShortOrder = i < array.size(pendingShortOrders) ? array.get(pendingShortOrders, i) : false
        bool tradeAllowedForRank = lvnFreshnessMode == "Allow Repeated Trades" or not alreadyUsed

        float longEntryPrice = f_lvn_entry_price(1, levelLow, levelHigh)
        float shortEntryPrice = f_lvn_entry_price(-1, levelLow, levelHigh)
        bool approachFromAbove = referencePrice > levelHigh + minimumApproachDistance
        bool approachFromBelow = referencePrice < levelLow - minimumApproachDistance
        bool pocContextOk = f_poc_context_ok(levelCenter)
        bool longTouchedWithActiveOrder = hadPendingLongOrder and f_zone_touched(1, longEntryPrice)
        bool shortTouchedWithActiveOrder = hadPendingShortOrder and f_zone_touched(-1, shortEntryPrice)
        bool consumedThisBar = false

        [projectedLongStop, projectedLongTarget] = f_get_trade_levels(1, longEntryPrice, levelLow, levelHigh)
        [projectedShortStop, projectedShortTarget] = f_get_trade_levels(-1, shortEntryPrice, levelLow, levelHigh)
        bool longRiskOk = tradeLongs and f_trade_levels_valid(1, longEntryPrice, projectedLongStop, projectedLongTarget)
        bool shortRiskOk = tradeShorts and f_trade_levels_valid(-1, shortEntryPrice, projectedShortStop, projectedShortTarget)
        string depthComment = str.tostring(depthRatio * 100.0, "#")
        string contrastComment = str.tostring(contrastRatio, "#.#")

        if rankEnabled and tradeAllowedForRank and pocContextOk and approachFromAbove and longRiskOk
            strategy.entry(f_long_entry_id(rank), strategy.long, qty = orderQty, limit = longEntryPrice, oca_name = ENTRY_OCA_GROUP, oca_type = strategy.oca.cancel, comment = "LVN" + str.tostring(rank) + "-L D" + depthComment + " C" + contrastComment)
            strategy.cancel(f_short_entry_id(rank))
            bool keepLongPending = true
            if lvnFreshnessMode == "First Touch Only" and longTouchedWithActiveOrder and i < array.size(lvnUsedThisSession)
                array.set(lvnUsedThisSession, i, true)
                consumedThisBar := true
                keepLongPending := false
            array.push(nextPendingLongOrders, keepLongPending and not consumedThisBar)
            array.push(nextPendingShortOrders, false)
        else if rankEnabled and tradeAllowedForRank and pocContextOk and approachFromBelow and shortRiskOk
            strategy.entry(f_short_entry_id(rank), strategy.short, qty = orderQty, limit = shortEntryPrice, oca_name = ENTRY_OCA_GROUP, oca_type = strategy.oca.cancel, comment = "LVN" + str.tostring(rank) + "-S D" + depthComment + " C" + contrastComment)
            strategy.cancel(f_long_entry_id(rank))
            bool keepShortPending = true
            if lvnFreshnessMode == "First Touch Only" and shortTouchedWithActiveOrder and i < array.size(lvnUsedThisSession)
                array.set(lvnUsedThisSession, i, true)
                consumedThisBar := true
                keepShortPending := false
            array.push(nextPendingLongOrders, false)
            array.push(nextPendingShortOrders, keepShortPending and not consumedThisBar)
        else
            f_cancel_rank_orders(rank)
            array.push(nextPendingLongOrders, false)
            array.push(nextPendingShortOrders, false)

    array.clear(pendingLongOrders)
    array.clear(pendingShortOrders)
    for i = 0 to array.size(nextPendingLongOrders) - 1
        array.push(pendingLongOrders, array.get(nextPendingLongOrders, i))
        array.push(pendingShortOrders, array.get(nextPendingShortOrders, i))
else
    f_cancel_all_entry_orders()
    f_reset_bool_flags(pendingLongOrders, 0)
    f_reset_bool_flags(pendingShortOrders, 0)

if strategy.position_size != 0 and activeTradeLvnIndex >= 0 and activeTradeLvnIndex < array.size(tradableCenters)
    float activeLvnLow = array.get(tradableLows, activeTradeLvnIndex)
    float activeLvnHigh = array.get(tradableHighs, activeTradeLvnIndex)
    [nextActiveStop, nextActiveTarget] = f_get_trade_levels(activeTradeDirection, strategy.position_avg_price, activeLvnLow, activeLvnHigh)
    activeStopPrice := nextActiveStop
    activeTargetPrice := nextActiveTarget

    if f_trade_levels_valid(activeTradeDirection, strategy.position_avg_price, activeStopPrice, activeTargetPrice)
        strategy.exit(f_exit_id(activeEntryId), from_entry = activeEntryId, stop = activeStopPrice, limit = activeTargetPrice, comment_profit = "TP", comment_loss = "SL")
    else
        strategy.close(activeEntryId, comment = "Invalid Risk")
else
    activeStopPrice := na
    activeTargetPrice := na

float lvnCenter1 = array.size(tradableCenters) > 0 ? array.get(tradableCenters, 0) : na
float lvnCenter2 = array.size(tradableCenters) > 1 ? array.get(tradableCenters, 1) : na
float lvnCenter3 = array.size(tradableCenters) > 2 ? array.get(tradableCenters, 2) : na
float lvnCenter4 = array.size(tradableCenters) > 3 ? array.get(tradableCenters, 3) : na
float lvnCenter5 = array.size(tradableCenters) > 4 ? array.get(tradableCenters, 4) : na
float lvnCenter6 = array.size(tradableCenters) > 5 ? array.get(tradableCenters, 5) : na
float lvnCenter7 = array.size(tradableCenters) > 6 ? array.get(tradableCenters, 6) : na
float lvnCenter8 = array.size(tradableCenters) > 7 ? array.get(tradableCenters, 7) : na
float lvnCenter9 = array.size(tradableCenters) > 8 ? array.get(tradableCenters, 8) : na
float lvnCenter10 = array.size(tradableCenters) > 9 ? array.get(tradableCenters, 9) : na

float lvnLow1 = array.size(tradableLows) > 0 ? array.get(tradableLows, 0) : na
float lvnLow2 = array.size(tradableLows) > 1 ? array.get(tradableLows, 1) : na
float lvnLow3 = array.size(tradableLows) > 2 ? array.get(tradableLows, 2) : na
float lvnLow4 = array.size(tradableLows) > 3 ? array.get(tradableLows, 3) : na
float lvnLow5 = array.size(tradableLows) > 4 ? array.get(tradableLows, 4) : na
float lvnLow6 = array.size(tradableLows) > 5 ? array.get(tradableLows, 5) : na
float lvnLow7 = array.size(tradableLows) > 6 ? array.get(tradableLows, 6) : na
float lvnLow8 = array.size(tradableLows) > 7 ? array.get(tradableLows, 7) : na
float lvnLow9 = array.size(tradableLows) > 8 ? array.get(tradableLows, 8) : na
float lvnLow10 = array.size(tradableLows) > 9 ? array.get(tradableLows, 9) : na

float lvnHigh1 = array.size(tradableHighs) > 0 ? array.get(tradableHighs, 0) : na
float lvnHigh2 = array.size(tradableHighs) > 1 ? array.get(tradableHighs, 1) : na
float lvnHigh3 = array.size(tradableHighs) > 2 ? array.get(tradableHighs, 2) : na
float lvnHigh4 = array.size(tradableHighs) > 3 ? array.get(tradableHighs, 3) : na
float lvnHigh5 = array.size(tradableHighs) > 4 ? array.get(tradableHighs, 4) : na
float lvnHigh6 = array.size(tradableHighs) > 5 ? array.get(tradableHighs, 5) : na
float lvnHigh7 = array.size(tradableHighs) > 6 ? array.get(tradableHighs, 6) : na
float lvnHigh8 = array.size(tradableHighs) > 7 ? array.get(tradableHighs, 7) : na
float lvnHigh9 = array.size(tradableHighs) > 8 ? array.get(tradableHighs, 8) : na
float lvnHigh10 = array.size(tradableHighs) > 9 ? array.get(tradableHighs, 9) : na

bool showLvnsForDisplay = showLvns or nativeFrvpComparisonMode
bool showPocForDisplay = showPoc or nativeFrvpComparisonMode
bool showProfileBoundsForDisplay = showDebug or nativeFrvpComparisonMode
bool showTradeLevelsForDisplay = showTradeLevels and not nativeFrvpComparisonMode
bool showSessionMarkersForDisplay = showSessionMarkers or nativeFrvpComparisonMode
bool showEntryMarkersForDisplay = not nativeFrvpComparisonMode

lvnUpperPlot1 = plot(showLvnsForDisplay ? lvnHigh1 : na, "LVN Rank #1 Upper", color = color.new(color.teal, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot1 = plot(showLvnsForDisplay ? lvnLow1 : na, "LVN Rank #1 Lower", color = color.new(color.teal, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter1 : na, "LVN Rank #1 Center", color = color.new(color.teal, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot2 = plot(showLvnsForDisplay ? lvnHigh2 : na, "LVN Rank #2 Upper", color = color.new(color.green, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot2 = plot(showLvnsForDisplay ? lvnLow2 : na, "LVN Rank #2 Lower", color = color.new(color.green, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter2 : na, "LVN Rank #2 Center", color = color.new(color.green, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot3 = plot(showLvnsForDisplay ? lvnHigh3 : na, "LVN Rank #3 Upper", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot3 = plot(showLvnsForDisplay ? lvnLow3 : na, "LVN Rank #3 Lower", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_linebr)
