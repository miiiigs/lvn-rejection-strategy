lvnUpperPlot6 = plot(showLvnsForDisplay ? lvnHigh6 : na, "LVN Rank #6 Upper", color = color.new(color.fuchsia, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot6 = plot(showLvnsForDisplay ? lvnLow6 : na, "LVN Rank #6 Lower", color = color.new(color.fuchsia, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter6 : na, "LVN Rank #6 Center", color = color.new(color.fuchsia, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot7 = plot(showLvnsForDisplay ? lvnHigh7 : na, "LVN Rank #7 Upper", color = color.new(color.purple, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot7 = plot(showLvnsForDisplay ? lvnLow7 : na, "LVN Rank #7 Lower", color = color.new(color.purple, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter7 : na, "LVN Rank #7 Center", color = color.new(color.purple, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot8 = plot(showLvnsForDisplay ? lvnHigh8 : na, "LVN Rank #8 Upper", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot8 = plot(showLvnsForDisplay ? lvnLow8 : na, "LVN Rank #8 Lower", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter8 : na, "LVN Rank #8 Center", color = color.new(color.yellow, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot9 = plot(showLvnsForDisplay ? lvnHigh9 : na, "LVN Rank #9 Upper", color = color.new(color.navy, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot9 = plot(showLvnsForDisplay ? lvnLow9 : na, "LVN Rank #9 Lower", color = color.new(color.navy, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter9 : na, "LVN Rank #9 Center", color = color.new(color.navy, 55), linewidth = 1, style = plot.style_linebr)

lvnUpperPlot10 = plot(showLvnsForDisplay ? lvnHigh10 : na, "LVN Rank #10 Upper", color = color.new(color.silver, 0), linewidth = 2, style = plot.style_linebr)
lvnLowerPlot10 = plot(showLvnsForDisplay ? lvnLow10 : na, "LVN Rank #10 Lower", color = color.new(color.silver, 0), linewidth = 2, style = plot.style_linebr)
plot(showLvnsForDisplay ? lvnCenter10 : na, "LVN Rank #10 Center", color = color.new(color.silver, 55), linewidth = 1, style = plot.style_linebr)

fill(lvnUpperPlot1, lvnLowerPlot1, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.teal, 88) : na, title = "LVN Rank #1 Zone")
fill(lvnUpperPlot2, lvnLowerPlot2, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.green, 88) : na, title = "LVN Rank #2 Zone")
fill(lvnUpperPlot3, lvnLowerPlot3, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.blue, 88) : na, title = "LVN Rank #3 Zone")
fill(lvnUpperPlot4, lvnLowerPlot4, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.orange, 88) : na, title = "LVN Rank #4 Zone")
fill(lvnUpperPlot5, lvnLowerPlot5, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.red, 88) : na, title = "LVN Rank #5 Zone")
fill(lvnUpperPlot6, lvnLowerPlot6, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.fuchsia, 88) : na, title = "LVN Rank #6 Zone")
fill(lvnUpperPlot7, lvnLowerPlot7, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.purple, 88) : na, title = "LVN Rank #7 Zone")
fill(lvnUpperPlot8, lvnLowerPlot8, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.yellow, 88) : na, title = "LVN Rank #8 Zone")
fill(lvnUpperPlot9, lvnLowerPlot9, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.navy, 88) : na, title = "LVN Rank #9 Zone")
fill(lvnUpperPlot10, lvnLowerPlot10, color = showLvnsForDisplay and shadeLvnZones ? color.new(color.silver, 88) : na, title = "LVN Rank #10 Zone")
plot(showPocForDisplay ? previousPocPrice : na, "Prior Session POC", color = color.new(color.yellow, 0), linewidth = 2, style = plot.style_linebr)

plot(showProfileBoundsForDisplay ? frozenSessionHigh : na, "Frozen Session High", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(showProfileBoundsForDisplay ? frozenSessionLow : na, "Frozen Session Low", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(showTradeLevelsForDisplay ? activeStopPrice : na, "Active Stop", color = color.new(color.red, 0), linewidth = 1, style = plot.style_linebr)
plot(showTradeLevelsForDisplay ? activeTargetPrice : na, "Active Target", color = color.new(color.lime, 0), linewidth = 1, style = plot.style_linebr)

bgcolor(showSessionMarkersForDisplay and inProfileSession ? color.new(color.aqua, 94) : na, title = "Session Background")
plotshape(showSessionMarkersForDisplay and isNewProfileSession, title = "Session Start", style = shape.circle, size = size.tiny, color = color.new(color.aqua, 0), location = location.bottom, text = "18")
plotshape(showSessionMarkersForDisplay and isSessionJustEnded, title = "Session End", style = shape.circle, size = size.tiny, color = color.new(color.orange, 0), location = location.top, text = "16")
plotshape(showEntryMarkersForDisplay and newLongPosition, title = "Long Entry Marker", style = shape.triangleup, location = location.belowbar, size = size.tiny, color = color.new(color.lime, 0), text = "L")
plotshape(showEntryMarkersForDisplay and newShortPosition, title = "Short Entry Marker", style = shape.triangledown, location = location.abovebar, size = size.tiny, color = color.new(color.red, 0), text = "S")

if barstate.islast
    f_clear_label_array(lvnLabels)
    f_update_row_diagnostics_table()

    if showLvnLabels and showLvnsForDisplay and array.size(tradableCenters) > 0
        int labelsToDraw = math.min(array.size(tradableCenters), MAX_SUPPORTED_RANKS)
        for i = 0 to labelsToDraw - 1
            int rank = i + 1
            float level = array.get(tradableCenters, i)
            float lowerBoundary = array.get(tradableLows, i)
            float upperBoundary = array.get(tradableHighs, i)
            float avgAbove = array.get(tradableAverageAboveVolumes, i)
            float avgBelow = array.get(tradableAverageBelowVolumes, i)
            float depthRatio = array.get(tradableDepthRatios, i)
            float contrastRatio = array.get(tradableContrastRatios, i)
            float surroundingAvg = array.get(tradableSurroundingAvgs, i)
            float avgVolume = array.get(tradableRegionAvgVolumes, i)
            string strengthClass = f_lvn_strength_class(depthRatio)
            string labelText = "LVN Rank #" + str.tostring(rank) + "  " + str.tostring(level, format.mintick)
            labelText += "\nZone: " + str.tostring(lowerBoundary, format.mintick) + " - " + str.tostring(upperBoundary, format.mintick)
            labelText += "\nDepth: " + str.tostring(depthRatio * 100.0, "#.##") + "%"
            labelText += "\nContrast: " + str.tostring(contrastRatio, "#.##") + "x"
            labelText += "\nClass: " + strengthClass
            labelText += "\nLVN Avg: " + str.tostring(avgVolume, "#.##")
            labelText += "\nSurround Avg: " + str.tostring(surroundingAvg, "#.##")
            labelText += "\nAbove/Below: " + str.tostring(avgAbove, "#.##") + " / " + str.tostring(avgBelow, "#.##")
            label labelId = label.new(bar_index, level, text = labelText, style = label.style_label_left, color = color.new(color.black, 20), textcolor = color.white, size = size.tiny)
            array.push(lvnLabels, labelId)

    if not na(statusLabel)
        label.delete(statusLabel)
        statusLabel := na

    if not na(debugLabel)
        label.delete(debugLabel)
        debugLabel := na

    string warningText = ""
    if not timeframeOk
        warningText := "Use this strategy on intraday charts. Higher timeframes cannot rebuild a session profile reliably."
    else if profileCalculationMode != "Chart Bar Approximation"
        warningText := "Unsupported profile calculation setting."
    else if str.length(dataWarning) > 0
        warningText := dataWarning
    else if not na(frozenVolumeConservationErrorPct) and frozenVolumeConservationErrorPct > 0.05
        warningText := "Profile volume conservation drift exceeded 0.05% on the last frozen session."

    if str.length(warningText) > 0
        statusLabel := label.new(bar_index, high, warningText, style = label.style_label_upper_left, color = color.new(color.red, 0), textcolor = color.white, size = size.small)

    if showDebug
        float profileVolumeDelta = not na(frozenProfileVolumeSum) and not na(frozenSourceSessionVolume) ? frozenProfileVolumeSum - frozenSourceSessionVolume : na
        string conservationStatus = "na"
        if not na(frozenVolumeConservationErrorPct)
            conservationStatus := frozenVolumeConservationErrorPct <= 0.05 ? "PASS" : "CHECK"
        string debugText = "Test: " + testLabel
        debugText += "\nConfig: " + f_configuration_fingerprint()
        debugText += "\nSymbol: " + syminfo.tickerid
        debugText += "\nTimeframe: " + timeframe.period
        debugText += "\nSession: " + profileSession + " " + sessionTimezone
        debugText += "\nComparison Mode: " + (nativeFrvpComparisonMode ? "On" : "Off")
        debugText += "\nRows: " + str.tostring(profileRows)
        debugText += "\nEnabled Ranks: " + f_enabled_ranks_summary()
        debugText += "\nLongs / Shorts: " + (tradeLongs ? "On" : "Off") + " / " + (tradeShorts ? "On" : "Off")
        debugText += "\nHistogram: " + ((showVolumeProfileHistogram or nativeFrvpComparisonMode) ? "On " + str.tostring(profileVisualWidth) + " bars" : "Off")
        debugText += "\nLVN Method: " + lvnMethod
        debugText += "\nThreshold: " + str.tostring(lvnThresholdPct, "#.##") + "%"
        debugText += "\nSurrounding Rows: " + str.tostring(surroundingRows)
        debugText += "\nContrast Filter: " + (useContrastFilter ? "On >= " + str.tostring(minContrastRatio, "#.##") + "x" : "Off")
        debugText += "\nFreshness: " + lvnFreshnessMode
        debugText += "\nApproach Distance: " + str.tostring(minimumApproachDistance, "#.##")
        debugText += "\nEntry Cutoff: " + (blockNewEntriesBeforeSessionEnd ? "On " + str.tostring(entryCutoffMinutes) + "m" : "Off")
        debugText += "\nClose At Session End: " + (closePositionsAtSessionEnd ? "On" : "Off")
        debugText += "\nEntry Session Filter: " + (useEntrySessionFilter ? entrySessionFilter : "Off")
        debugText += "\nPOC Filter: " + ((usePocDistanceFilter or not tradeLvnsAbovePoc or not tradeLvnsBelowPoc) ? "Custom" : "Off")
        debugText += "\nPOC Distance Min: " + str.tostring(minimumPocDistance, "#.##")
        debugText += "\nPOC Above / Below: " + (tradeLvnsAbovePoc ? "On" : "Off") + " / " + (tradeLvnsBelowPoc ? "On" : "Off")
        debugText += "\nRisk Mode: " + riskMode
        debugText += riskMode == "Fixed Points" ? "\nFixed SL / TP: " + str.tostring(fixedSLPoints, "#.##") + " / " + str.tostring(fixedTPPoints, "#.##") : "\nR / Buffer: " + str.tostring(rrMultiple, "#.##") + " / " + str.tostring(lvnBoundaryBuffer, "#.##")
        debugText += "\nOrder Size: " + str.tostring(orderQty, "#.##")
        debugText += "\nSource Session Date: " + f_format_date(frozenSessionStartTime)
        debugText += "\nSource Session Start: " + f_format_timestamp(frozenSessionStartTime)
        debugText += "\nSource Session End: " + f_format_timestamp(frozenSessionEndTime)
        debugText += "\nFrozen High: " + (not na(frozenSessionHigh) ? str.tostring(frozenSessionHigh, format.mintick) : "na")
        debugText += "\nFrozen Low: " + (not na(frozenSessionLow) ? str.tostring(frozenSessionLow, format.mintick) : "na")
        debugText += "\nProfile Range: " + (not na(frozenProfileRange) ? str.tostring(frozenProfileRange, "#.####") : "na")
        debugText += "\nRow Height: " + (not na(frozenRowHeight) ? str.tostring(frozenRowHeight, format.mintick) : "na")
        debugText += "\nMax Row Volume: " + (not na(frozenMaxRowVolume) ? str.tostring(frozenMaxRowVolume, "#.##") : "na")
        debugText += "\nPOC Row: " + (not na(previousPocRow) ? str.tostring(previousPocRow + 1) : "na")
        debugText += "\nPOC Price: " + (not na(previousPocPrice) ? str.tostring(previousPocPrice, format.mintick) : "na")
        debugText += "\nRendered Rows: " + str.tostring(frozenRenderedRowCount)
        debugText += "\nProfile Vol Sum: " + (not na(frozenProfileVolumeSum) ? str.tostring(frozenProfileVolumeSum, "#.##") : "na")
        debugText += "\nSource Session Vol: " + (not na(frozenSourceSessionVolume) ? str.tostring(frozenSourceSessionVolume, "#.##") : "na")
        debugText += "\nVolume Delta: " + (not na(profileVolumeDelta) ? str.tostring(profileVolumeDelta, "#.##") : "na")
        debugText += "\nConservation Error: " + (not na(frozenVolumeConservationErrorPct) ? str.tostring(frozenVolumeConservationErrorPct, "#.####") + "%" : "na")
        debugText += "\nConservation Status: " + conservationStatus
        debugText += "\nMinutes To Session End: " + (not na(minutesToSessionEnd) ? str.tostring(minutesToSessionEnd) : "na")
        debugText += "\nDetected LVNs: " + str.tostring(array.size(tradableCenters))
        if array.size(tradableCenters) > 0
            debugText += "\nTop Depth: " + str.tostring(array.get(tradableDepthRatios, 0) * 100.0, "#.##") + "%"
            debugText += "\nTop Contrast: " + str.tostring(array.get(tradableContrastRatios, 0), "#.##") + "x"
            debugText += "\nTop Class: " + f_lvn_strength_class(array.get(tradableDepthRatios, 0))
            debugText += "\nTop Zone: " + str.tostring(array.get(tradableLows, 0), format.mintick) + " - " + str.tostring(array.get(tradableHighs, 0), format.mintick)
        if strategy.position_size != 0
            float activeRiskPoints = not na(activeStopPrice) ? math.abs(strategy.position_avg_price - activeStopPrice) : na
            float activeRewardPoints = not na(activeTargetPrice) ? math.abs(activeTargetPrice - strategy.position_avg_price) : na
            float actualRMultiple = not na(activeRiskPoints) and activeRiskPoints > syminfo.mintick and not na(activeRewardPoints) ? activeRewardPoints / activeRiskPoints : na
            debugText += "\nActive Entry: " + str.tostring(strategy.position_avg_price, format.mintick)
            debugText += "\nActive Stop: " + (not na(activeStopPrice) ? str.tostring(activeStopPrice, format.mintick) : "na")
            debugText += "\nActive Target: " + (not na(activeTargetPrice) ? str.tostring(activeTargetPrice, format.mintick) : "na")
            debugText += "\nRisk / Reward Pts: " + (not na(activeRiskPoints) ? str.tostring(activeRiskPoints, "#.##") : "na") + " / " + (not na(activeRewardPoints) ? str.tostring(activeRewardPoints, "#.##") : "na")
            debugText += "\nActual R: " + (not na(actualRMultiple) ? str.tostring(actualRMultiple, "#.##") : "na")
            if activeTradeLvnIndex >= 0 and activeTradeLvnIndex < array.size(tradableCenters)
                debugText += "\nActive LVN Zone: " + str.tostring(array.get(tradableLows, activeTradeLvnIndex), format.mintick) + " - " + str.tostring(array.get(tradableHighs, activeTradeLvnIndex), format.mintick)
                if riskMode == "Fixed Points"
                    bool fixedRiskMatch = not na(activeRiskPoints) and not na(activeRewardPoints) and math.abs(activeRiskPoints - fixedSLPoints) <= syminfo.mintick and math.abs(activeRewardPoints - fixedTPPoints) <= syminfo.mintick
                    debugText += "\nFixed Risk Match: " + (fixedRiskMatch ? "Yes" : "No")
        debugLabel := label.new(bar_index, low, text = debugText, style = label.style_label_lower_left, color = color.new(color.navy, 15), textcolor = color.white, size = size.small)
